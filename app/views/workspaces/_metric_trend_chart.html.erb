<div
  data-controller="dashboard-metric-chart"
  data-testid="dashboard-metric-chart"
  data-dashboard-metric-chart-values-value="<%= comparison[:values].to_json %>"
  data-dashboard-metric-chart-baseline-average-value="<%= comparison[:baseline_average] %>"
  data-dashboard-metric-chart-scale-min-value="<%= comparison[:scale_min] %>"
  data-dashboard-metric-chart-scale-max-value="<%= comparison[:scale_max] %>"
  data-dashboard-metric-chart-direction-value="<%= comparison[:direction] %>"
  class="pointer-events-none absolute inset-x-2 bottom-7 top-7 z-0 min-w-0"
  aria-hidden="true">
  <canvas
    data-testid="dashboard-metric-chart-canvas"
    data-dashboard-metric-chart-target="canvas"
    class="h-full w-full"
    aria-hidden="true"
    tabindex="-1"></canvas>
</div>
