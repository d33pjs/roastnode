<main class="rn-page">
  <%= render "brews/hero_card_styles" %>

  <section data-testid="dashboard-shell" class="rn-shell max-w-6xl py-6 sm:px-6 lg:py-10">
    <% dashboard_metrics = @dashboard_metrics %>
    <% last_coffee_at = dashboard_metrics[:last_coffee_at] %>

    <header data-testid="dashboard-workspace-header" class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div>
        <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
        <div data-testid="dashboard-workspace-heading" class="mt-2 flex min-w-0 items-center gap-4">
          <% if current_workspace.logo.attached? %>
            <%= image_tag media_attachment_path(current_workspace.logo.attachment, variant: :thumbnail),
              alt: "",
              data: { testid: "dashboard-workspace-logo" },
              class: "h-16 w-16 shrink-0 rounded-2xl border border-rn-line object-contain sm:h-20 sm:w-20" %>
          <% end %>
          <h1 class="min-w-0 text-4xl font-black leading-tight text-rn-ink sm:text-5xl"><%= current_workspace.name %></h1>
        </div>
      </div>

      <aside
        data-testid="dashboard-last-coffee-timer"
        class="min-w-0 rounded-xl border border-rn-line bg-rn-surface/85 px-4 py-3 shadow-sm lg:max-w-xs lg:justify-self-end lg:text-right"
        <% if last_coffee_at.present? %>
          data-controller="dashboard-timer"
          data-dashboard-timer-since-at-value="<%= last_coffee_at.to_i %>"
        <% end %>>
        <p class="text-[0.65rem] font-black uppercase tracking-[0.08em] text-rn-muted"><%= t(".timer.title") %></p>
        <p class="mt-1 min-w-0 break-words text-2xl font-black leading-none text-rn-ink sm:text-3xl">
          <span data-dashboard-timer-target="value"><%= dashboard_duration_text(last_coffee_at) %></span>
        </p>
        <% if last_coffee_at.present? %>
          <p class="mt-1 text-xs font-extrabold text-rn-muted"><%= t(".timer.since_last_coffee") %></p>
        <% end %>
      </aside>
    </header>

    <% if Current.user.workspaces.many? %>
      <section class="mt-8 rounded-2xl border border-rn-line bg-rn-surface p-4">
        <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".switcher") %></h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <% Current.user.workspaces.order(:name).each do |workspace| %>
            <%= button_to workspace.name, switch_workspace_path(workspace), method: :patch, class: "rounded-full border border-rn-line px-4 py-2 text-sm font-bold text-rn-ink hover:bg-[var(--rn-surface-muted)]" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @latest_coffee.present? || @latest_best_brew.present? %>
      <section class="mt-8 grid min-w-0 gap-6 lg:grid-cols-2">
        <% if @latest_coffee.present? %>
          <div data-testid="dashboard-latest-coffee-card" class="min-w-0">
            <div data-testid="dashboard-latest-coffee-heading" class="mb-3 flex min-w-0 items-center justify-between gap-4">
              <h2 class="text-xl font-black text-rn-ink"><%= t(".hero.latest") %></h2>
              <%= link_to t(".view_all"), coffees_path, class: "text-sm font-bold text-rn-ink hover:underline" %>
            </div>
            <%= link_to polymorphic_path(@latest_coffee), class: "block min-w-0" do %>
              <% if @latest_coffee.is_a?(Brew) %>
                <%= render "brews/hero_card", brew: @latest_coffee, compact: true, chart_id: "latest-brew-shot-fill-#{@latest_coffee.id}" %>
              <% else %>
                <%= render "external_coffees/hero_card", external_coffee: @latest_coffee, compact: true %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <% if @latest_best_brew.present? %>
          <div data-testid="dashboard-latest-best-brew-card" class="min-w-0">
            <h2 class="mb-3 text-xl font-black text-rn-ink"><%= t(".hero.best") %></h2>
            <%= link_to brew_path(@latest_best_brew), class: "block min-w-0" do %>
              <%= render "brews/hero_card", brew: @latest_best_brew, compact: true, chart_id: "best-brew-shot-fill-#{@latest_best_brew.id}" %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <% dashboard_metric_cards = [
      {
        testid: "coffees-today",
        label: t(".status.coffees_today"),
        value: dashboard_metrics[:counts][:coffees_today],
        comparison: dashboard_metrics[:comparisons][:coffees_today]
      },
      {
        testid: "brews-today",
        label: t(".status.brews_today"),
        value: dashboard_metrics[:counts][:brews_today],
        comparison: dashboard_metrics[:comparisons][:brews_today]
      },
      {
        testid: "coffees-this-week",
        label: t(".status.coffees_this_week"),
        value: dashboard_metrics[:counts][:coffees_this_week],
        comparison: dashboard_metrics[:comparisons][:coffees_this_week]
      },
      {
        testid: "brews-this-week",
        label: t(".status.brews_this_week"),
        value: dashboard_metrics[:counts][:brews_this_week],
        comparison: dashboard_metrics[:comparisons][:brews_this_week]
      },
      {
        testid: "open-beans",
        label: t(".status.open_beans"),
        value: dashboard_metrics[:inventory][:open_bean_count],
        comparison: nil
      },
      {
        testid: "stock-bags",
        label: t(".status.stock_bags"),
        value: dashboard_metrics[:inventory][:stock_bag_count],
        comparison: nil
      },
      {
        testid: "open-grams",
        label: t(".status.open_grams_remaining"),
        value: profile_grams(dashboard_metrics[:inventory][:open_grams]),
        comparison: nil
      },
      {
        testid: "stock-grams",
        label: t(".status.stock_grams"),
        value: profile_grams(dashboard_metrics[:inventory][:stock_grams]),
        comparison: nil
      },
      {
        testid: "closed-bags-today",
        label: t(".status.closed_bags_today"),
        value: dashboard_metrics[:inventory][:closed_bags_today],
        comparison: nil
      },
      {
        testid: "closed-bags-this-week",
        label: t(".status.closed_bags_this_week"),
        value: dashboard_metrics[:inventory][:closed_bags_this_week],
        comparison: nil
      },
      {
        testid: "spent-today",
        label: t(".status.spent_today"),
        value: dashboard_money(dashboard_metrics[:spend][:today_cents]),
        comparison: dashboard_metrics[:comparisons][:spent_today]
      },
      {
        testid: "spent-this-week",
        label: t(".status.spent_this_week"),
        value: dashboard_money(dashboard_metrics[:spend][:week_cents]),
        comparison: dashboard_metrics[:comparisons][:spent_this_week]
      }
    ] %>

    <section data-testid="dashboard-metrics-grid" class="mt-8 grid items-start gap-3 md:grid-cols-2 xl:grid-cols-4">
      <% dashboard_metric_cards.each do |card| %>
        <% comparison = card[:comparison] %>
        <% trend = {
          "up" => { text_class: "text-emerald-700", stroke: "#047857" },
          "down" => { text_class: "text-red-700", stroke: "#b91c1c" },
          "same" => { text_class: "text-rn-muted", stroke: "#78716c" },
          "new" => { text_class: "text-emerald-700", stroke: "#047857" }
        }[comparison&.dig(:direction)] || { text_class: "text-rn-muted", stroke: "#78716c" } %>

        <article data-testid="dashboard-metric-<%= card[:testid] %>" class="flex min-h-36 min-w-0 flex-col justify-between rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
          <div class="min-w-0">
            <p class="text-xs font-black uppercase tracking-[0.08em] text-rn-ink"><%= card[:label] %></p>
            <p class="mt-3 min-w-0 break-words text-3xl font-black leading-tight text-rn-ink"><%= card[:value] %></p>

            <% if comparison.present? %>
              <p class="mt-2 text-xs font-black <%= trend[:text_class] %>"><%= comparison[:label] %></p>
            <% end %>
          </div>

          <% if comparison.present? %>
            <%= render "workspaces/metric_trend_chart", comparison:, trend: %>
          <% end %>
        </article>
      <% end %>
    </section>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <section data-testid="dashboard-open-beans" class="min-w-0">
        <div class="mb-4 flex min-w-0 items-center justify-between gap-4">
          <h2 class="text-xl font-black text-rn-ink"><%= t(".open_beans") %></h2>
          <%= link_to t(".view_all"), beans_path, class: "text-sm font-bold text-rn-muted hover:text-rn-ink" %>
        </div>

        <div data-testid="dashboard-open-bean-cockpit" class="grid gap-3">
          <% if @open_bean_cockpit_entries.any? %>
            <% @open_bean_cockpit_entries.each do |entry| %>
              <% bean = entry.bean %>
              <% remaining_bar_class = {
                "plenty" => "bg-emerald-600",
                "medium" => "bg-amber-500",
                "low" => "bg-red-600"
              }.fetch(entry.remaining_state) %>

              <article data-testid="dashboard-open-bean-card-<%= bean.id %>" class="min-w-0 rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm">
                <div class="flex min-w-0 items-start gap-3">
                  <%= render "shared/record_photo_thumb",
                    record: bean,
                    testid: "dashboard-open-bean-photo",
                    class_name: "h-16 w-16 shrink-0 rounded-2xl object-contain ring-1 ring-stone-200" %>
                  <div class="min-w-0 flex-1">
                    <div class="flex min-w-0 items-start justify-between gap-3">
                      <div class="min-w-0">
                        <%= link_to bean.name, bean_path(bean), class: "block truncate font-extrabold text-rn-ink hover:underline" %>
                        <p class="mt-1 truncate text-sm text-rn-muted"><%= bean.roaster_name.presence || t(".unknown_roaster") %></p>
                      </div>
                      <span class="shrink-0 rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1 text-xs font-extrabold text-rn-muted"><%= t(".cockpit.brew_count", count: entry.brew_count) %></span>
                    </div>

                    <div class="mt-3">
                      <div class="flex min-w-0 items-end justify-between gap-3 text-xs font-extrabold text-rn-muted">
                        <span><%= t(".cockpit.remaining") %></span>
                        <span data-testid="dashboard-open-bean-remaining-<%= bean.id %>" class="min-w-0 truncate text-right text-rn-ink"><%= t("beans.index.remaining_of", remaining: profile_grams(bean.remaining_grams), total: profile_grams(bean.bag_size_grams)) %></span>
                      </div>
                      <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-[var(--rn-surface-muted)]">
                        <div data-testid="dashboard-open-bean-progress-<%= bean.id %>" data-remaining-state="<%= entry.remaining_state %>" class="h-full rounded-full <%= remaining_bar_class %>" style="width: <%= bean.remaining_percent %>%"></div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="mt-3 flex min-w-0 flex-wrap gap-1.5 text-xs font-bold text-rn-muted">
                  <% if entry.days_open.present? %>
                    <span data-testid="dashboard-open-bean-open-age-<%= bean.id %>" class="rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1 text-rn-ink"><%= t(".cockpit.open_age", count: entry.days_open) %></span>
                  <% end %>
                  <% if entry.days_since_roast.present? %>
                    <span data-testid="dashboard-open-bean-roast-age-<%= bean.id %>" class="rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1 text-rn-ink"><%= t(".cockpit.roast_age", count: entry.days_since_roast) %></span>
                  <% else %>
                    <span data-testid="dashboard-open-bean-roast-age-<%= bean.id %>" class="rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1"><%= t(".cockpit.roast_unknown") %></span>
                  <% end %>
                </div>

                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  <div class="min-w-0 rounded-lg border border-rn-line bg-[var(--rn-surface-muted)] p-3">
                    <% if entry.latest_brew.present? %>
                      <%= link_to brew_path(entry.latest_brew), class: "flex min-w-0 items-center justify-between gap-3 text-sm font-extrabold text-rn-ink hover:underline" do %>
                        <span><%= t(".cockpit.last_brew") %></span>
                        <span class="min-w-0 truncate text-right text-xs text-rn-muted"><%= l(entry.latest_brew.occurred_at.to_date) %></span>
                      <% end %>
                      <% setup_parts = open_bean_cockpit_setup_parts(entry.latest_brew) %>
                      <p data-testid="dashboard-open-bean-last-setup-<%= bean.id %>" class="mt-1 min-w-0 break-words text-sm font-semibold leading-5 text-rn-muted"><%= setup_parts.presence&.join(" · ") || t(".cockpit.no_setup") %></p>
                    <% else %>
                      <p class="text-sm font-extrabold text-rn-ink"><%= t(".cockpit.no_brews") %></p>
                    <% end %>
                  </div>

                  <div data-testid="dashboard-open-bean-best-<%= bean.id %>" class="min-w-0 rounded-lg border border-rn-line bg-[var(--rn-surface-muted)] p-3">
                    <% if entry.best_brew.present? %>
                      <%= link_to brew_path(entry.best_brew), class: "flex min-w-0 items-center justify-between gap-3 text-sm font-extrabold text-rn-ink hover:underline" do %>
                        <span><%= t(".cockpit.best_brew") %></span>
                        <span class="shrink-0 text-xs text-rn-muted"><%= t(".cockpit.rating", rating: entry.best_brew.rating) %></span>
                      <% end %>
                      <p class="mt-1 min-w-0 break-words text-sm font-semibold leading-5 text-rn-muted"><%= open_bean_cockpit_setup_parts(entry.best_brew).presence&.join(" · ") || t(".cockpit.no_setup") %></p>
                      <% if current_workspace_policy.write? %>
                        <%= link_to t(".cockpit.repeat"), new_brew_path(repeat_brew_id: entry.best_brew.id), class: "mt-2 inline-flex rounded-full border border-rn-line bg-rn-surface px-3 py-1.5 text-xs font-extrabold text-rn-ink hover:bg-[var(--rn-canvas)]" %>
                      <% end %>
                    <% else %>
                      <p class="text-sm font-extrabold text-rn-ink"><%= t(".cockpit.no_best_brew") %></p>
                    <% end %>
                  </div>
                </div>
              </article>
            <% end %>
          <% else %>
            <p class="rounded-2xl border border-rn-line bg-rn-surface p-4 text-sm text-rn-muted"><%= t(".no_open_beans") %></p>
          <% end %>
        </div>
      </section>

      <section data-testid="dashboard-recent-activity" class="min-w-0">
        <div data-testid="dashboard-recent-activity-heading" class="mb-4 flex min-w-0 items-center justify-between gap-4">
          <h2 class="text-xl font-black text-rn-ink"><%= t(".recent_activity") %></h2>
          <%= link_to t(".view_all"), activity_path, class: "text-sm font-bold text-rn-ink hover:underline" %>
        </div>
        <div class="overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
          <% if @recent_activity.any? %>
            <% @recent_activity.each do |activity| %>
              <% if activity.is_a?(Brew) %>
                <%= link_to brew_path(activity), class: "block min-w-0 border-b border-rn-line p-4 last:border-b-0 hover:bg-[var(--rn-surface-muted)]" do %>
                  <p class="min-w-0 break-words font-extrabold text-rn-ink"><%= t(".activity.brew", bean: activity.bean.name) %></p>
                  <p class="mt-1 min-w-0 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                <% end %>
              <% elsif activity.is_a?(ExternalCoffee) %>
                <%= link_to external_coffee_path(activity), class: "block min-w-0 border-b border-rn-line p-4 last:border-b-0 hover:bg-[var(--rn-surface-muted)]" do %>
                  <p class="min-w-0 break-words font-extrabold text-rn-ink"><%= t(".activity.external_coffee", drink: activity.drink_type) %></p>
                  <p class="mt-1 min-w-0 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                <% end %>
              <% elsif activity.is_a?(EquipmentEvent) %>
                <%= link_to equipment_event_path(activity), class: "block min-w-0 border-b border-rn-line p-4 last:border-b-0 hover:bg-[var(--rn-surface-muted)]" do %>
                  <p class="min-w-0 break-words font-extrabold text-rn-ink"><%= t(".activity.equipment_event", event: activity.event_type_summary, equipment: activity.equipment.map(&:name).to_sentence) %></p>
                  <p class="mt-1 min-w-0 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                <% end %>
              <% else %>
                <div class="min-w-0 border-b border-rn-line p-4 last:border-b-0">
                  <p class="min-w-0 break-words font-extrabold text-rn-ink"><%= t(".activity.adjustment", bean: activity.bean.name, amount: profile_number(activity.delta_grams, precision: 1)) %></p>
                  <p class="mt-1 min-w-0 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="p-4 text-sm text-rn-muted"><%= t(".no_activity") %></p>
          <% end %>
        </div>
      </section>
    </div>
  </section>
</main>
