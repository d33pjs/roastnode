<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-6xl px-6 py-10">
    <header class="flex flex-col gap-4 border-b border-stone-200 pb-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".eyebrow") %></p>
        <h1 class="mt-2 text-4xl font-bold text-stone-950"><%= current_workspace.name %></h1>
        <p class="mt-3 text-stone-700"><%= t(".signed_in_as", email: Current.user.email_address) %></p>
        <p class="mt-1 text-sm text-stone-600"><%= t(".role", role: current_membership.role.humanize) %></p>
      </div>

      <%= button_to t(".sign_out"), session_path, method: :delete, class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
    </header>

    <div class="grid gap-4 py-8 sm:grid-cols-3">
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-stone-950"><%= t(".cards.brews.title") %></h2>
        <p class="mt-2 text-sm leading-6 text-stone-600"><%= t(".cards.brews.body") %></p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-stone-950"><%= t(".cards.beans.title") %></h2>
        <p class="mt-2 text-sm leading-6 text-stone-600"><%= t(".cards.beans.body") %></p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-stone-950"><%= t(".cards.equipment.title") %></h2>
        <p class="mt-2 text-sm leading-6 text-stone-600"><%= t(".cards.equipment.body") %></p>
      </section>
    </div>
  </section>
</main>

