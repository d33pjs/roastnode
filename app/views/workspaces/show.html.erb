<main class="rn-page">
  <%= render "brews/hero_card_styles" %>

  <section data-testid="dashboard-shell" class="rn-shell max-w-6xl py-6 sm:px-6 lg:py-10">
    <header class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-start">
      <div>
        <%= link_to root_path, class: "mb-6 inline-block" do %>
          <%= render "shared/brand_wordmark",
            container_class: "block h-12 w-72 max-w-full sm:h-14 sm:w-80",
            image_class: "h-full w-full object-contain object-left" %>
        <% end %>

        <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
        <h1 class="mt-2 text-4xl font-black leading-tight text-rn-ink sm:text-5xl"><%= current_workspace.name %></h1>
        <p class="mt-3 text-sm font-semibold text-rn-muted"><%= t(".signed_in_as", user: Current.user.display_label) %></p>
        <p class="mt-1 text-sm text-rn-muted"><%= t(".role", role: current_membership.role.humanize) %></p>
      </div>

    </header>

    <% if Current.user.workspaces.many? %>
      <section class="mt-8 rounded-2xl border border-rn-line bg-rn-surface p-4">
        <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".switcher") %></h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <% Current.user.workspaces.order(:name).each do |workspace| %>
            <%= button_to workspace.name, switch_workspace_path(workspace), method: :patch, class: "rounded-full border border-rn-line px-4 py-2 text-sm font-bold text-rn-ink hover:bg-[var(--rn-surface-muted)]" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @latest_brew.present? || @latest_best_brew.present? %>
      <section class="mt-8 grid gap-6 lg:grid-cols-2">
        <% if @latest_brew.present? %>
          <div data-testid="dashboard-latest-brew-card">
            <h2 class="mb-3 text-xl font-black text-rn-ink"><%= t(".hero.latest") %></h2>
            <%= link_to brew_path(@latest_brew), class: "block" do %>
              <%= render "brews/hero_card", brew: @latest_brew, compact: true, chart_id: "latest-brew-shot-fill-#{@latest_brew.id}" %>
            <% end %>
          </div>
        <% end %>

        <% if @latest_best_brew.present? %>
          <div data-testid="dashboard-latest-best-brew-card">
            <h2 class="mb-3 text-xl font-black text-rn-ink"><%= t(".hero.best") %></h2>
            <%= link_to brew_path(@latest_best_brew), class: "block" do %>
              <%= render "brews/hero_card", brew: @latest_best_brew, compact: true, chart_id: "best-brew-shot-fill-#{@latest_best_brew.id}" %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section class="mt-8 grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-rn-line bg-rn-surface p-5 shadow-sm">
        <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".status.brews_this_week") %></p>
        <p class="mt-2 text-3xl font-black text-rn-ink"><%= @brews_this_week %></p>
      </div>
      <div class="rounded-2xl border border-rn-line bg-rn-surface p-5 shadow-sm">
        <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".status.open_beans") %></p>
        <p class="mt-2 text-3xl font-black text-rn-ink"><%= @open_bean_count %></p>
      </div>
      <div class="rounded-2xl border border-rn-line bg-rn-surface p-5 shadow-sm">
        <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".status.grams_remaining") %></p>
        <p class="mt-2 text-3xl font-black text-rn-ink"><%= profile_grams(@grams_remaining) %></p>
      </div>
    </section>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <section data-testid="dashboard-open-beans">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-xl font-black text-rn-ink"><%= t(".open_beans") %></h2>
          <%= link_to t(".view_all"), beans_path, class: "text-sm font-bold text-rn-muted hover:text-rn-ink" %>
        </div>

        <div class="overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
          <% if @open_beans.any? %>
            <% @open_beans.each do |bean| %>
              <%= link_to bean_path(bean), class: "block border-b border-rn-line p-4 last:border-b-0 hover:bg-[var(--rn-surface-muted)]" do %>
                <div class="flex items-center justify-between gap-4">
                  <div class="flex min-w-0 items-center gap-3">
                    <%= render "shared/record_photo_thumb",
                      record: bean,
                      testid: "dashboard-open-bean-photo",
                      class_name: "h-14 w-14 shrink-0 rounded-2xl object-cover ring-1 ring-stone-200" %>
                    <div class="min-w-0">
                      <p class="truncate font-extrabold text-rn-ink"><%= bean.name %></p>
                      <p class="mt-1 truncate text-sm text-rn-muted"><%= bean.roaster_name.presence || t(".unknown_roaster") %></p>
                    </div>
                  </div>
                  <p class="shrink-0 text-sm font-extrabold text-rn-ink"><%= profile_grams(bean.remaining_grams) %></p>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="p-4 text-sm text-rn-muted"><%= t(".no_open_beans") %></p>
          <% end %>
        </div>
      </section>

      <section data-testid="dashboard-recent-activity">
        <h2 class="mb-4 text-xl font-black text-rn-ink"><%= t(".recent_activity") %></h2>
        <div class="overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
          <% if @recent_activity.any? %>
            <% @recent_activity.each do |activity| %>
              <% if activity.is_a?(Brew) %>
                <%= link_to brew_path(activity), class: "block border-b border-rn-line p-4 last:border-b-0 hover:bg-[var(--rn-surface-muted)]" do %>
                  <p class="font-extrabold text-rn-ink"><%= t(".activity.brew", bean: activity.bean.name) %></p>
                  <p class="mt-1 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                <% end %>
              <% elsif activity.is_a?(EquipmentEvent) %>
                <%= link_to equipment_event_path(activity), class: "block border-b border-rn-line p-4 last:border-b-0 hover:bg-[var(--rn-surface-muted)]" do %>
                  <p class="font-extrabold text-rn-ink"><%= t(".activity.equipment_event", event: activity.event_type_summary, equipment: activity.equipment.map(&:name).to_sentence) %></p>
                  <p class="mt-1 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                <% end %>
              <% else %>
                <div class="border-b border-rn-line p-4 last:border-b-0">
                  <p class="font-extrabold text-rn-ink"><%= t(".activity.adjustment", bean: activity.bean.name, amount: profile_number(activity.delta_grams, precision: 1)) %></p>
                  <p class="mt-1 text-sm text-rn-muted"><%= profile_timestamp(activity.occurred_at) %></p>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="p-4 text-sm text-rn-muted"><%= t(".no_activity") %></p>
          <% end %>
        </div>
      </section>
    </div>
  </section>
</main>
