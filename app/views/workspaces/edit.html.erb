<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-2xl px-6 py-10">
    <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>

    <div class="mt-6 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <h1 class="text-3xl font-bold text-stone-950"><%= t(".title") %></h1>

      <%= form_with model: @workspace, url: workspace_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
        <% if @workspace.errors.any? %>
          <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            <%= @workspace.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div>
          <%= form.label :name, t(".name"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :name, required: true, autofocus: true, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :default_currency, t(".default_currency"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :default_currency, required: true, maxlength: 3, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 uppercase text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :logo, t(".logo"), class: "block text-sm font-medium text-stone-700" %>
            <% if @workspace.logo.attached? %>
              <%= image_tag media_attachment_path(@workspace.logo.attachment, variant: :thumbnail), alt: "", data: { testid: "workspace-logo-preview" }, class: "mt-2 h-20 w-20 rounded-md object-cover ring-1 ring-stone-200" %>
            <% end %>
            <%= form.file_field :logo, accept: "image/*", class: "mt-2 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
          </div>

          <div>
            <%= form.label :banner, t(".banner"), class: "block text-sm font-medium text-stone-700" %>
            <% if @workspace.banner.attached? %>
              <%= image_tag media_attachment_path(@workspace.banner.attachment, variant: :thumbnail), alt: "", data: { testid: "workspace-banner-preview" }, class: "mt-2 h-20 w-full rounded-md object-cover ring-1 ring-stone-200" %>
            <% end %>
            <%= form.file_field :banner, accept: "image/*", class: "mt-2 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
          </div>
        </div>

        <%= form.submit t(".save"), class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
      <% end %>
    </div>

    <% if current_workspace_policy.owner? %>
      <div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-red-950"><%= t(".danger_title") %></h2>
        <p class="mt-2 text-sm text-red-800"><%= t(".danger_body", name: @workspace.name) %></p>
        <%= form_with url: workspace_path, method: :delete, class: "mt-4 space-y-3" do |form| %>
          <div>
            <%= form.label :confirmation, t(".confirmation_label", name: @workspace.name), class: "block text-sm font-medium text-red-950" %>
            <%= form.text_field :confirmation, required: true, class: "mt-1 w-full rounded-md border border-red-300 px-3 py-2 text-stone-950 shadow-sm focus:border-red-700 focus:outline-none" %>
          </div>
          <%= form.submit t(".delete_workspace"),
            data: { turbo_confirm: t(".delete_confirmation") },
            class: "rounded-md bg-red-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-red-800" %>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
