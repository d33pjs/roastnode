<% locale_scope = "workspaces.public_bean_shares" %>

<section id="public-bean-shares" data-testid="workspace-public-bean-shares" class="mt-6 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-xl font-semibold text-stone-950"><%= t("#{locale_scope}.title") %></h2>
      <p class="mt-1 text-sm text-stone-600"><%= t("#{locale_scope}.body") %></p>
    </div>
  </div>

  <div class="mt-5 grid gap-4">
    <% public_bean_shares.each do |share| %>
      <% recent_views = share.public_bean_share_views.recent.first(5) %>
      <article data-testid="workspace-public-bean-share-<%= share.id %>" class="min-w-0 overflow-hidden rounded-lg border border-stone-200 bg-stone-50 p-4">
        <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
          <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="min-w-0 truncate text-lg font-bold text-stone-950"><%= share.title.presence || t("#{locale_scope}.untitled") %></h3>
                  <span class="shrink-0 rounded-full bg-stone-200 px-2.5 py-1 text-xs font-bold text-stone-700"><%= share.enabled? ? t("#{locale_scope}.enabled") : t("#{locale_scope}.disabled") %></span>
                  <% if share.password_protected? %>
                    <span class="shrink-0 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-900"><%= t("#{locale_scope}.protected") %></span>
                  <% end %>
                </div>
                <p class="mt-1 text-sm font-semibold text-stone-600">
                  <%= link_to t("#{locale_scope}.bean", bean: share.bean.display_name),
                    bean_path(share.bean),
                    class: "underline decoration-stone-300 underline-offset-4 hover:decoration-stone-950" %>
                </p>
              </div>

              <div class="flex min-w-0 flex-wrap gap-2 sm:shrink-0">
                <%= link_to t("#{locale_scope}.open"), public_bean_page_path(share.token), target: "_blank", rel: "noopener", class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
                <%= link_to t("#{locale_scope}.edit"), edit_bean_public_bean_share_path(share.bean), class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
                <%= button_to t("#{locale_scope}.remove"),
                  bean_public_bean_share_path(share.bean),
                  method: :delete,
                  params: { return_to: "public_bean_shares" },
                  form: { data: { turbo_confirm: t("#{locale_scope}.remove_confirmation") } },
                  class: "rounded-md border border-red-200 bg-white px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
              </div>
            </div>

            <p class="mt-3 min-w-0 max-w-full overflow-hidden rounded-md border border-stone-200 bg-white px-3 py-2 text-sm font-bold text-stone-950">
              <%= link_to public_bean_page_url(share.token), public_bean_page_path(share.token), target: "_blank", rel: "noopener", class: "block overflow-hidden text-ellipsis whitespace-nowrap underline decoration-stone-300 underline-offset-4 hover:decoration-stone-950" %>
            </p>

            <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
              <div class="rounded-md bg-white px-3 py-2">
                <dt class="text-xs font-bold uppercase text-stone-500"><%= t("#{locale_scope}.created") %></dt>
                <dd data-testid="public-bean-share-created-at-<%= share.id %>" class="font-bold text-stone-950"><%= profile_timestamp(share.created_at) %></dd>
              </div>
              <div class="rounded-md bg-white px-3 py-2">
                <dt class="text-xs font-bold uppercase text-stone-500"><%= t("#{locale_scope}.updated") %></dt>
                <dd data-testid="public-bean-share-updated-at-<%= share.id %>" class="font-bold text-stone-950"><%= profile_timestamp(share.updated_at) %></dd>
              </div>
              <div class="rounded-md bg-white px-3 py-2">
                <dt class="text-xs font-bold uppercase text-stone-500"><%= t("#{locale_scope}.views") %></dt>
                <dd data-testid="public-bean-share-view-count-<%= share.id %>" class="font-bold text-stone-950"><%= share.views_count %></dd>
              </div>
            </dl>
          </div>

          <div class="min-w-0 rounded-md border border-stone-200 bg-white p-3 xl:w-64">
            <p class="text-xs font-bold uppercase text-stone-500"><%= t("#{locale_scope}.recent_views") %></p>
            <% if recent_views.any? %>
              <ul data-testid="public-bean-share-recent-views-<%= share.id %>" class="mt-2 grid gap-2">
                <% recent_views.each do |view| %>
                  <li data-testid="public-bean-share-recent-view-<%= share.id %>-<%= view.id %>" class="min-w-0 text-sm">
                    <span class="block truncate font-bold text-stone-950"><%= view.ip_address %></span>
                    <span class="block text-xs font-semibold text-stone-500"><%= profile_timestamp(view.viewed_at) %></span>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p data-testid="public-bean-share-recent-views-<%= share.id %>" class="mt-2 text-sm font-semibold text-stone-600"><%= t("#{locale_scope}.no_views") %></p>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>

    <% if public_bean_shares.empty? %>
      <p class="rounded-lg border border-dashed border-stone-300 p-4 text-sm font-semibold text-stone-600"><%= t("#{locale_scope}.empty") %></p>
    <% end %>
  </div>
</section>
