<% compact = local_assigns.fetch(:compact, false) %>
<% photo = external_coffee.primary_photo_attachment %>
<% user_avatar = external_coffee.user.avatar.attachment if external_coffee.user.avatar.attached? %>
<% workspace_logo = current_workspace.logo.attachment if current_workspace.logo.attached? %>

<article data-testid="external-coffee-hero-card" class="relative overflow-hidden rounded-lg bg-stone-950 text-stone-50 shadow-sm <%= compact ? "min-h-[18rem]" : "min-h-[25rem]" %>">
  <% if photo.present? %>
    <%= image_tag media_attachment_path(photo, variant: :thumbnail), alt: "", class: "absolute inset-0 h-full w-full object-cover" %>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/70 to-stone-950/20"></div>
  <% else %>
    <div class="absolute inset-0 bg-[linear-gradient(135deg,#1c1917,#292524_55%,#14532d)]"></div>
  <% end %>

  <div class="relative flex min-h-[inherit] flex-col justify-between p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-xs font-black uppercase tracking-[0.12em] text-stone-300"><%= t("external_coffees.log_tab") %></p>
        <h2 class="mt-2 break-words text-3xl font-black leading-tight text-white sm:text-4xl"><%= external_coffee.drink_type %></h2>
        <% if external_coffee.drink_size.present? %>
          <p class="mt-1 text-sm font-extrabold text-lime-200"><%= external_coffee.drink_size %></p>
        <% end %>
      </div>
      <div class="shrink-0 rounded-2xl border border-white/20 bg-black/35 px-3 py-2 text-right backdrop-blur">
        <p class="text-[0.65rem] font-black uppercase tracking-[0.08em] text-stone-300"><%= t("external_coffees.show.price") %></p>
        <p data-testid="external-coffee-price" class="text-lg font-black text-white"><%= external_coffee_price(external_coffee) %></p>
      </div>
    </div>

    <div class="grid gap-3">
      <div>
        <% if external_coffee.place_name.present? %>
          <p class="break-words text-xl font-black text-white"><%= external_coffee.place_name %></p>
        <% end %>
        <% if external_coffee.place_location.present? %>
          <p class="mt-1 break-words text-sm font-bold text-stone-300"><%= external_coffee.place_location %></p>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <div class="rounded-2xl border border-white/15 bg-black/35 p-3 backdrop-blur">
          <p class="text-[0.65rem] font-black uppercase tracking-[0.08em] text-stone-300"><%= t("external_coffees.show.acidity_balance") %></p>
          <p class="mt-1 text-sm font-black text-white"><%= external_coffee_acidity_label(external_coffee.acidity_balance) %></p>
        </div>
        <div class="rounded-2xl border border-white/15 bg-black/35 p-3 backdrop-blur">
          <p class="text-[0.65rem] font-black uppercase tracking-[0.08em] text-stone-300"><%= t("external_coffees.show.intensity") %></p>
          <p class="mt-1 text-sm font-black text-white"><%= external_coffee_intensity_label(external_coffee.intensity) %></p>
        </div>
        <div class="rounded-2xl border border-white/15 bg-black/35 p-3 backdrop-blur">
          <p class="text-[0.65rem] font-black uppercase tracking-[0.08em] text-stone-300"><%= t("external_coffees.show.rating") %></p>
          <p class="mt-1 text-sm font-black text-lime-200"><%= external_coffee_rating_marks(external_coffee) %></p>
        </div>
        <div class="rounded-2xl border border-white/15 bg-black/35 p-3 backdrop-blur">
          <p class="text-[0.65rem] font-black uppercase tracking-[0.08em] text-stone-300"><%= t("external_coffees.show.logged_at") %></p>
          <p data-testid="external-coffee-logged-at" class="mt-1 whitespace-nowrap text-xs font-black text-white sm:text-sm"><%= external_coffee_card_timestamp(external_coffee) %></p>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/15 pt-3 text-xs font-bold text-stone-300">
        <span data-testid="external-coffee-workspace" class="inline-flex min-w-0 max-w-full items-center gap-1.5">
          <% if workspace_logo.present? %>
            <%= image_tag media_attachment_path(workspace_logo, variant: :thumbnail), alt: "", data: { testid: "external-coffee-workspace-logo" }, class: "h-5 w-5 shrink-0 rounded-full object-contain ring-1 ring-white/20" %>
          <% end %>
          <span class="min-w-0 truncate"><%= current_workspace.name %></span>
        </span>
        <span data-testid="external-coffee-byline" class="inline-flex min-w-0 max-w-full items-center gap-1.5">
          <% if user_avatar.present? %>
            <%= image_tag media_attachment_path(user_avatar, variant: :thumbnail), alt: "", data: { testid: "external-coffee-user-avatar" }, class: "h-5 w-5 shrink-0 rounded-full object-contain ring-1 ring-white/20" %>
          <% end %>
          <span class="min-w-0 truncate"><%= t("external_coffees.show.logged_by", user: external_coffee.user.display_label) %></span>
        </span>
      </div>
    </div>
  </div>
</article>
