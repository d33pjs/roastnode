<main class="rn-page">
  <section class="rn-shell max-w-4xl py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link", label: t(".back"), path: external_coffee_path(@external_coffee) %>
    <h1 class="mt-4 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title") %></h1>

    <%= render "form",
      external_coffee: @external_coffee,
      submit_label: t(".update"),
      drink_type_suggestions: @drink_type_suggestions,
      place_name_suggestions: @place_name_suggestions %>

    <%= render "shared/photo_grid",
      record: @external_coffee,
      title: t(".photos"),
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>
  </section>
</main>
