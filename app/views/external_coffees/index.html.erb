<main class="rn-page">
  <section class="rn-shell max-w-5xl py-6 sm:px-6 lg:py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
        <h1 class="mt-4 text-4xl font-black leading-tight text-rn-ink sm:text-5xl"><%= t(".title") %></h1>
      </div>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".new"), new_external_coffee_path, class: "rounded-2xl bg-[var(--rn-coffee)] px-4 py-3 text-sm font-extrabold text-[#fff8e8] shadow-sm hover:opacity-90" %>
      <% end %>
    </div>

    <% if @external_coffees.any? %>
      <div class="mt-6 grid gap-4">
        <% @external_coffees.records.each do |external_coffee| %>
          <%= render "compact_card", external_coffee: %>
        <% end %>
      </div>

      <%= render "shared/history_pagination", paginator: @external_coffees, params: request.query_parameters.except("page") %>
    <% else %>
      <p class="mt-6 rounded-2xl border border-rn-line bg-rn-surface p-5 text-sm font-semibold text-rn-muted"><%= t(".empty") %></p>
    <% end %>
  </section>
</main>
