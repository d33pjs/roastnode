<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-2xl px-6 py-10">
    <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>

    <div class="mt-6 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <h1 class="text-3xl font-bold text-stone-950"><%= t(".title") %></h1>

      <%= form_with model: @user, url: profile_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
        <div>
          <p class="block text-sm font-medium text-stone-700"><%= t(".email_address") %></p>
          <p data-testid="profile-email" class="mt-1 rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-stone-700"><%= @user.email_address %></p>
          <%= link_to t(".change_password"), edit_password_change_path, class: "mt-3 inline-flex rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>
        </div>

        <div>
          <%= form.label :display_name, t(".username"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :display_name, autocomplete: "nickname", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :avatar, t(".avatar"), class: "block text-sm font-medium text-stone-700" %>
            <% if @user.avatar.attached? %>
              <%= image_tag media_attachment_path(@user.avatar.attachment, variant: :thumbnail), alt: "", data: { testid: "profile-avatar-preview" }, class: "mt-2 h-20 w-20 rounded-full object-cover ring-1 ring-stone-200" %>
            <% end %>
            <%= form.file_field :avatar, accept: "image/*", class: "mt-2 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
          </div>

          <div>
            <%= form.label :public_banner, t(".public_banner"), class: "block text-sm font-medium text-stone-700" %>
            <% if @user.public_banner.attached? %>
              <%= image_tag media_attachment_path(@user.public_banner.attachment, variant: :thumbnail), alt: "", data: { testid: "profile-public-banner-preview" }, class: "mt-2 h-20 w-full rounded-md object-cover ring-1 ring-stone-200" %>
            <% end %>
            <%= form.file_field :public_banner, accept: "image/*", class: "mt-2 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
          </div>
        </div>

        <div>
          <%= form.label :default_landing_screen, t(".default_landing_screen"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :default_landing_screen,
            User::DEFAULT_LANDING_SCREENS.map { |screen| [ t(".landing_screens.#{screen}"), screen ] },
            {},
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :theme, t(".theme"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :theme,
            User::THEMES.map { |theme| [ t(".themes.#{theme}"), theme ] },
            {},
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :number_format, t(".number_format"), class: "block text-sm font-medium text-stone-700" %>
            <%= form.select :number_format,
              User::NUMBER_FORMATS.map { |format| [ t(".number_formats.#{format}"), format ] },
              {},
              class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
          </div>

          <div>
            <%= form.label :time_format, t(".time_format"), class: "block text-sm font-medium text-stone-700" %>
            <%= form.select :time_format,
              User::TIME_FORMATS.map { |format| [ t(".time_formats.#{format}"), format ] },
              {},
              class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
          </div>
        </div>

        <div>
          <%= form.label :default_brew_focus_field, t(".default_brew_focus_field"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :default_brew_focus_field,
            User::DEFAULT_BREW_FOCUS_FIELDS.map { |field| [ t(".brew_focus_fields.#{field}"), field ] },
            {},
            class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-stone-700"><%= t(".hidden_brew_fields_title") %></legend>
          <%= hidden_field_tag "user[hidden_brew_field_names][]", "" %>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <% User::HIDEABLE_BREW_FIELDS.each do |field| %>
              <label for="user_hidden_brew_field_<%= field %>" class="flex items-center gap-2 rounded-md border border-stone-200 px-3 py-2 text-sm text-stone-800">
                <%= check_box_tag "user[hidden_brew_field_names][]",
                  field,
                  @user.hidden_brew_field_names.include?(field),
                  id: "user_hidden_brew_field_#{field}",
                  class: "rounded border-stone-300 text-stone-950" %>
                <span><%= t(".hidden_brew_fields.#{field}") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <%= form.submit t(".save"), class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
      <% end %>
    </div>
  </section>
</main>
