<% if record.photos.attached? %>
  <% actions_allowed = local_assigns.fetch(:actions_allowed, current_workspace_policy.write?) %>
  <% photos = record.photos.attachments.to_a %>
  <% lightbox_sources = photos.map { |photo| media_attachment_path(photo) } %>
  <% section_attributes = {
    class: section_class,
    data: {
      controller: "photo-lightbox",
      photo_lightbox_sources_value: lightbox_sources.to_json,
      action: "keydown@window->photo-lightbox#closeFromKeyboard"
    }
  } %>
  <% section_attributes[:id] = local_assigns[:section_id] if local_assigns[:section_id].present? %>
  <%= tag.section(**section_attributes) do %>
    <h2 class="<%= title_class %>"><%= title %></h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <% primary_photo = record.primary_photo_attachment %>
      <% photos.each_with_index do |photo, index| %>
        <figure class="relative overflow-hidden rounded-md border border-stone-200 bg-stone-100">
          <button type="button" data-action="photo-lightbox#open" data-photo-lightbox-index-param="<%= index %>" data-full-src="<%= media_attachment_path(photo) %>" aria-label="<%= t(".open_photo") %>" class="block h-48 w-full bg-stone-100 p-2">
            <%= image_tag media_attachment_path(photo, variant: :thumbnail), alt: "", class: "h-full w-full object-contain" %>
          </button>
          <figcaption class="flex flex-wrap gap-2 bg-white/95 p-2">
            <%= link_to t(".view"),
              media_attachment_path(photo),
              target: "_blank",
              rel: "noopener",
              class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
            <%= link_to t(".download"),
              download_media_attachment_path(photo),
              class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
            <% if actions_allowed %>
              <%= link_to t(".crop"),
                crop_media_attachment_path(photo),
                class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
            <% end %>
            <% if photo == primary_photo %>
              <span class="rounded-md bg-amber-100 px-3 py-1.5 text-xs font-bold text-amber-900"><%= t(".primary") %></span>
            <% elsif actions_allowed %>
              <%= button_to t(".make_primary"),
                primary_media_attachment_path(photo),
                method: :patch,
                class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
            <% end %>
          </figcaption>
          <% if actions_allowed %>
            <%= button_to t(".delete"),
              media_attachment_path(photo),
              method: :delete,
              class: "absolute right-2 top-2 rounded-md bg-white/95 px-3 py-1.5 text-xs font-bold text-red-700 shadow-sm ring-1 ring-red-100 hover:bg-red-50" %>
          <% end %>
        </figure>
      <% end %>
    </div>
    <%= render "shared/photo_lightbox",
      close_label: t(".close_photo"),
      previous_label: t(".previous_photo"),
      next_label: t(".next_photo") %>
  <% end %>
<% end %>
