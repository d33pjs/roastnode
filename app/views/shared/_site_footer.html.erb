<% buy_me_a_coffee = local_assigns[:buy_me_a_coffee].presence %>
<% buy_me_a_coffee ||= { mode: :link, url: local_assigns[:buy_me_a_coffee_url].presence } if local_assigns[:buy_me_a_coffee_url].present? %>
<% show_version = local_assigns.fetch(:show_version, true) && Current.user.present? %>
<% buy_me_a_coffee_url = buy_me_a_coffee&.fetch(:url, nil).presence %>
<% buy_me_a_coffee_text = buy_me_a_coffee&.fetch(:text, nil).presence || t("shared.site_footer.buy_me_a_coffee") %>

<footer data-testid="site-footer" class="border-t border-rn-line bg-rn-surface px-5 py-6 text-sm text-rn-muted">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 sm:flex-row">
    <div class="flex w-full items-center justify-center sm:w-auto sm:justify-start">
      <%= link_to Roastnode::AppVersion.github_url,
        target: "_blank",
        rel: "noopener",
        data: { testid: "site-footer-github" },
        class: "inline-flex h-11 min-w-36 items-center justify-center gap-2 rounded-md border border-rn-line bg-rn-canvas px-4 text-sm font-extrabold text-rn-ink shadow-sm transition hover:border-rn-muted" do %>
        <svg data-testid="site-footer-github-logo" aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18.92-.26 1.9-.38 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.79.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
        <span><%= t("shared.site_footer.github") %></span>
      <% end %>
    </div>

    <div class="flex w-full items-center justify-center sm:w-auto sm:justify-end">
      <% if buy_me_a_coffee_url.present? %>
        <%= link_to buy_me_a_coffee_url,
          target: "_blank",
          rel: "noopener",
          data: { testid: "site-footer-buy-me-a-coffee" },
          class: "inline-flex h-11 min-w-36 items-center justify-center gap-2 rounded-md bg-[#986338] px-4 text-sm font-extrabold text-white shadow-sm transition hover:bg-[#7f522e]" do %>
          <span data-testid="site-footer-buy-me-a-coffee-logo" aria-hidden="true" class="inline-flex h-6 w-6 items-center justify-center rounded bg-[#ffdd00] text-[#3a260f]">
            <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
              <path d="M5 4h11a2 2 0 0 1 2 2v1h1.25a3.25 3.25 0 1 1 0 6.5H18v.5a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V6a2 2 0 0 1 2-2Zm13 7.5h1.25a1.25 1.25 0 0 0 0-2.5H18v2.5ZM5 6v8a3 3 0 0 0 3 3h5a3 3 0 0 0 3-3V6H5Z" />
            </svg>
          </span>
          <span><%= buy_me_a_coffee_text %></span>
        <% end %>
      <% elsif show_version %>
        <p data-testid="site-footer-version" class="font-bold">
          <%= t("shared.site_footer.version", version: Roastnode::AppVersion.current) %>
        </p>
      <% end %>
    </div>
  </div>
</footer>
