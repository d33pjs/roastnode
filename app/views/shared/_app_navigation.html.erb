<% settings_navigation_visible = current_workspace_policy.manage? || current_workspace_policy.export? %>

<nav data-controller="app-nav" data-action="click@window->app-nav#closeFromOutside keydown@window->app-nav#closeFromKeyboard" data-testid="app-navigation" class="rn-app-nav border-b border-rn-line bg-rn-surface px-4 py-3 shadow-sm sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-3">
      <%= link_to dashboard_path, class: "flex min-w-0 shrink items-center" do %>
        <%= render "shared/brand_wordmark",
          container_class: "block h-8 w-36 max-w-[45vw] shrink-0 sm:h-9 sm:w-44",
          image_class: "h-full w-full object-contain object-left" %>
      <% end %>

      <div data-testid="app-desktop-navigation" class="hidden items-center gap-1 md:flex">
        <% if current_workspace_policy.write? %>
          <%= link_to t("shared.app_navigation.log"), new_brew_path, data: { testid: "app-nav-log" }, class: "rn-nav-link rn-nav-link-primary" %>
        <% end %>
        <%= link_to t("shared.app_navigation.dashboard"), dashboard_path, data: { testid: "app-nav-dashboard" }, class: "rn-nav-link" %>
        <%= link_to t("shared.app_navigation.beans"), beans_path, data: { testid: "app-nav-beans" }, class: "rn-nav-link" %>
        <%= link_to t("shared.app_navigation.recipes"), recipes_path, data: { testid: "app-nav-recipes" }, class: "rn-nav-link" %>
        <%= link_to t("shared.app_navigation.statistics"), statistics_path, data: { testid: "app-nav-statistics" }, class: "rn-nav-link" %>

        <%= link_to t("shared.app_navigation.gear"), gear_path, data: { testid: "app-nav-gear" }, class: "rn-nav-link" %>

        <details data-app-nav-target="menu" data-action="toggle->app-nav#closeOtherMenus" data-testid="app-nav-account" class="relative">
          <summary class="rn-nav-link cursor-pointer list-none"><%= t("shared.app_navigation.account") %></summary>
          <div class="rn-nav-menu-panel absolute right-0 top-11 z-50 min-w-60">
            <%= link_to t("shared.app_navigation.profile"), edit_profile_path, class: "rn-nav-sub-link" %>
            <%= link_to t("shared.app_navigation.members"), memberships_path, class: "rn-nav-sub-link" %>
            <% if current_workspace_policy.manage? %>
              <%= link_to t("shared.app_navigation.workspace_settings"), edit_workspace_path, class: "rn-nav-sub-link" %>
              <%= link_to t("shared.app_navigation.invites"), workspace_invites_path, class: "rn-nav-sub-link" %>
            <% end %>
            <% if Current.user.instance_admin? %>
              <%= link_to t("shared.app_navigation.instance_admin"), instance_admin_path, class: "rn-nav-sub-link" %>
            <% end %>
          </div>
        </details>

        <% if settings_navigation_visible %>
          <details data-app-nav-target="menu" data-action="toggle->app-nav#closeOtherMenus" data-testid="app-nav-settings" class="relative">
            <summary class="rn-nav-link cursor-pointer list-none"><%= t("shared.app_navigation.settings") %></summary>
            <div class="rn-nav-menu-panel absolute right-0 top-11 z-50 min-w-60">
              <% if current_workspace_policy.manage? %>
                <%= link_to t("shared.app_navigation.import"), new_beanconqueror_import_path, class: "rn-nav-sub-link" %>
              <% end %>
              <% if current_workspace_policy.export? %>
                <%= link_to t("shared.app_navigation.export"), workspace_export_path, class: "rn-nav-sub-link" %>
                <%= link_to t("shared.app_navigation.export_beans"), workspace_export_beans_path, class: "rn-nav-sub-link" %>
                <%= link_to t("shared.app_navigation.export_brews"), workspace_export_brews_path, class: "rn-nav-sub-link" %>
                <%= link_to t("shared.app_navigation.export_external_coffees"), workspace_export_external_coffees_path, class: "rn-nav-sub-link" %>
                <%= link_to t("shared.app_navigation.export_media"), workspace_export_media_path, class: "rn-nav-sub-link" %>
              <% end %>
            </div>
          </details>
        <% end %>

        <%= button_to t("shared.app_navigation.sign_out", user: Current.user.display_label), session_path, method: :delete, class: "rn-nav-sign-out max-w-40 truncate" %>
      </div>

      <div data-testid="app-mobile-actions" class="ml-auto flex shrink-0 items-center gap-2 md:hidden">
        <% if current_workspace_policy.write? %>
          <%= link_to t("shared.app_navigation.log"), new_brew_path, data: { testid: "app-nav-log" }, class: "rn-nav-link rn-nav-link-primary" %>
        <% end %>

        <details data-app-nav-target="menu" data-action="toggle->app-nav#closeOtherMenus" data-testid="app-mobile-menu" class="relative">
          <summary class="rn-nav-link cursor-pointer list-none"><%= t("shared.app_navigation.menu") %></summary>

          <div class="rn-nav-menu-panel absolute right-0 top-12 z-50 grid w-72 max-w-[calc(100vw-2rem)] gap-3">
            <div class="grid gap-1">
              <%= link_to t("shared.app_navigation.dashboard"), dashboard_path, data: { testid: "app-nav-dashboard" }, class: "rn-nav-sub-link" %>
              <%= link_to t("shared.app_navigation.beans"), beans_path, data: { testid: "app-nav-beans" }, class: "rn-nav-sub-link" %>
              <%= link_to t("shared.app_navigation.recipes"), recipes_path, data: { testid: "app-nav-recipes" }, class: "rn-nav-sub-link" %>
              <%= link_to t("shared.app_navigation.gear"), gear_path, data: { testid: "app-nav-gear" }, class: "rn-nav-sub-link" %>
              <%= link_to t("shared.app_navigation.statistics"), statistics_path, data: { testid: "app-nav-statistics" }, class: "rn-nav-sub-link" %>
            </div>

            <div data-testid="app-nav-account" class="rn-nav-group">
              <p class="rn-nav-group-title"><%= t("shared.app_navigation.account") %></p>
              <%= link_to t("shared.app_navigation.profile"), edit_profile_path, class: "rn-nav-sub-link" %>
              <%= link_to t("shared.app_navigation.members"), memberships_path, class: "rn-nav-sub-link" %>
              <% if current_workspace_policy.manage? %>
                <%= link_to t("shared.app_navigation.workspace_settings"), edit_workspace_path, class: "rn-nav-sub-link" %>
                <%= link_to t("shared.app_navigation.invites"), workspace_invites_path, class: "rn-nav-sub-link" %>
              <% end %>
              <% if Current.user.instance_admin? %>
                <%= link_to t("shared.app_navigation.instance_admin"), instance_admin_path, class: "rn-nav-sub-link" %>
              <% end %>
            </div>

            <% if settings_navigation_visible %>
              <div data-testid="app-nav-settings" class="rn-nav-group">
                <p class="rn-nav-group-title"><%= t("shared.app_navigation.settings") %></p>
                <% if current_workspace_policy.manage? %>
                  <%= link_to t("shared.app_navigation.import"), new_beanconqueror_import_path, class: "rn-nav-sub-link" %>
                <% end %>
                <% if current_workspace_policy.export? %>
                  <%= link_to t("shared.app_navigation.export"), workspace_export_path, class: "rn-nav-sub-link" %>
                  <%= link_to t("shared.app_navigation.export_beans"), workspace_export_beans_path, class: "rn-nav-sub-link" %>
                  <%= link_to t("shared.app_navigation.export_brews"), workspace_export_brews_path, class: "rn-nav-sub-link" %>
                  <%= link_to t("shared.app_navigation.export_external_coffees"), workspace_export_external_coffees_path, class: "rn-nav-sub-link" %>
                  <%= link_to t("shared.app_navigation.export_media"), workspace_export_media_path, class: "rn-nav-sub-link" %>
                <% end %>
              </div>
            <% end %>

            <%= button_to t("shared.app_navigation.sign_out", user: Current.user.display_label), session_path, method: :delete, class: "rn-nav-sign-out w-full truncate text-left" %>
          </div>
        </details>
      </div>
    </div>
  </div>
</nav>
