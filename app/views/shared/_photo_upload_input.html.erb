<% field = local_assigns.fetch(:field, :photos) %>
<% multiple = local_assigns.fetch(:multiple, true) %>
<% accept = local_assigns.fetch(:accept, "image/*") %>
<% include_hidden = local_assigns.fetch(:include_hidden, false) %>
<% testid = local_assigns.fetch(:testid, "photo-upload-input") %>
<% data = local_assigns.fetch(:data, {}).merge(testid:) %>
<% spacing_class = local_assigns.fetch(:spacing_class, "mt-1") %>
<% class_name = local_assigns.fetch(:class_name, "rn-photo-upload-input #{spacing_class} block min-w-0 max-w-full w-full rounded-2xl border border-rn-line bg-rn-surface px-3 py-2.5 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none") %>

<%= form.file_field field, multiple:, accept:, include_hidden:, class: class_name, data: %>
