<% fallback_path = local_assigns.fetch(:path).to_s %>
<% prefer_referrer = local_assigns.fetch(:prefer_referrer, true) %>
<% path = prefer_referrer ? back_link_path(fallback_path) : fallback_path %>
<% label = path == fallback_path ? local_assigns.fetch(:label) : t("shared.back_link.previous") %>

<%= link_to path,
  data: { testid: "back-link" },
  class: "inline-flex min-h-10 items-center gap-2 rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-bold text-stone-800 shadow-sm hover:bg-stone-100" do %>
  <span aria-hidden="true" class="text-lg leading-none">&larr;</span>
  <span><%= label %></span>
<% end %>
