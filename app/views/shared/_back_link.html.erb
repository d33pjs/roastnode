<% fallback_path = local_assigns.fetch(:path).to_s %>
<% prefer_referrer = local_assigns.fetch(:prefer_referrer, true) %>
<% path = prefer_referrer ? back_link_path(fallback_path) : fallback_path %>
<% label = path == fallback_path ? local_assigns.fetch(:label) : t("shared.back_link.previous") %>

<%= link_to path,
  data: { testid: "back-link" },
  aria: { label: label },
  title: label,
  class: "inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-stone-300 bg-white text-stone-800 shadow-sm hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-400" do %>
  <%= material_symbol("arrow_back") %>
<% end %>
