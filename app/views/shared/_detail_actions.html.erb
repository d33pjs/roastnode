<% actions = Array(local_assigns.fetch(:actions)).compact %>
<% testid = local_assigns.fetch(:testid) %>

<% if actions.any? %>
  <% primary_action = actions.find { |action| action[:primary] } || actions.first %>
  <% mobile_pinned_actions = actions.select { |action| action[:mobile_pinned] } %>
  <% mobile_action_ids = mobile_pinned_actions.map(&:object_id) %>
  <% mobile_action_ids << primary_action.object_id unless mobile_action_ids.include?(primary_action.object_id) %>
  <% overflow_actions = actions.reject { |action| mobile_action_ids.include?(action.object_id) } %>
  <% compact_mobile = mobile_pinned_actions.any? || actions.size > 2 %>

  <div data-testid="<%= testid %>" class="relative flex min-w-0 max-w-full flex-1 items-center justify-end gap-2 sm:flex-none">
    <div class="hidden flex-wrap items-center justify-end gap-2 sm:flex">
      <% actions.each do |action| %>
        <%= render "shared/detail_action", action:, variant: :icon %>
      <% end %>
    </div>

    <div class="flex items-center justify-end gap-2 sm:hidden">
      <% if compact_mobile %>
        <% mobile_pinned_actions.each do |action| %>
          <%= render "shared/detail_action",
            action:,
            variant: :icon,
            testid: action[:testid].present? ? "#{action[:testid]}-mobile" : nil %>
        <% end %>

        <% unless mobile_pinned_actions.any? { |action| action.equal?(primary_action) } %>
          <%= render "shared/detail_action",
            action: primary_action,
            variant: :icon,
            testid: primary_action[:testid].present? ? "#{primary_action[:testid]}-mobile" : nil %>
        <% end %>

        <% if overflow_actions.any? %>
          <details data-testid="<%= testid %>-more" class="relative">
            <summary aria-label="<%= t("shared.detail_actions.more") %>" title="<%= t("shared.detail_actions.more") %>" class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full text-stone-700 hover:bg-stone-100 hover:text-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-400 [&::-webkit-details-marker]:hidden">
              <%= material_symbol("more_vert") %>
            </summary>
            <div data-testid="<%= testid %>-menu" class="rn-detail-menu-panel absolute right-0 z-30 mt-2 min-w-56 gap-1 rounded-md border border-stone-200 bg-white p-2 shadow-lg">
              <% overflow_actions.each do |action| %>
                <%= render "shared/detail_action", action:, variant: :menu %>
              <% end %>
            </div>
          </details>
        <% end %>
      <% else %>
        <% actions.each do |action| %>
          <%= render "shared/detail_action",
            action:,
            variant: :icon,
            testid: action[:testid].present? ? "#{action[:testid]}-mobile" : nil %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
