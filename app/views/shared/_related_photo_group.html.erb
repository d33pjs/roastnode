<% photos = record.photos.attachments.to_a %>
<% lightbox_sources = photos.map { |photo| media_attachment_path(photo) } %>

<article data-testid="brew-related-photo-group" data-controller="photo-lightbox" data-photo-lightbox-sources-value="<%= lightbox_sources.to_json %>" data-action="keydown@window->photo-lightbox#closeFromKeyboard" class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
  <p class="text-xs font-bold uppercase text-stone-500"><%= title %></p>
  <h3 class="mt-1 text-base font-bold text-stone-950"><%= name %></h3>

  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <% photos.each_with_index do |photo, index| %>
      <figure class="overflow-hidden rounded-md border border-stone-200 bg-stone-100">
        <button type="button" data-action="photo-lightbox#open" data-photo-lightbox-index-param="<%= index %>" data-full-src="<%= media_attachment_path(photo) %>" aria-label="<%= t(".open_photo") %>" class="block h-40 w-full bg-stone-100 p-2">
          <%= image_tag media_attachment_path(photo, variant: :thumbnail), alt: "", data: { testid: "brew-related-photo" }, class: "h-full w-full object-contain" %>
        </button>
        <figcaption class="flex flex-wrap gap-2 bg-white/95 p-2">
          <%= link_to t(".view"),
            media_attachment_path(photo),
            target: "_blank",
            rel: "noopener",
            class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
          <%= link_to t(".download"),
            download_media_attachment_path(photo),
            class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
        </figcaption>
      </figure>
    <% end %>
  </div>
  <%= render "shared/photo_lightbox",
    close_label: t(".close_photo"),
    previous_label: t(".previous_photo"),
    next_label: t(".next_photo") %>
</article>
