<article data-testid="brew-related-photo-group" class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
  <p class="text-xs font-bold uppercase text-stone-500"><%= title %></p>
  <h3 class="mt-1 text-base font-bold text-stone-950"><%= name %></h3>

  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <% record.photos.attachments.each do |photo| %>
      <figure class="overflow-hidden rounded-md border border-stone-200 bg-stone-100">
        <%= link_to media_attachment_path(photo), target: "_blank", rel: "noopener", class: "block" do %>
          <%= image_tag media_attachment_path(photo, variant: :thumbnail), alt: "", data: { testid: "brew-related-photo" }, class: "h-36 w-full object-cover" %>
        <% end %>
        <figcaption class="flex flex-wrap gap-2 bg-white/95 p-2">
          <%= link_to t(".view"),
            media_attachment_path(photo),
            target: "_blank",
            rel: "noopener",
            class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
          <%= link_to t(".download"),
            download_media_attachment_path(photo),
            class: "rounded-md border border-stone-200 px-3 py-1.5 text-xs font-bold text-stone-800 hover:bg-stone-50" %>
        </figcaption>
      </figure>
    <% end %>
  </div>
</article>
