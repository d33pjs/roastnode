<% container_class = local_assigns.fetch(:container_class, "relative block h-12 w-12 overflow-hidden rounded-md bg-stone-50") %>
<% image_class = local_assigns.fetch(:image_class, "absolute left-1/2 top-1/2 w-20 max-w-none -translate-x-1/2 -translate-y-1/2") %>
<% testid = local_assigns.fetch(:testid, "brand-mark") %>

<div class="<%= container_class %>" aria-hidden="true">
  <%= image_tag "brand/logo_mark_icon.png", alt: "", data: { testid: testid }, class: image_class %>
</div>
