<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-6xl px-6 py-10">
    <header class="border-b border-stone-200 pb-8">
      <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
      <p class="mt-6 text-sm font-semibold uppercase text-stone-600"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-bold text-stone-950"><%= t(".title") %></h1>
      <p class="mt-3 max-w-2xl text-stone-700"><%= t(".intro") %></p>
    </header>

    <section class="grid gap-4 border-b border-stone-200 py-8 md:grid-cols-3">
      <div data-testid="instance-admin-status" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".instance_mode") %></p>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= t(".private_mode") %></p>
        <p class="mt-2 text-sm text-stone-600"><%= t(".private_mode_note") %></p>
      </div>

      <div data-testid="instance-admin-public-registration" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".public_registration") %></p>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= t(".disabled") %></p>
        <p class="mt-2 text-sm text-stone-600"><%= t(".public_registration_note") %></p>
      </div>

      <div data-testid="instance-admin-demo-data" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".demo_data") %></p>
        <p class="mt-2 font-mono text-sm font-semibold text-stone-950">bin/rails roastnode:demo:load</p>
        <p class="mt-2 text-sm text-stone-600"><%= t(".demo_data_note") %></p>
      </div>
    </section>

    <section data-testid="instance-admin-household-invites" class="border-b border-stone-200 py-8">
      <h2 class="text-xl font-bold text-stone-950"><%= t(".household_invites") %></h2>
      <p class="mt-2 max-w-3xl text-sm text-stone-600"><%= t(".household_invites_intro") %></p>

      <%= form_with model: @household_invite, url: instance_admin_household_invites_path, class: "mt-4 grid gap-4 md:grid-cols-[1fr_auto]" do |form| %>
        <div>
          <%= form.label :email_address, t(".household_invite_email"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.email_field :email_address, required: true, placeholder: t(".household_invite_email_placeholder"), class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>
        <div class="flex items-end">
          <%= form.submit t(".create_household_invite"), class: "w-full rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800 md:w-auto" %>
        </div>
      <% end %>

      <% if @household_invites.any? %>
        <div class="mt-6 overflow-x-auto rounded-lg border border-stone-200 bg-white shadow-sm">
          <table class="min-w-full divide-y divide-stone-200">
            <thead class="bg-stone-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".household_invite_email") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".household_invite_status") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".household_invite_url") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".household_invite_actions") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              <% @household_invites.each do |invite| %>
                <tr data-testid="instance-admin-household-invite-<%= invite.id %>">
                  <td class="px-4 py-3">
                    <p class="text-sm font-semibold text-stone-950"><%= invite.email_address %></p>
                    <p class="text-xs text-stone-600"><%= invite.workspace&.name || t(".household_invite_any_workspace") %></p>
                  </td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= invite.acceptable? ? t(".household_invite_active") : t(".household_invite_closed") %></td>
                  <td class="px-4 py-3">
                    <%= text_field_tag nil, household_invite_url(invite.token), readonly: true, class: "w-full rounded-md border border-stone-300 bg-stone-50 px-3 py-2 text-sm text-stone-700" %>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-2">
                      <% if invite.acceptable? %>
                        <%= button_to t(".resend_household_invite"), resend_instance_admin_household_invite_path(invite), method: :post, class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
                        <%= button_to t(".revoke_household_invite"), revoke_instance_admin_household_invite_path(invite), method: :patch, class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
                      <% else %>
                        <%= button_to t(".reinvite_household"), reinvite_instance_admin_household_invite_path(invite), method: :post, class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="border-b border-stone-200 py-8">
      <h2 class="text-xl font-bold text-stone-950"><%= t(".health") %></h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <% @health_checks.each do |check| %>
          <div data-testid="instance-admin-health-<%= check.key %>" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".health_labels.#{check.key}") %></p>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold uppercase text-emerald-800"><%= t(".#{check.status}") %></span>
            </div>
            <p class="mt-3 text-sm font-medium text-stone-800"><%= check.detail %></p>
          </div>
        <% end %>
      </div>
    </section>

    <section data-testid="instance-admin-operations" class="border-b border-stone-200 py-8">
      <% queue_status = @operations_snapshot.queue_status %>
      <% mail_status = @operations_snapshot.mail_status %>
      <% backup_status = @operations_snapshot.backup_status %>
      <% export_status = @operations_snapshot.export_status %>
      <h2 class="text-xl font-bold text-stone-950"><%= t(".operations") %></h2>
      <p class="mt-2 max-w-3xl text-sm text-stone-600"><%= t(".operations_intro") %></p>

      <div class="mt-4 grid gap-4 lg:grid-cols-4">
        <div data-testid="instance-admin-operations-queue" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".operation_labels.background_jobs") %></p>
            <span class="rounded-full <%= queue_status.status == :attention ? "bg-amber-50 text-amber-900" : "bg-emerald-50 text-emerald-800" %> px-2.5 py-1 text-xs font-semibold uppercase">
              <%= t(".operation_statuses.#{queue_status.status}") %>
            </span>
          </div>
          <p class="mt-3 text-2xl font-bold text-stone-950"><%= queue_status.value %></p>
          <p class="mt-2 text-sm text-stone-600"><%= queue_status.detail %></p>
        </div>

        <div data-testid="instance-admin-operations-mail" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".operation_labels.mail_delivery") %></p>
            <span class="rounded-full <%= mail_status.status == :attention ? "bg-amber-50 text-amber-900" : "bg-emerald-50 text-emerald-800" %> px-2.5 py-1 text-xs font-semibold uppercase">
              <%= t(".operation_statuses.#{mail_status.status}") %>
            </span>
          </div>
          <p class="mt-3 text-2xl font-bold text-stone-950"><%= mail_status.value %></p>
          <p class="mt-2 text-sm text-stone-600"><%= mail_status.detail %></p>
        </div>

        <div data-testid="instance-admin-operations-backups" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".operation_labels.backups") %></p>
            <span class="rounded-full <%= backup_status.status == :attention ? "bg-amber-50 text-amber-900" : "bg-emerald-50 text-emerald-800" %> px-2.5 py-1 text-xs font-semibold uppercase">
              <%= t(".operation_statuses.#{backup_status.status}") %>
            </span>
          </div>
          <p class="mt-3 text-2xl font-bold text-stone-950"><%= backup_status.value %></p>
          <p class="mt-2 text-sm text-stone-600"><%= backup_status.detail %></p>
        </div>

        <div data-testid="instance-admin-operations-export" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".operation_labels.workspace_exports") %></p>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold uppercase text-emerald-800"><%= t(".operation_statuses.#{export_status.status}") %></span>
          </div>
          <p class="mt-3 text-2xl font-bold text-stone-950"><%= export_status.value %></p>
          <p class="mt-2 text-sm text-stone-600"><%= export_status.detail %></p>
        </div>
      </div>

      <% if @operations_snapshot.queue_counts.any? %>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
          <% @operations_snapshot.queue_counts.each do |count| %>
            <div data-testid="instance-admin-queue-count-<%= count.key %>" class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
              <p class="text-xs font-semibold uppercase text-stone-600"><%= t(".operation_count_labels.#{count.key}") %></p>
              <p class="mt-2 text-2xl font-bold text-stone-950"><%= count.value %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @operations_snapshot.failed_jobs.any? %>
        <div class="mt-6 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
          <div class="border-b border-stone-100 px-4 py-3">
            <h3 class="text-sm font-bold uppercase text-stone-700"><%= t(".recent_failed_jobs") %></h3>
          </div>
          <table class="min-w-full divide-y divide-stone-200">
            <thead class="bg-stone-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".failed_job_class") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".failed_job_queue") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".failed_job_error") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".failed_at") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              <% @operations_snapshot.failed_jobs.each do |failure| %>
                <tr data-testid="instance-admin-failed-job-<%= failure.id %>">
                  <td class="px-4 py-3 text-sm font-semibold text-stone-950"><%= failure.class_name %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= failure.queue_name %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= failure.error_message %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= failure.failed_at ? l(failure.failed_at, format: :european_seconds) : t(".unknown") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @operations_snapshot.mail_failures.any? %>
        <div class="mt-6 overflow-hidden rounded-lg border border-amber-200 bg-amber-50 shadow-sm">
          <div class="border-b border-amber-200 px-4 py-3">
            <h3 class="text-sm font-bold uppercase text-amber-950"><%= t(".recent_mail_failures") %></h3>
          </div>
          <table class="min-w-full divide-y divide-amber-200">
            <thead class="bg-amber-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-amber-950"><%= t(".mail_failure_class") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-amber-950"><%= t(".mail_failure_queue") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-amber-950"><%= t(".mail_failure_error") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-amber-950"><%= t(".failed_at") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-amber-200">
              <% @operations_snapshot.mail_failures.each do |failure| %>
                <tr data-testid="instance-admin-mail-failure-<%= failure.id %>">
                  <td class="px-4 py-3 text-sm font-semibold text-amber-950"><%= failure.class_name %></td>
                  <td class="px-4 py-3 text-sm text-amber-900"><%= failure.queue_name %></td>
                  <td class="px-4 py-3 text-sm text-amber-900"><%= failure.error_message %></td>
                  <td class="px-4 py-3 text-sm text-amber-900"><%= failure.failed_at ? l(failure.failed_at, format: :european_seconds) : t(".unknown") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @operations_snapshot.backup_profile_rows.any? %>
        <div class="mt-6 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
          <div class="border-b border-stone-100 px-4 py-3">
            <h3 class="text-sm font-bold uppercase text-stone-700"><%= t(".backup_profile_status") %></h3>
          </div>
          <table class="min-w-full divide-y divide-stone-200">
            <thead class="bg-stone-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_run_profile") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_schedule") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_run_status") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".last_success") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              <% @operations_snapshot.backup_profile_rows.each do |row| %>
                <tr data-testid="instance-admin-backup-profile-status-<%= row.id %>">
                  <td class="px-4 py-3">
                    <p class="text-sm font-semibold text-stone-950"><%= row.name %></p>
                    <p class="text-xs text-stone-600"><%= t(".backup_kind_labels.#{row.backup_kind}") %></p>
                  </td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= t(".backup_schedules.#{row.schedule}") %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= row.latest_status ? t(".backup_statuses.#{row.latest_status}") : t(".no_backup_runs") %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= row.last_success_at ? l(row.last_success_at, format: :european_seconds) : t(".never") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @operations_snapshot.backup_failures.any? %>
        <div class="mt-6 overflow-hidden rounded-lg border border-amber-200 bg-amber-50 shadow-sm">
          <div class="border-b border-amber-200 px-4 py-3">
            <h3 class="text-sm font-bold uppercase text-amber-950"><%= t(".recent_backup_failures") %></h3>
          </div>
          <div class="divide-y divide-amber-200">
            <% @operations_snapshot.backup_failures.each do |failure| %>
              <div data-testid="instance-admin-backup-failure-<%= failure.id %>" class="px-4 py-3">
                <p class="text-sm font-semibold text-amber-950"><%= failure.profile_name %> &middot; <%= t(".backup_kind_labels.#{failure.backup_kind}") %></p>
                <p class="mt-1 text-sm text-amber-900"><%= failure.error_message %></p>
                <p class="mt-1 text-xs font-semibold uppercase text-amber-800"><%= failure.failed_at ? l(failure.failed_at, format: :european_seconds) : t(".unknown") %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>

    <section data-testid="instance-admin-backups" class="border-b border-stone-200 py-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-xl font-bold text-stone-950"><%= t(".backups") %></h2>
          <p class="mt-2 max-w-3xl text-sm text-stone-600"><%= t(".backups_intro") %></p>
        </div>
      </div>

      <% missing_backup_kinds = InstanceBackupProfile::BACKUP_KINDS - @backup_profiles.map(&:backup_kind) %>
      <% if missing_backup_kinds.any? %>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <% missing_backup_kinds.each do |backup_kind| %>
            <div class="rounded-lg border border-dashed border-stone-300 bg-white p-5">
              <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".backup_kind_labels.#{backup_kind}") %></p>
              <p class="mt-2 text-sm text-stone-600"><%= t(".backup_kind_descriptions.#{backup_kind}") %></p>
              <%= form_with model: InstanceBackupProfile.new(
                    backup_kind: backup_kind,
                    name: InstanceBackupProfile.default_name_for(backup_kind),
                    enabled: true,
                    schedule: backup_kind == "readable_json" ? "weekly" : "daily",
                    storage_path: InstanceBackupProfile.default_storage_path,
                    retention_count: InstanceBackupProfile.default_retention_count
                  ),
                  url: instance_admin_backup_profiles_path,
                  class: "mt-4" do |form| %>
                <%= form.hidden_field :backup_kind %>
                <%= form.hidden_field :name %>
                <%= form.hidden_field :enabled %>
                <%= form.hidden_field :schedule %>
                <%= form.hidden_field :storage_path %>
                <%= form.hidden_field :retention_count %>
                <%= form.submit t(".activate_backup"), class: "rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @backup_profiles.any? %>
        <div class="mt-6 grid gap-4 lg:grid-cols-2">
          <% @backup_profiles.each do |profile| %>
            <div data-testid="instance-admin-backup-profile-<%= profile.id %>" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".backup_kind_labels.#{profile.backup_kind}") %></p>
                  <h3 class="mt-1 text-lg font-bold text-stone-950"><%= profile.name %></h3>
                </div>
                <span class="w-fit rounded-full <%= profile.enabled? ? "bg-emerald-50 text-emerald-800" : "bg-stone-100 text-stone-700" %> px-2.5 py-1 text-xs font-semibold uppercase">
                  <%= profile.enabled? ? t(".enabled") : t(".disabled") %>
                </span>
              </div>

              <%= form_with model: profile, url: instance_admin_backup_profile_path(profile), method: :patch, class: "mt-5 grid gap-4" do |form| %>
                <div>
                  <%= form.label :name, t(".backup_name"), class: "text-sm font-semibold text-stone-700" %>
                  <%= form.text_field :name, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm" %>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <%= form.label :schedule, t(".backup_schedule"), class: "text-sm font-semibold text-stone-700" %>
                    <%= form.select :schedule, InstanceBackupProfile::SCHEDULES.map { |schedule| [ t(".backup_schedules.#{schedule}"), schedule ] }, {}, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm" %>
                  </div>
                  <div>
                    <%= form.label :retention_count, t(".retention_count"), class: "text-sm font-semibold text-stone-700" %>
                    <%= form.number_field :retention_count, min: 1, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm" %>
                  </div>
                </div>
                <div>
                  <%= form.label :storage_path, t(".storage_path"), class: "text-sm font-semibold text-stone-700" %>
                  <%= form.text_field :storage_path, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm" %>
                </div>
                <label class="flex items-center gap-2 text-sm font-semibold text-stone-700">
                  <%= form.check_box :enabled, class: "h-4 w-4 rounded border-stone-300 text-stone-950" %>
                  <%= t(".backup_enabled") %>
                </label>
                <%= form.submit t(".save_backup"), class: "w-fit rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
              <% end %>

              <%= button_to t(".run_backup"), run_instance_admin_backup_profile_path(profile), method: :post, class: "mt-3 rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>

              <% last_run = profile.instance_backup_runs.max_by(&:created_at) %>
              <p class="mt-4 text-sm text-stone-600">
                <%= last_run ? t(".last_backup_run", status: t(".backup_statuses.#{last_run.status}"), time: l(last_run.created_at, format: :european_seconds)) : t(".no_backup_runs") %>
              </p>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @backup_runs.any? %>
        <div class="mt-6 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
          <table class="min-w-full divide-y divide-stone-200">
            <thead class="bg-stone-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_run_profile") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_run_status") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_run_file") %></th>
                <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".backup_run_created") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              <% @backup_runs.each do |run| %>
                <tr data-testid="instance-admin-backup-run-<%= run.id %>">
                  <td class="px-4 py-3 text-sm font-semibold text-stone-950"><%= run.instance_backup_profile.name %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= t(".backup_statuses.#{run.status}") %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= run.file_path.presence || t(".pending_file") %></td>
                  <td class="px-4 py-3 text-sm text-stone-700"><%= l(run.created_at, format: :european_seconds) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="py-8">
      <h2 class="text-xl font-bold text-stone-950"><%= t(".metrics") %></h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <% @metrics.each do |name, value| %>
          <div data-testid="instance-admin-metric-<%= name %>" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".metric_labels.#{name}") %></p>
            <p class="mt-2 text-3xl font-bold text-stone-950"><%= value %></p>
          </div>
        <% end %>
      </div>
    </section>

    <section data-testid="instance-admin-users" class="border-t border-stone-200 py-8">
      <h2 class="text-xl font-bold text-stone-950"><%= t(".users") %></h2>
      <div class="mt-4 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-stone-200">
          <thead class="bg-stone-100">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".display_name") %></th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".email_address") %></th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".workspace_memberships") %></th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".account_role") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @user_rows.each do |user_row| %>
              <tr data-testid="instance-admin-user-<%= user_row.id %>">
                <td class="px-4 py-3">
                  <p class="text-sm font-semibold text-stone-950"><%= user_row.display_label %></p>
                </td>
                <td class="px-4 py-3">
                  <p class="text-sm text-stone-700"><%= user_row.email_address %></p>
                </td>
                <td class="px-4 py-3">
                  <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-semibold text-stone-700"><%= t(".workspace_count", count: user_row.workspace_count) %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="rounded-full <%= user_row.instance_admin ? "bg-amber-50 text-amber-900" : "bg-stone-100 text-stone-700" %> px-2.5 py-1 text-xs font-semibold"><%= user_row.instance_admin ? t(".instance_admin_badge") : t(".user_badge") %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</main>
