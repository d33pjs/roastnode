<main class="rn-page overflow-x-hidden">
  <section class="rn-shell max-w-6xl py-5 sm:px-6 lg:py-10">
    <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
        <h1 class="mt-4 text-3xl font-black leading-tight text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
        <p class="mt-1 text-sm font-semibold text-rn-muted"><%= current_workspace.name %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <div class="flex flex-wrap gap-2">
          <% if current_workspace_policy.write? %>
            <%= link_to t(".log_maintenance"), new_equipment_event_path, class: "shrink-0 rounded-2xl bg-[var(--rn-accent-strong)] px-3.5 py-2.5 text-sm font-extrabold text-[#f8faf6] shadow-sm hover:opacity-90 sm:px-4 sm:py-3" %>
          <% end %>
          <% if current_workspace_policy.manage? %>
            <%= link_to t(".new_equipment"), new_equipment_path, class: "shrink-0 rounded-2xl border border-rn-line bg-rn-surface px-3.5 py-2.5 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)] sm:px-4 sm:py-3" %>
            <%= link_to t(".new_tool"), new_preparation_tool_path, class: "shrink-0 rounded-2xl border border-rn-line bg-rn-surface px-3.5 py-2.5 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)] sm:px-4 sm:py-3" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <section data-testid="gear-equipment-section" class="mt-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h2 class="text-xl font-black text-rn-ink"><%= t(".equipment") %></h2>
        <%= link_to t(".open_equipment"), equipment_index_path, class: "text-sm font-bold text-rn-muted hover:text-rn-ink" %>
      </div>

      <div class="grid max-w-full min-w-0 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <% if @equipment.any? %>
          <% @equipment.each do |item| %>
            <% status_label = item.archived? ? t(".archived") : t(".active") %>

            <%= link_to equipment_path(item), data: { testid: "gear-equipment-card" }, class: "block max-w-full min-w-0 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface p-3 shadow-sm hover:bg-[var(--rn-surface-muted)] sm:p-4" do %>
              <div class="flex min-w-0 items-start gap-2.5 sm:gap-3">
                <%= render "shared/record_photo_thumb",
                  record: item,
                  testid: "gear-equipment-card-photo",
                  class_name: "h-12 w-12 shrink-0 rounded-xl object-contain ring-1 ring-stone-200 sm:h-14 sm:w-14 sm:rounded-2xl" %>

                <div class="min-w-0 flex-1">
                  <div class="flex min-w-0 items-start justify-between gap-2">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-black text-rn-ink sm:text-base"><%= item.name %></p>
                      <p class="mt-0.5 truncate text-xs font-semibold text-rn-muted sm:text-sm"><%= item.model.presence || t(".unknown") %></p>
                    </div>
                    <span class="shrink-0 rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 text-[0.65rem] font-extrabold text-rn-muted sm:px-2.5 sm:py-1 sm:text-xs"><%= item.kind.humanize %></span>
                  </div>

                  <div class="mt-2 flex min-w-0 flex-wrap gap-1.5 text-[0.68rem] font-bold text-rn-muted sm:mt-3 sm:gap-2 sm:text-xs">
                    <span class="max-w-full truncate rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 sm:px-2.5 sm:py-1"><%= status_label %></span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <p class="rounded-2xl border border-rn-line bg-rn-surface p-4 text-sm font-semibold text-rn-muted"><%= t(".no_equipment") %></p>
        <% end %>
      </div>
    </section>

    <section data-testid="gear-tools-section" class="mt-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <h2 class="text-xl font-black text-rn-ink"><%= t(".tools") %></h2>
        <%= link_to t(".open_tools"), preparation_tools_path, class: "text-sm font-bold text-rn-muted hover:text-rn-ink" %>
      </div>

      <div class="grid max-w-full min-w-0 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <% if @preparation_tools.any? %>
          <% @preparation_tools.each do |tool| %>
            <%= link_to preparation_tool_path(tool), id: dom_id(tool, :gear), data: { testid: "gear-tool-card" }, class: "block max-w-full min-w-0 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface p-3 shadow-sm hover:bg-[var(--rn-surface-muted)] sm:p-4" do %>
              <div class="flex min-w-0 items-start gap-2.5 sm:gap-3">
                <%= render "shared/record_photo_thumb",
                  record: tool,
                  testid: "gear-tool-card-photo",
                  class_name: "h-12 w-12 shrink-0 rounded-xl object-contain ring-1 ring-stone-200 sm:h-14 sm:w-14 sm:rounded-2xl" %>

                <div class="min-w-0 flex-1">
                  <div class="flex min-w-0 items-start justify-between gap-2">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-black text-rn-ink sm:text-base"><%= tool.name %></p>
                      <p class="mt-0.5 truncate text-xs font-semibold text-rn-muted sm:text-sm"><%= tool.brew_method.humanize %></p>
                    </div>
                    <span class="shrink-0 rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 text-[0.65rem] font-extrabold text-rn-muted sm:px-2.5 sm:py-1 sm:text-xs"><%= tool.active? ? t(".active") : t(".inactive") %></span>
                  </div>

                  <div class="mt-2 flex min-w-0 flex-wrap gap-1.5 text-[0.68rem] font-bold text-rn-muted sm:mt-3 sm:gap-2 sm:text-xs">
                    <span class="max-w-full truncate rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 sm:px-2.5 sm:py-1"><%= t(".position", position: tool.position) %></span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <p class="rounded-2xl border border-rn-line bg-rn-surface p-4 text-sm font-semibold text-rn-muted"><%= t(".no_tools") %></p>
        <% end %>
      </div>
    </section>
  </section>
</main>
