<main class="rn-page">
  <section class="rn-shell max-w-4xl py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
    <div class="mt-5">
      <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow", default: "Espresso") %></p>
      <h1 class="mt-2 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
    </div>

    <%= render "form",
      brew: @brew,
      submit_label: t(".create"),
      autofocus_field: @autofocus_field,
      draft_storage_key: @draft_storage_key,
      hidden_brew_fields: @hidden_brew_fields %>
  </section>
</main>
