<main class="rn-page">
  <section class="rn-shell <%= @recipe ? "max-w-6xl" : "max-w-4xl" %> py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
    <div class="mt-5">
      <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.methods.#{@selected_method}") %></p>
      <h1 class="mt-2 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title_#{@selected_method}", default: t(".title")) %></h1>
    </div>

    <% if @repeat_source_brew.present? %>
      <section data-testid="repeat-brew-notice" class="mt-5 rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm">
        <p class="text-sm font-extrabold text-rn-ink"><%= t(".repeat_notice", bean: @repeat_source_brew.bean.display_name, date: profile_timestamp(@repeat_source_brew.occurred_at)) %></p>
        <% if @repeat_target_bean.present? && @repeat_target_bean != @repeat_source_brew.bean %>
          <p data-testid="repeat-brew-follow-up-bean" class="mt-1 text-sm font-semibold text-rn-muted"><%= t(".repeat_follow_up_bean", bean: @repeat_target_bean.display_name) %></p>
        <% end %>
      </section>
    <% end %>

    <div class="mt-6">
      <%= render "shared/log_tabs", active_tab: @selected_method %>
    </div>

    <% form_markup = capture do %>
      <%= render "form",
        brew: @brew,
        submit_label: t(".create"),
        autofocus_field: @autofocus_field,
        draft_storage_key: @draft_storage_key,
        hidden_brew_fields: @hidden_brew_fields %>
    <% end %>

    <% if @recipe %>
      <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
        <div class="grid gap-4 lg:order-2 lg:sticky lg:top-6">
          <%= render "recipes/target_guide", recipe: @recipe %>
          <%= render "recipes/finish_card", recipe: @recipe %>
        </div>
        <div class="min-w-0 lg:order-1">
          <%= form_markup %>
        </div>
      </div>
    <% else %>
      <%= form_markup %>
    <% end %>
  </section>
</main>
