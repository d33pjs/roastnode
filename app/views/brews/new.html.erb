<main class="rn-page">
  <section class="rn-shell <%= @recipe ? "max-w-6xl" : "max-w-4xl" %> py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
    <div class="mt-5">
      <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow", default: "Espresso") %></p>
      <h1 class="mt-2 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
    </div>

    <% form_markup = capture do %>
      <%= render "form",
        brew: @brew,
        submit_label: t(".create"),
        autofocus_field: @autofocus_field,
        draft_storage_key: @draft_storage_key,
        hidden_brew_fields: @hidden_brew_fields %>
    <% end %>

    <% if @recipe %>
      <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
        <div class="lg:order-2 lg:sticky lg:top-6">
          <%= render "recipes/target_guide", recipe: @recipe %>
        </div>
        <div class="min-w-0 lg:order-1">
          <%= form_markup %>
        </div>
      </div>
    <% else %>
      <%= form_markup %>
    <% end %>
  </section>
</main>
