<% autofocus_field = local_assigns.fetch(:autofocus_field, nil) %>
<% hidden_brew_fields = Array(local_assigns.fetch(:hidden_brew_fields, [])) %>
<% hide_brew_field = local_assigns.fetch(:hide_brew_field) %>
<% dose_sync_enabled = !hide_brew_field.call(:ground_weight_grams) && !hide_brew_field.call(:dose_grams) %>
<% machine_feature_gating = brew.new_record? %>
<% preinfusion_visible = brew.persisted? || brew.machine&.preinfusion_enabled? %>
<% low_flow_start_visible = brew.persisted? || brew.machine&.low_flow_start_enabled? %>
<% flow_control_visible = brew.persisted? || brew.machine&.flow_control_enabled? %>

<%= form.hidden_field :method, value: "espresso" %>

<%= render "brews/bean_selector", form:, grinder_reminder: @grinder_reminder %>

<section data-testid="brew-form-section" data-section="dose" class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
  <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.form.sections.dose") %></h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div>
      <%= form.label :bean_weight_grams, t("brews.form.bean_weight"), class: "block text-sm font-bold text-rn-muted" %>
      <%= form.text_field :bean_weight_grams, inputmode: "decimal", autofocus: autofocus_field == "bean_weight_grams", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
    </div>

    <% unless hide_brew_field.call(:ground_weight_grams) %>
      <div>
        <%= form.label :ground_weight_grams, t("brews.form.ground_weight"), class: "block text-sm font-bold text-rn-muted" %>
        <%= form.text_field :ground_weight_grams, inputmode: "decimal", autofocus: autofocus_field == "ground_weight_grams", data: (dose_sync_enabled ? { brew_dose_sync_target: "groundWeight", action: "input->brew-dose-sync#groundWeightChanged" } : {}), class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
      </div>
    <% end %>

    <% unless hide_brew_field.call(:dose_grams) %>
      <div>
        <%= form.label :dose_grams, t("brews.form.dose"), class: "block text-sm font-bold text-rn-muted" %>
        <%= form.text_field :dose_grams, inputmode: "decimal", autofocus: autofocus_field == "dose_grams", data: (dose_sync_enabled ? { brew_dose_sync_target: "dose", action: "input->brew-dose-sync#doseChanged" } : {}), class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
      </div>
    <% end %>

    <% unless hide_brew_field.call(:grind_setting) %>
      <div>
        <%= form.label :grind_setting, t("brews.form.grind_setting"), class: "block text-sm font-bold text-rn-muted" %>
        <%= form.text_field :grind_setting, autofocus: autofocus_field == "grind_setting", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
      </div>
    <% end %>
  </div>
</section>

<% extraction_fields = %w[preinfusion_seconds low_flow_start_seconds first_drip_seconds total_time_seconds beverage_grams channeling flow_control_used photos] %>
<% unless extraction_fields.all? { |field| hide_brew_field.call(field) } %>
  <section data-testid="brew-form-section" data-section="extraction" class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
    <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.form.sections.extraction") %></h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <% unless hide_brew_field.call(:preinfusion_seconds) %>
        <div
          data-brew-machine-features-target="feature"
          data-feature="preinfusion"
          <%= "hidden" unless preinfusion_visible %>
        >
          <%= form.label :preinfusion_seconds, t("brews.form.preinfusion"), class: "block text-sm font-bold text-rn-muted" %>
          <%= form.number_field :preinfusion_seconds, inputmode: "numeric", disabled: !preinfusion_visible, autofocus: autofocus_field == "preinfusion_seconds", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
        </div>
      <% end %>

      <% unless hide_brew_field.call(:low_flow_start_seconds) %>
        <div
          data-brew-machine-features-target="feature"
          data-feature="lowFlowStart"
          <%= "hidden" unless low_flow_start_visible %>
        >
          <%= form.label :low_flow_start_seconds, t("brews.form.low_flow_start"), class: "block text-sm font-bold text-rn-muted" %>
          <%= form.number_field :low_flow_start_seconds, inputmode: "numeric", disabled: !low_flow_start_visible, autofocus: autofocus_field == "low_flow_start_seconds", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
        </div>
      <% end %>

      <% unless hide_brew_field.call(:first_drip_seconds) %>
        <div>
          <%= form.label :first_drip_seconds, t("brews.form.first_drip"), class: "block text-sm font-bold text-rn-muted" %>
          <%= form.number_field :first_drip_seconds, inputmode: "numeric", autofocus: autofocus_field == "first_drip_seconds", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
        </div>
      <% end %>

      <% unless hide_brew_field.call(:total_time_seconds) %>
        <div>
          <%= form.label :total_time_seconds, t("brews.form.total_time"), class: "block text-sm font-bold text-rn-muted" %>
          <%= form.number_field :total_time_seconds, inputmode: "numeric", autofocus: autofocus_field == "total_time_seconds", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
        </div>
      <% end %>

      <% unless hide_brew_field.call(:beverage_grams) %>
        <div>
          <%= form.label :beverage_grams, t("brews.form.beverage"), class: "block text-sm font-bold text-rn-muted" %>
          <%= form.text_field :beverage_grams, inputmode: "decimal", autofocus: autofocus_field == "beverage_grams", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
        </div>
      <% end %>

      <% unless hide_brew_field.call(:channeling) %>
        <label class="flex min-h-14 items-center justify-between gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-sm font-extrabold text-rn-ink sm:col-span-2">
          <span><%= t("brews.form.channeling") %></span>
          <%= form.check_box :channeling, class: "h-5 w-5 rounded border-rn-line text-[var(--rn-accent-strong)]" %>
        </label>
      <% end %>

      <% unless hide_brew_field.call(:flow_control_used) %>
        <label
          data-brew-machine-features-target="feature"
          data-feature="flowControl"
          class="flex min-h-14 items-center justify-between gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-sm font-extrabold text-rn-ink sm:col-span-2"
          <%= "hidden" unless flow_control_visible %>
        >
          <span><%= t("brews.form.flow_control_used") %></span>
          <span>
            <%= form.hidden_field :flow_control_used, value: "0", id: nil, disabled: !flow_control_visible %>
            <%= form.check_box :flow_control_used,
              { include_hidden: false, disabled: !flow_control_visible, class: "h-5 w-5 rounded border-rn-line text-[var(--rn-accent-strong)]" },
              "1",
              "0" %>
          </span>
        </label>
      <% end %>

      <% unless hide_brew_field.call(:photos) %>
        <div class="sm:col-span-2">
          <%= form.label :photos, t("brews.form.photos"), class: "block text-sm font-bold text-rn-muted" %>
          <%= render "shared/photo_upload_input", form: %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section data-testid="brew-form-section" data-section="setup" class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
  <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.form.sections.setup") %></h2>

  <fieldset class="mt-3">
    <legend class="text-sm font-bold text-rn-muted"><%= t("brews.form.grinder") %></legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label for="brew_grinder_id_none" class="flex cursor-pointer items-center justify-between rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)]">
        <span><%= t("brews.form.none") %></span>
        <%= form.radio_button :grinder_id, "", id: "brew_grinder_id_none", class: "h-5 w-5 border-rn-line text-[var(--rn-accent-strong)]" %>
      </label>
      <% @grinders.each do |item| %>
        <label for="brew_grinder_id_<%= item.id %>" class="grid cursor-pointer grid-cols-[2.75rem_1fr_auto] items-center gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] p-3 hover:bg-[var(--rn-surface-muted)]">
          <%= render "shared/record_photo_thumb", record: item, testid: "brew-grinder-option-photo", class_name: "h-11 w-11 shrink-0 rounded-xl object-contain ring-1 ring-stone-200" %>
          <span class="truncate text-sm font-extrabold text-rn-ink"><%= item.name %></span>
          <%= form.radio_button :grinder_id, item.id, class: "h-5 w-5 border-rn-line text-[var(--rn-accent-strong)]" %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="mt-4">
    <legend class="text-sm font-bold text-rn-muted"><%= t("brews.form.machine") %></legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <label for="brew_machine_id_none" class="flex cursor-pointer items-center justify-between rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)]">
        <span><%= t("brews.form.none") %></span>
        <%= form.radio_button :machine_id,
          "",
          id: "brew_machine_id_none",
          data: {
            brew_machine_features_target: ("machine" if machine_feature_gating),
            action: ("change->brew-machine-features#machineChanged" if machine_feature_gating),
            preinfusion_enabled: false,
            low_flow_start_enabled: false,
            flow_control_enabled: false
          }.compact,
          class: "h-5 w-5 border-rn-line text-[var(--rn-accent-strong)]" %>
      </label>
      <% @machines.each do |item| %>
        <label for="brew_machine_id_<%= item.id %>" class="grid cursor-pointer grid-cols-[2.75rem_1fr_auto] items-center gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] p-3 hover:bg-[var(--rn-surface-muted)]">
          <%= render "shared/record_photo_thumb", record: item, testid: "brew-machine-option-photo", class_name: "h-11 w-11 shrink-0 rounded-xl object-contain ring-1 ring-stone-200" %>
          <span class="truncate text-sm font-extrabold text-rn-ink"><%= item.name %></span>
          <%= form.radio_button :machine_id,
            item.id,
            data: {
              brew_machine_features_target: ("machine" if machine_feature_gating),
              action: ("change->brew-machine-features#machineChanged" if machine_feature_gating),
              preinfusion_enabled: item.preinfusion_enabled?,
              low_flow_start_enabled: item.low_flow_start_enabled?,
              flow_control_enabled: item.flow_control_enabled?
            }.compact,
            class: "h-5 w-5 border-rn-line text-[var(--rn-accent-strong)]" %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <% unless hide_brew_field.call(:brew_temperature_celsius) %>
    <div class="mt-4">
      <%= form.label :brew_temperature_celsius, t("brews.form.temperature"), class: "block text-sm font-bold text-rn-muted" %>
      <%= form.text_field :brew_temperature_celsius, inputmode: "decimal", autofocus: autofocus_field == "brew_temperature_celsius", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
    </div>
  <% end %>

  <fieldset class="mt-4">
    <legend class="text-sm font-bold text-rn-muted"><%= t("brews.form.preparation_tools") %></legend>
    <% if @preparation_tools.any? %>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <% @preparation_tools.each do |tool| %>
          <label for="<%= dom_id(tool, :brew) %>" class="grid cursor-pointer grid-cols-[2.5rem_1fr_auto] items-center gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] p-3 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)]">
            <%= render "shared/record_photo_thumb", record: tool, testid: "brew-tool-option-photo", class_name: "h-10 w-10 shrink-0 rounded-xl object-contain ring-1 ring-stone-200" %>
            <span class="truncate"><%= tool.name %></span>
            <%= check_box_tag "brew[preparation_tool_ids][]", tool.id, @selected_preparation_tools.include?(tool), id: dom_id(tool, :brew), class: "h-5 w-5 rounded border-rn-line text-[var(--rn-accent-strong)]" %>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-rn-muted"><%= t("brews.form.no_preparation_tools") %></p>
    <% end %>
  </fieldset>
</section>

<% taste_fields = %w[taste_balance rating] %>
<% unless taste_fields.all? { |field| hide_brew_field.call(field) } %>
  <section data-testid="brew-form-section" data-section="taste" class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
    <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.form.sections.taste") %></h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <% unless hide_brew_field.call(:taste_balance) %>
        <div class="sm:col-span-2">
          <%= form.label :taste_balance, t("brews.form.taste"), class: "block text-sm font-bold text-rn-muted" %>
          <%= render "brews/taste_balance_choices", form: form, method: "espresso" %>
        </div>
      <% end %>

      <% unless hide_brew_field.call(:rating) %>
        <div>
          <%= form.label :rating, t("brews.form.rating"), class: "block text-sm font-bold text-rn-muted" %>
          <%= render "brews/rating_choices", form: form %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<%= render "brews/serving_form_fields", form:, brew: form.object %>

<% unless hide_brew_field.call(:notes) %>
  <section data-testid="brew-form-section" data-section="notes" class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
    <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.form.sections.notes") %></h2>
    <div class="mt-3">
      <%= form.label :notes, t("brews.form.notes"), class: "block text-sm font-bold text-rn-muted" %>
      <%= form.text_area :notes, rows: 4, autofocus: autofocus_field == "notes", class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
    </div>
  </section>
<% end %>

<section data-testid="brew-form-section" data-section="public-note" class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
  <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t("brews.form.sections.public_sharing") %></h2>
  <div class="mt-3">
    <%= form.label :public_note, t("brews.form.public_note"), class: "block text-sm font-bold text-rn-muted" %>
    <%= form.text_area :public_note, rows: 4, class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
  </div>
</section>

<%= render "shared/record_links_fields",
  form:,
  record: brew,
  section_class: "grid gap-4 rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5",
  section_title_class: "text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted",
  label_class: "block text-sm font-bold text-rn-muted",
  input_class: "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
