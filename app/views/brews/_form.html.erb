<% autofocus_field = local_assigns.fetch(:autofocus_field, nil) %>
<% draft_storage_key = local_assigns.fetch(:draft_storage_key, nil) %>
<% hidden_brew_fields = Array(local_assigns.fetch(:hidden_brew_fields, [])) %>
<% hide_brew_field = ->(field) { hidden_brew_fields.include?(field.to_s) } %>
<% form_data = {} %>
<% if draft_storage_key.present? %>
  <% form_data[:controller] = "brew-draft" %>
  <% form_data[:brew_draft_storage_key_value] = draft_storage_key %>
<% end %>
<% dose_sync_enabled = brew.espresso? && !hide_brew_field.call(:ground_weight_grams) && !hide_brew_field.call(:dose_grams) %>
<% if dose_sync_enabled %>
  <% form_data[:controller] = [form_data[:controller], "brew-dose-sync"].compact.join(" ") %>
<% end %>
<% if brew.espresso? && brew.new_record? %>
  <% form_data[:controller] = [form_data[:controller], "brew-machine-features"].compact.join(" ") %>
<% end %>

<%= form_with model: brew, class: "mt-8 grid gap-5", data: form_data do |form| %>
  <% if brew.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800">
      <%= brew.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% if brew.recipe_id.present? %>
    <%= form.hidden_field :recipe_id, value: brew.recipe_id %>
  <% end %>

  <% if draft_storage_key.present? %>
    <div data-brew-draft-target="notice" class="hidden rounded-2xl border border-amber-500/40 bg-amber-500/10 p-3 text-sm text-rn-ink">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p><%= t("brews.form.draft_restored") %></p>
        <button type="button" data-action="brew-draft#discard" class="rounded-full border border-rn-line bg-rn-surface px-3 py-1.5 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)]">
          <%= t("brews.form.discard_draft") %>
        </button>
      </div>
    </div>
  <% end %>

  <% if brew.quick_drip? %>
    <%= render "brews/quick_drip_form_fields", form:, brew: %>
  <% else %>
    <%= render "brews/espresso_form_fields",
      form:,
      brew:,
      autofocus_field:,
      hidden_brew_fields:,
      hide_brew_field: %>
  <% end %>

  <%= render "brews/occurred_at_field", form: %>

  <%= form.submit submit_label, class: "rounded-2xl bg-[var(--rn-coffee)] px-5 py-3 text-sm font-extrabold text-[#fff8e8] shadow-lg hover:opacity-90" %>
<% end %>
