<main class="min-h-screen bg-stone-50">
  <%= render "brews/hero_card_styles" %>

  <section class="mx-auto max-w-5xl px-6 py-10">
    <div data-testid="brew-detail-header-controls" class="flex items-center justify-between gap-3">
      <%= render "shared/back_link", label: t(".back"), path: dashboard_path, prefer_referrer: false %>

      <% if current_workspace_policy.write? %>
        <% brew_actions = [] %>
        <% if @brew.espresso? && @brew.public_brew_share&.enabled? %>
          <% public_share_title = @brew.public_brew_share.title.presence || PublicBrewShare.default_title_for(@brew) %>
          <% brew_actions << {
            kind: :native_share,
            icon: "ios_share",
            label: t("shared.native_share.share_public_brew"),
            url: public_brew_page_url(@brew.public_brew_share.token),
            title: public_share_title,
            text: t("brews.native_share.text", title: public_share_title),
            testid: "brew-native-share-button-#{@brew.id}"
          } %>
        <% end %>
        <% if @brew.espresso? && (current_workspace_policy.manage? || @brew.user_id == Current.user.id) %>
          <% share_path = @brew.public_brew_share ? edit_brew_public_brew_share_path(@brew) : new_brew_public_brew_share_path(@brew) %>
          <% brew_actions << {
            icon: "public",
            label: t(".share_publicly"),
            path: share_path,
            testid: "brew-share-public-link-#{@brew.id}"
          } %>
        <% end %>
        <% if @brew.espresso? %>
          <% brew_actions << {
            icon: "bookmark_add",
            label: t(".save_as_recipe"),
            path: new_recipe_path(source_brew_id: @brew.id),
            testid: "brew-save-recipe-link-#{@brew.id}"
          } %>
        <% end %>
        <% brew_actions << {
          icon: "restart_alt",
          label: t(".repeat"),
          path: new_brew_path(repeat_brew_id: @brew.id),
          testid: "brew-repeat-link-#{@brew.id}"
        } %>
        <% brew_actions << {
          icon: "edit",
          label: t(".edit"),
          path: edit_brew_path(@brew),
          primary: true,
          testid: "brew-edit-link-#{@brew.id}"
        } %>
        <%= render "shared/detail_actions", testid: "brew-detail-actions", actions: brew_actions %>
      <% end %>
    </div>

    <div class="mt-6">
      <p data-testid="brew-detail-screen-label" class="text-xs font-black uppercase tracking-[0.12em] text-rn-muted"><%= t(".detail_screen_label") %></p>
      <h1 class="mt-1 text-2xl font-black text-rn-ink sm:text-3xl"><%= t(".saved_brew") %></h1>
    </div>

    <%= render "brews/hero_card", brew: @brew, card_class: "mt-5" %>

    <% if current_workspace_policy.write? %>
      <% correction_label_class = "block text-sm font-bold text-rn-muted" %>
      <% correction_input_class = "mt-1 w-full rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
      <section data-testid="brew-serving-correction" class="mt-6 rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
        <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".serving") %></h2>
        <%= form_with model: @brew, url: serving_brew_path(@brew), method: :patch, class: "mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %>
          <% if @brew.errors.any? %>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-3 text-sm font-semibold text-red-800 sm:col-span-3">
              <%= @brew.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <label class="flex min-h-12 items-center justify-between gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-sm font-extrabold text-rn-ink">
            <span><%= t(".served_for_guest") %></span>
            <%= form.check_box :served_for_guest, class: "h-5 w-5 rounded border-rn-line text-[var(--rn-accent-strong)]" %>
          </label>

          <div>
            <%= form.label :guest_name, t(".guest_name"), class: correction_label_class %>
            <%= form.text_field :guest_name, maxlength: 120, list: "brew_guest_name_suggestions", class: correction_input_class %>
            <datalist id="brew_guest_name_suggestions">
              <% Array(@guest_name_suggestions).each do |suggestion| %>
                <option value="<%= suggestion %>"></option>
              <% end %>
            </datalist>
          </div>

          <div class="sm:col-span-2">
            <%= form.label :cup_style, t(".cup_style"), class: correction_label_class %>
            <%= form.text_field :cup_style, maxlength: 120, list: "brew_cup_style_suggestions", class: correction_input_class %>
            <datalist id="brew_cup_style_suggestions">
              <% Array(@cup_style_suggestions).each do |suggestion| %>
                <option value="<%= suggestion %>"></option>
              <% end %>
            </datalist>
          </div>

          <%= form.submit t(".save_serving"), class: "rounded-2xl bg-[var(--rn-coffee)] px-5 py-3 text-sm font-extrabold text-[#fff8e8] shadow-lg hover:opacity-90" %>
        <% end %>
      </section>

      <section data-testid="brew-taste-correction" class="mt-6 rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
        <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".adjust_taste") %></h2>
        <%= form_with model: @brew, url: taste_brew_path(@brew), method: :patch, class: "mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %>
          <% if @brew.errors.any? %>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-3 text-sm font-semibold text-red-800 sm:col-span-3">
              <%= @brew.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <div class="sm:col-span-3">
            <%= form.label :taste_balance, t(".taste"), class: correction_label_class %>
            <%= render "brews/taste_balance_choices", form: form, method: @brew.method %>
          </div>

          <div>
            <%= form.label :rating, t(".rating"), class: correction_label_class %>
            <%= render "brews/rating_choices", form: form %>
          </div>

          <%= form.submit t(".save_taste"), class: "rounded-2xl bg-[var(--rn-coffee)] px-5 py-3 text-sm font-extrabold text-[#fff8e8] shadow-lg hover:opacity-90" %>
        <% end %>
      </section>
    <% end %>

    <section data-testid="brew-log-details" class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".details") %></h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".logged_at") %></dt>
          <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_timestamp(@brew) %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".logged_by") %></dt>
          <dd class="mt-1 text-sm font-semibold text-stone-950"><%= @brew.user.display_label %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".bean") %></dt>
          <dd data-testid="brew-detail-bean" class="mt-1 text-sm font-semibold text-stone-950">
            <%= link_to @brew.bean.display_name, bean_path(@brew.bean), class: "text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-950" %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".cup_style") %></dt>
          <dd data-testid="brew-detail-cup" class="mt-1 text-sm font-semibold text-stone-950"><%= @brew.cup_style.presence || t(".unknown") %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".guest") %></dt>
          <dd data-testid="brew-detail-guest" class="mt-1 text-sm font-semibold text-stone-950">
            <% if @brew.served_for_guest? %>
              <%= @brew.guest_name.presence || t(".yes") %>
            <% else %>
              <%= t(".no") %>
            <% end %>
          </dd>
        </div>
        <% if @brew.quick_drip? %>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".brewer") %></dt>
            <dd data-testid="brew-detail-brewer" class="mt-1 text-sm font-semibold text-stone-950">
              <% if @brew.brewer.present? %>
                <%= link_to @brew.brewer.name, equipment_path(@brew.brewer), class: "text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-950" %>
              <% else %>
                <%= t(".unknown") %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".machine_cups") %></dt>
            <dd data-testid="brew-detail-machine-cups" class="mt-1 text-sm font-semibold text-stone-950">
              <%= @brew.machine_cups.present? ? profile_number(@brew.machine_cups, precision: 2) : t(".unknown") %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".coffee_amount") %></dt>
            <dd data-testid="brew-detail-estimate" class="mt-1 text-sm font-semibold text-stone-950"><%= quick_drip_estimate_calculation(@brew) || quick_drip_consumed_grams(@brew) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".yield") %></dt>
            <dd data-testid="brew-detail-beverage" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_grams(@brew.beverage_grams) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".total_time") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_seconds(@brew.total_time_seconds) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".grind_setting") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= @brew.grind_setting.presence || t(".unknown") %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".grinder") %></dt>
            <dd data-testid="brew-detail-grinder" class="mt-1 text-sm font-semibold text-stone-950">
              <% if @brew.grinder.present? %>
                <%= link_to @brew.grinder.name, equipment_path(@brew.grinder), class: "text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-950" %>
              <% else %>
                <%= t(".unknown") %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".rating") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_rating_label(@brew.rating) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".taste") %></dt>
            <dd data-testid="brew-detail-taste" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_taste_label(@brew.taste_balance, method: @brew.method) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".tools") %></dt>
            <dd data-testid="brew-detail-tools" class="mt-1 flex flex-wrap gap-1.5 text-sm font-semibold text-stone-950">
              <% if brew_card_tools(@brew).any? %>
                <% brew_card_tools(@brew).each do |tool| %>
                  <%= link_to tool.tool_name, brew_card_tool_path(tool), data: { testid: "brew-detail-tool" }, class: "rounded-full bg-stone-100 px-2.5 py-1 text-stone-800 hover:bg-stone-200" %>
                <% end %>
              <% else %>
                <%= t(".no_preparation_tools") %>
              <% end %>
            </dd>
          </div>
        <% else %>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".bean_weight") %></dt>
            <dd data-testid="brew-detail-bean-weight" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_grams(@brew.bean_weight_grams) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".ground_weight") %></dt>
            <dd data-testid="brew-detail-ground-weight" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_grams(@brew.ground_weight_grams) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".dose") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_grams(@brew.dose_grams) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".yield") %></dt>
            <dd data-testid="brew-detail-beverage" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_grams(@brew.beverage_grams) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".ratio") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_ratio(@brew) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".grind_setting") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= @brew.grind_setting.presence || t(".unknown") %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".temperature") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_temperature(@brew.brew_temperature_celsius) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".preinfusion") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_seconds(@brew.preinfusion_seconds) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".low_flow_start") %></dt>
            <dd data-testid="brew-detail-low-flow-start" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_seconds(@brew.low_flow_start_seconds) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".first_drip") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_seconds(@brew.first_drip_seconds) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".total_time") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_seconds(@brew.total_time_seconds) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".rating") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_rating_label(@brew.rating) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".taste") %></dt>
            <dd data-testid="brew-detail-taste" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_taste_label(@brew.taste_balance, method: @brew.method) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".channeling") %></dt>
            <dd data-testid="brew-detail-channeling" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_boolean(@brew.channeling) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".flow_control_used") %></dt>
            <dd data-testid="brew-detail-flow-control-used" class="mt-1 text-sm font-semibold text-stone-950"><%= brew_card_boolean(@brew.flow_control_used) %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".retention") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= @brew.retention_marker.humanize %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".grinder") %></dt>
            <dd data-testid="brew-detail-grinder" class="mt-1 text-sm font-semibold text-stone-950">
              <% if @brew.grinder.present? %>
                <%= link_to @brew.grinder.name, equipment_path(@brew.grinder), class: "text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-950" %>
              <% else %>
                <%= t(".unknown") %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".machine") %></dt>
            <dd data-testid="brew-detail-machine" class="mt-1 text-sm font-semibold text-stone-950">
              <% if @brew.machine.present? %>
                <%= link_to @brew.machine.name, equipment_path(@brew.machine), class: "text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-950" %>
              <% else %>
                <%= t(".unknown") %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".tools") %></dt>
            <dd data-testid="brew-detail-tools" class="mt-1 flex flex-wrap gap-1.5 text-sm font-semibold text-stone-950">
              <% if brew_card_tools(@brew).any? %>
                <% brew_card_tools(@brew).each do |tool| %>
                  <%= link_to tool.tool_name, brew_card_tool_path(tool), data: { testid: "brew-detail-tool" }, class: "rounded-full bg-stone-100 px-2.5 py-1 text-stone-800 hover:bg-stone-200" %>
                <% end %>
              <% else %>
                <%= t(".no_preparation_tools") %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <div class="mt-5 border-t border-stone-100 pt-4">
        <h3 class="text-xs font-bold uppercase text-stone-500"><%= t(".notes") %></h3>
        <p data-testid="brew-detail-notes" class="mt-2 whitespace-pre-line text-sm text-stone-700"><%= @brew.notes.presence || t(".no_notes") %></p>
      </div>
    </section>

    <%= render "shared/photo_grid",
      record: @brew,
      title: t(".photos"),
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>

    <% related_photo_groups = brew_related_photo_groups(@brew) %>
    <% if related_photo_groups.any? %>
      <section data-testid="brew-related-photos" class="mt-6 rounded-lg border border-stone-200 bg-stone-100 p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-stone-950"><%= t(".related_photos") %></h2>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <% related_photo_groups.each do |group| %>
            <%= render "shared/related_photo_group", **group %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if current_workspace_policy.write? %>
      <section data-testid="brew-danger-zone" class="mt-6 rounded-lg border border-red-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-red-800"><%= t(".danger_zone") %></h2>
        <p class="mt-2 text-sm text-stone-700"><%= t(".danger_zone_body") %></p>
        <%= button_to t(".delete"),
          brew_path(@brew),
          method: :delete,
          form: { data: { turbo_confirm: t(".delete_confirmation") } },
          class: "mt-4 rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
      </section>
    <% end %>
  </section>
</main>
