<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <%= link_to t(".back"), root_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>

    <header class="mt-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase text-stone-600"><%= l(@brew.occurred_at, format: :short) %></p>
      <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= t(".title", bean: @brew.bean.display_name) %></h1>
      <p class="mt-3 text-stone-700"><%= t(".byline", user: @brew.user.email_address) %></p>
    </header>

    <div class="mt-6 grid gap-4 sm:grid-cols-4">
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".dose") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= number_with_precision(@brew.bean_weight_grams, precision: 1, strip_insignificant_zeros: true) %> g</p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".yield") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= @brew.beverage_grams ? "#{number_with_precision(@brew.beverage_grams, precision: 1, strip_insignificant_zeros: true)} g" : t(".unknown") %></p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".time") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= @brew.total_time_seconds ? "#{@brew.total_time_seconds}s" : t(".unknown") %></p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".rating") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= @brew.rating || t(".unknown") %></p>
      </section>
    </div>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".details") %></h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-stone-600"><%= t(".grinder") %></dt>
          <dd class="mt-1 text-stone-950"><%= @brew.grinder&.name || t(".unknown") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-stone-600"><%= t(".machine") %></dt>
          <dd class="mt-1 text-stone-950"><%= @brew.machine&.name || t(".unknown") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-stone-600"><%= t(".taste") %></dt>
          <dd class="mt-1 text-stone-950"><%= @brew.taste_balance.humanize %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-stone-600"><%= t(".retention") %></dt>
          <dd class="mt-1 text-stone-950"><%= @brew.retention_marker.humanize %></dd>
        </div>
      </dl>
    </section>

    <% if @brew.notes.present? %>
      <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-stone-950"><%= t(".notes") %></h2>
        <p class="mt-2 whitespace-pre-line text-stone-700"><%= @brew.notes %></p>
      </section>
    <% end %>
  </section>
</main>
