<main class="min-h-screen bg-stone-50">
  <style>
    .brew-rating-bean {
      display: inline-block;
      width: .72rem;
      height: 1rem;
      border-radius: 60% 45% 60% 45%;
      transform: rotate(24deg);
    }

    .brew-chart-grid {
      background-image: radial-gradient(circle, #d6d3d1 1.2px, transparent 1.2px);
      background-size: 26px 26px;
    }
  </style>

  <section class="mx-auto max-w-5xl px-6 py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <%= link_to t(".back"), root_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>

      <% if current_workspace_policy.write? %>
        <div class="flex flex-wrap gap-2">
          <%= link_to t(".edit"), edit_brew_path(@brew), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
          <%= button_to t(".delete"), brew_path(@brew), method: :delete, class: "rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
        </div>
      <% end %>
    </div>

    <article data-testid="brew-hero-card" class="mt-5 overflow-hidden rounded-lg bg-stone-950 text-stone-50 shadow-sm">
      <div class="bg-stone-950 p-5">
        <div class="flex flex-wrap items-center gap-2">
          <span data-testid="brew-timestamp" class="rounded-full border border-white/20 px-3 py-1 text-xs font-bold text-stone-200"><%= brew_card_timestamp(@brew) %></span>
          <span data-testid="brew-workspace" class="rounded-full border border-white/20 px-3 py-1 text-xs font-bold text-stone-200"><%= current_workspace.name %></span>
          <span class="rounded-full border border-white/20 px-3 py-1 text-xs font-bold text-stone-200"><%= t(".card_method") %></span>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
          <div>
            <p class="text-xs font-bold uppercase text-stone-300"><%= @brew.bean.roaster_name.presence || t(".unknown") %></p>
            <h1 class="mt-1 text-3xl font-bold leading-8 text-white"><%= @brew.bean.name %></h1>
            <% if brew_card_bean_descriptor(@brew.bean).present? %>
              <p class="mt-2 text-sm text-stone-300"><%= brew_card_bean_descriptor(@brew.bean) %></p>
            <% end %>
            <p class="mt-2 text-xs text-stone-400"><%= t(".byline", user: @brew.user.email_address) %></p>
          </div>

          <div class="grid gap-2 sm:grid-cols-4">
            <div class="rounded-md bg-white/10 p-3">
              <p class="text-xs font-bold uppercase text-stone-300"><%= t(".dose") %></p>
              <p data-testid="brew-dose" class="mt-1 text-lg font-bold text-white"><%= brew_card_grams(@brew.dose_grams) %></p>
            </div>
            <div class="rounded-md bg-white/10 p-3">
              <p class="text-xs font-bold uppercase text-stone-300"><%= t(".yield") %></p>
              <p data-testid="brew-beverage" class="mt-1 text-lg font-bold text-white"><%= brew_card_grams(@brew.beverage_grams) %></p>
            </div>
            <div class="rounded-md bg-white/10 p-3">
              <p class="text-xs font-bold uppercase text-stone-300"><%= t(".grind_setting") %></p>
              <p data-testid="brew-grind" class="mt-1 text-lg font-bold text-white"><%= @brew.grind_setting.presence || t(".unknown") %></p>
            </div>
            <div class="rounded-md bg-white/10 p-3">
              <p class="text-xs font-bold uppercase text-stone-300"><%= t(".rating") %></p>
              <div data-testid="brew-rating" aria-label="<%= brew_card_rating_label(@brew.rating) %>" class="mt-2 flex gap-1">
                <% 5.times do |index| %>
                  <% filled = @brew.rating.present? && index < @brew.rating %>
                  <span class="brew-rating-bean <%= filled ? "rating-bean--filled bg-amber-500 shadow-sm" : "rating-bean--empty border border-stone-400" %>"></span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="brew-chart-grid bg-stone-50 px-4 py-3 text-stone-950">
        <div class="flex justify-end">
          <span data-testid="brew-balance" class="rounded-full bg-green-50 px-3 py-1 text-xs font-bold text-green-700"><%= t(".balance", balance: @brew.taste_balance.humanize) %></span>
        </div>

        <svg class="mt-1 block h-44 w-full" viewBox="0 0 720 190" role="img" aria-label="<%= t(".yield") %>">
          <defs>
            <linearGradient id="brew-shot-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#0f172a" stop-opacity=".16" />
              <stop offset="100%" stop-color="#0f172a" stop-opacity="0" />
            </linearGradient>
          </defs>

          <line x1="62" y1="150" x2="662" y2="150" stroke="#1c1917" stroke-width="2" />
          <line x1="62" y1="26" x2="62" y2="150" stroke="#1c1917" stroke-width="2" />

          <path d="M62 150 C116 152, 176 152, 216 148 C244 144, 264 124, 292 99 C334 63, 396 44, 464 34 C516 26, 580 25, 626 38" fill="none" stroke="#0f172a" stroke-width="5" stroke-linecap="round" />
          <path d="M62 150 C116 152, 176 152, 216 148 C244 144, 264 124, 292 99 C334 63, 396 44, 464 34 C516 26, 580 25, 626 38 L626 150 L62 150 Z" fill="url(#brew-shot-fill)" />

          <path d="M62 13 C170 12, 260 11, 368 11 C480 10, 568 12, 626 17" fill="none" stroke="#a16207" stroke-width="3" stroke-linecap="round" />

          <line x1="216" y1="24" x2="216" y2="160" stroke="#78716c" stroke-width="2" stroke-dasharray="6 8" />
          <line x1="626" y1="24" x2="626" y2="160" stroke="#78716c" stroke-width="2" stroke-dasharray="6 8" />
          <line x1="62" y1="38" x2="48" y2="38" stroke="#78716c" stroke-width="2" />

          <text x="24" y="155" font-size="12" fill="#57534e">0g</text>
          <text x="18" y="42" font-size="12" fill="#57534e"><%= brew_card_grams(@brew.beverage_grams) %></text>
          <text x="50" y="176" font-size="12" fill="#57534e">0s</text>
          <text data-testid="brew-preinfusion-label" x="176" y="176" font-size="12" fill="#57534e"><%= brew_card_seconds(@brew.preinfusion_seconds) %> Preinfusion</text>
          <text data-testid="brew-total-time-label" x="607" y="176" font-size="12" fill="#57534e"><%= brew_card_seconds(@brew.total_time_seconds) %></text>
          <text data-testid="brew-temperature-label" x="548" y="12" font-size="13" font-weight="800" fill="#a16207"><%= t(".temperature_label", temperature: brew_card_temperature(@brew.brew_temperature_celsius)) %></text>
          <text x="474" y="58" font-size="13" font-weight="800" fill="#0f172a"><%= brew_card_grams(@brew.beverage_grams) %></text>
        </svg>
      </div>

      <div class="bg-stone-900 px-5 py-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold text-stone-100"><%= t(".grinder") %>: <%= @brew.grinder&.name || t(".unknown") %></span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold text-stone-100"><%= t(".machine") %>: <%= @brew.machine&.name || t(".unknown") %></span>
          <% brew_card_tool_names(@brew).each do |tool_name| %>
            <span data-testid="brew-tool" class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-stone-200"><%= tool_name %></span>
          <% end %>
        </div>
      </div>
    </article>

    <%= render "shared/photo_grid",
      record: @brew,
      title: t(".photos"),
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>

    <% if @brew.notes.present? %>
      <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-stone-950"><%= t(".notes") %></h2>
        <p class="mt-2 whitespace-pre-line text-stone-700"><%= @brew.notes %></p>
      </section>
    <% end %>
  </section>
</main>
