<div data-testid="brew-taste-balance-options" class="rn-choice-grid mt-2">
  <% Brew.taste_balances.keys.each do |balance| %>
    <label class="rn-choice">
      <%= form.radio_button :taste_balance, balance, class: "rn-choice-input" %>
      <span class="rn-choice-label"><%= balance.humanize %></span>
    </label>
  <% end %>
</div>
