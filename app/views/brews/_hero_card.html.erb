<% card_class = local_assigns.fetch(:card_class, "") %>
<% compact = local_assigns.fetch(:compact, false) %>
<% chart_id = local_assigns.fetch(:chart_id, "brew-shot-fill-#{brew.id}") %>

<% if brew.quick_drip? %>
  <%= render "brews/quick_drip_hero_card", brew:, card_class:, compact:, chart_id: %>
<% else %>
  <%= render "brews/espresso_hero_card", brew:, card_class:, compact:, chart_id: %>
<% end %>
