<% card_class = local_assigns.fetch(:card_class, "") %>
<% compact = local_assigns.fetch(:compact, false) %>
<% chart_id = local_assigns.fetch(:chart_id, "brew-shot-fill-#{brew.id}") %>
<% brew_photo = brew_card_photo_attachment(brew) %>
<% grinder_photo = brew.grinder&.primary_photo_attachment %>
<% machine_photo = brew.machine&.primary_photo_attachment %>
<% user_avatar = brew.user.avatar.attachment if brew.user.avatar.attached? %>
<% workspace_logo = current_workspace.logo.attachment if current_workspace.logo.attached? %>

<article data-testid="brew-hero-card" class="relative overflow-hidden rounded-lg bg-stone-950 text-stone-50 shadow-sm <%= card_class %>">
  <div class="bg-stone-950 p-5">
    <div data-testid="brew-card-header" class="flex flex-nowrap items-center gap-1 overflow-hidden sm:gap-2">
      <span data-testid="brew-timestamp" class="shrink-0 whitespace-nowrap rounded-full border border-white/20 px-1.5 py-0.5 text-[0.58rem] font-bold text-stone-200 sm:px-3 sm:py-1 sm:text-xs"><%= brew_card_timestamp(brew) %></span>
      <span data-testid="brew-workspace" class="inline-flex min-w-0 max-w-[7.5rem] items-center gap-1 truncate whitespace-nowrap rounded-full border border-white/20 px-1.5 py-0.5 text-[0.58rem] font-bold text-stone-200 sm:max-w-none sm:gap-1.5 sm:px-3 sm:py-1 sm:text-xs">
        <% if workspace_logo.present? %>
          <%= image_tag media_attachment_path(workspace_logo), alt: "", data: { testid: "brew-workspace-logo" }, class: "h-3 w-3 shrink-0 rounded-full object-cover ring-1 ring-white/20 sm:h-4 sm:w-4" %>
        <% end %>
        <span class="min-w-0 truncate"><%= current_workspace.name %></span>
      </span>
      <span class="shrink-0 whitespace-nowrap rounded-full border border-white/20 px-1.5 py-0.5 text-[0.58rem] font-bold text-stone-200 sm:px-3 sm:py-1 sm:text-xs"><%= t("brews.show.card_method") %></span>
      <%= render "shared/brand_mark",
        testid: "brew-card-brand-mark",
        container_class: "ml-auto h-7 w-7 shrink-0 sm:h-12 sm:w-12",
        image_class: "h-full w-full object-contain drop-shadow-sm" %>
    </div>

    <div class="mt-4 grid gap-4 <%= "lg:grid-cols-[0.9fr_1.1fr] lg:items-end" unless compact %>">
      <div class="flex items-start justify-between gap-3">
        <div data-testid="brew-title-block" class="min-w-0">
          <p class="text-xs font-bold uppercase text-stone-300"><%= brew.bean.roaster_name.presence || t("brews.show.unknown") %></p>
          <h1 class="mt-1 text-3xl font-bold leading-8 text-white"><%= brew.bean.name %></h1>
          <% if brew_card_bean_descriptor(brew.bean).present? %>
            <p class="mt-2 text-sm text-stone-300"><%= brew_card_bean_descriptor(brew.bean) %></p>
          <% end %>
          <div data-testid="brew-byline" class="mt-2 flex items-center gap-1.5 text-xs text-stone-400">
            <% if user_avatar.present? %>
              <%= image_tag media_attachment_path(user_avatar), alt: "", data: { testid: "brew-user-avatar" }, class: "h-5 w-5 shrink-0 rounded-full object-cover ring-1 ring-white/20" %>
            <% end %>
            <span><%= t("brews.show.byline", user: brew.user.display_label) %></span>
          </div>
        </div>

        <% if brew_photo.present? %>
          <div data-testid="brew-bean-photo-frame" class="h-14 w-12 shrink-0 overflow-hidden rounded-md border border-white/10 bg-white/10 sm:h-16 sm:w-14">
            <%= image_tag media_attachment_path(brew_photo), alt: brew.bean.name, data: { testid: "brew-bean-photo" }, class: "h-full w-full object-cover" %>
          </div>
        <% end %>
      </div>

      <div data-testid="brew-metrics" class="grid grid-cols-3 gap-1 sm:grid-cols-6 sm:gap-2">
        <div class="min-w-0 rounded-md bg-white/10 p-2 sm:p-3">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.dose") %></p>
          <p data-testid="brew-dose" class="brew-metric-value mt-1 overflow-hidden text-ellipsis font-bold text-white"><%= brew_card_grams(brew.dose_grams) %></p>
        </div>
        <div class="min-w-0 rounded-md bg-white/10 p-2 sm:p-3">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.ratio") %></p>
          <div data-testid="brew-ratio" class="mt-1 overflow-hidden">
            <p data-testid="brew-ratio-main" class="brew-metric-value overflow-hidden text-ellipsis font-bold text-white"><%= brew_card_ratio_value(brew) %></p>
            <% if brew_card_ratio_time(brew).present? %>
              <p data-testid="brew-ratio-time" class="brew-metric-subvalue mt-0.5 overflow-hidden text-ellipsis font-semibold text-stone-300"><%= brew_card_ratio_time(brew) %></p>
            <% end %>
          </div>
        </div>
        <div class="min-w-0 rounded-md bg-white/10 p-2 sm:p-3">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.grind_setting") %></p>
          <p data-testid="brew-grind" class="brew-metric-value mt-1 overflow-hidden text-ellipsis font-bold text-white"><%= brew.grind_setting.presence || t("brews.show.unknown") %></p>
        </div>
        <div data-testid="brew-retention-card" class="min-w-0 rounded-md bg-white/10 p-2 sm:p-3">
          <p data-testid="brew-retention-label" class="text-[0.62rem] font-bold uppercase leading-tight text-stone-300 sm:text-xs"><span class="sm:hidden">Ret.</span><span class="hidden sm:inline"><%= t("brews.show.retention") %></span></p>
          <p data-testid="brew-retention" class="brew-metric-value mt-1 overflow-hidden text-ellipsis font-bold text-white"><%= brew_card_retention_grams(brew) %></p>
        </div>
        <div data-testid="brew-rating-card" class="min-w-0 rounded-md bg-white/10 p-2 sm:p-3">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.rating") %></p>
          <div data-testid="brew-rating" aria-label="<%= brew_card_rating_label(brew.rating) %>" class="mt-1 flex gap-0.5 sm:gap-1">
            <% 5.times do |index| %>
              <% filled = brew.rating.present? && index < brew.rating %>
              <span class="brew-rating-bean <%= filled ? "rating-bean--filled bg-amber-500 shadow-sm" : "rating-bean--empty border border-stone-400" %>"></span>
            <% end %>
          </div>
        </div>
        <div data-testid="brew-balance-card" class="min-w-0 rounded-md bg-white/10 p-2 sm:p-3">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.balance_label") %></p>
          <p data-testid="brew-balance" class="mt-1 overflow-hidden text-ellipsis text-[0.75rem] font-bold leading-tight text-green-300 sm:text-sm"><%= brew.taste_balance.humanize %></p>
        </div>
      </div>
    </div>
  </div>

  <div data-testid="brew-chart-grid" class="brew-chart-grid bg-stone-50 px-1 py-1 text-stone-950 sm:px-4 sm:py-3">
    <% preinfusion_x = brew_card_chart_x(brew.preinfusion_seconds, brew.total_time_seconds) || 172 %>
    <% first_drip_x = brew_card_chart_x(brew.first_drip_seconds, brew.total_time_seconds) %>
    <% total_time_x = brew_card_chart_x(brew.total_time_seconds, brew.total_time_seconds) || 500 %>
    <% first_drip_label_x = first_drip_x ? [ first_drip_x + 12, 432 ].min : nil %>
    <% axis_max_grams = brew_card_axis_max_grams(brew.beverage_grams) || brew.beverage_grams %>
    <svg class="block h-auto w-full" width="560" height="168" viewBox="0 0 560 168" role="img" aria-label="<%= t("brews.show.yield") %>">
      <defs>
        <linearGradient id="<%= chart_id %>" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#0f172a" stop-opacity=".16" />
          <stop offset="100%" stop-color="#0f172a" stop-opacity="0" />
        </linearGradient>
      </defs>

      <line x1="44" y1="130" x2="500" y2="130" stroke="#1c1917" stroke-width="2.5" />
      <line x1="44" y1="20" x2="44" y2="130" stroke="#1c1917" stroke-width="2.5" />

      <path d="M44 130 C84 132, 124 132, 156 128 C182 124, 204 106, 230 88 C270 60, 320 46, 376 38 C420 32, 464 34, 500 42" fill="none" stroke="#0f172a" stroke-width="6" stroke-linecap="round" />
      <path d="M44 130 C84 132, 124 132, 156 128 C182 124, 204 106, 230 88 C270 60, 320 46, 376 38 C420 32, 464 34, 500 42 L500 130 L44 130 Z" fill="url(#<%= chart_id %>)" />

      <path d="M44 9 C134 8, 224 8, 314 8 C390 7, 452 8, 500 11" fill="none" stroke="#a16207" stroke-width="3.5" stroke-linecap="round" />

      <line x1="<%= preinfusion_x %>" y1="25" x2="<%= preinfusion_x %>" y2="140" stroke="#78716c" stroke-width="2.5" stroke-dasharray="6 8" />
      <% if first_drip_x.present? %>
        <line x1="<%= first_drip_x %>" y1="25" x2="<%= first_drip_x %>" y2="140" stroke="#0f766e" stroke-width="2.5" stroke-dasharray="4 7" />
      <% end %>
      <line data-testid="brew-total-time-guide" x1="<%= total_time_x %>" y1="25" x2="<%= total_time_x %>" y2="140" stroke="#78716c" stroke-width="2.5" stroke-dasharray="6 8" />
      <line x1="44" y1="48" x2="30" y2="48" stroke="#78716c" stroke-width="2.5" />

      <text x="8" y="135" font-size="13" fill="#57534e">0g</text>
      <text data-testid="brew-axis-max" x="6" y="52" font-size="13" fill="#57534e"><%= brew_card_grams(axis_max_grams) %></text>
      <text x="32" y="157" font-size="13" fill="#57534e">0s</text>
      <text data-testid="brew-preinfusion-label" x="<%= [ preinfusion_x - 36, 54 ].max %>" y="157" font-size="13" fill="#57534e"><%= brew_card_seconds(brew.preinfusion_seconds) %> Preinfusion</text>
      <% if first_drip_x.present? %>
        <g data-testid="brew-first-drip-callout">
          <rect x="<%= first_drip_label_x - 7 %>" y="95" width="126" height="20" rx="5" fill="#f0fdfa" fill-opacity=".95" />
          <text data-testid="brew-first-drip-label" x="<%= first_drip_label_x %>" y="110" font-size="13" font-weight="800" fill="#0f766e"><%= t("brews.show.first_drip_label", seconds: brew_card_seconds(brew.first_drip_seconds)) %></text>
        </g>
      <% end %>
      <text data-testid="brew-total-time-label" x="<%= total_time_x - 19 %>" y="157" font-size="13" fill="#57534e"><%= brew_card_seconds(brew.total_time_seconds) %></text>
      <g data-testid="brew-temperature-callout" transform="translate(536 132) rotate(-90)">
        <rect x="0" y="-18" width="118" height="21" rx="5" fill="#fffbeb" fill-opacity=".95" />
        <text data-testid="brew-temperature-label" x="7" y="-3" font-size="14" font-weight="800" fill="#a16207"><%= t("brews.show.temperature_label", temperature: brew_card_temperature(brew.brew_temperature_celsius)) %></text>
      </g>
      <text x="386" y="65" font-size="14" font-weight="800" fill="#0f172a"><%= brew_card_grams(brew.beverage_grams) %></text>
    </svg>
  </div>

  <div class="bg-stone-900 px-5 py-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex max-w-full items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold text-stone-100">
        <% if grinder_photo.present? %>
          <%= image_tag media_attachment_path(grinder_photo), alt: "", data: { testid: "brew-grinder-photo" }, class: "h-4 w-4 shrink-0 rounded-full object-cover ring-1 ring-white/20" %>
        <% end %>
        <span class="truncate"><%= t("brews.show.grinder") %>: <%= brew.grinder&.name || t("brews.show.unknown") %></span>
      </span>
      <span class="inline-flex max-w-full items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold text-stone-100">
        <% if machine_photo.present? %>
          <%= image_tag media_attachment_path(machine_photo), alt: "", data: { testid: "brew-machine-photo" }, class: "h-4 w-4 shrink-0 rounded-full object-cover ring-1 ring-white/20" %>
        <% end %>
        <span class="truncate"><%= t("brews.show.machine") %>: <%= brew.machine&.name || t("brews.show.unknown") %></span>
      </span>
      <% brew_card_tools(brew).each do |tool| %>
        <span data-testid="brew-tool" class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-stone-200"><%= tool.tool_name %></span>
      <% end %>
    </div>
  </div>
</article>
