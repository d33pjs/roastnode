<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <%= link_to t(".back"), brew_path(@brew), class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
    <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>

    <%= render "form", brew: @brew, submit_label: t(".update"), autofocus_field: @autofocus_field %>

    <%= render "shared/photo_grid",
      record: @brew,
      title: t(".photos"),
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>
  </section>
</main>
