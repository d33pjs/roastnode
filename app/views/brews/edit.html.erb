<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <%= render "shared/back_link", label: t(".back"), path: brew_path(@brew) %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold text-stone-950"><%= t(".title") %></h1>
      <% if @brew.public_brew_share&.enabled? %>
        <span data-testid="brew-edit-shared-marker" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-extrabold uppercase tracking-[0.08em] text-emerald-800"><%= t("brews.shared_marker") %></span>
      <% end %>
    </div>

    <%= render "form",
      brew: @brew,
      submit_label: t(".update"),
      autofocus_field: @autofocus_field,
      draft_storage_key: @draft_storage_key,
      hidden_brew_fields: @hidden_brew_fields %>

    <%= render "shared/photo_grid",
      record: @brew,
      title: t(".photos"),
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>
  </section>
</main>
