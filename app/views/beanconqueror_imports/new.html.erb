<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-3xl px-6 py-10">
    <%= link_to t(".back"), dashboard_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
    <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>

    <%= form_with scope: :beanconqueror_import, url: beanconqueror_imports_path, class: "mt-8 grid gap-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
      <div>
        <%= form.label :file, t(".file"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.file_field :file, accept: "application/json,.json", class: "mt-1 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
      </div>

      <%= form.submit t(".create"), class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
    <% end %>
  </section>
</main>
