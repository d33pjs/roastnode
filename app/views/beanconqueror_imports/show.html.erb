<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <%= link_to t(".back"), root_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
    <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>

    <section class="mt-8 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <p class="font-semibold text-stone-950"><%= t(".status", status: @data_import.status) %></p>
      <p class="mt-1 text-sm text-stone-600"><%= l(@data_import.created_at, format: :short) %></p>

      <table class="mt-6 w-full text-left text-sm">
        <thead class="text-stone-600">
          <tr>
            <th class="border-b border-stone-200 py-2 pr-4"><%= t(".record_type") %></th>
            <th class="border-b border-stone-200 py-2 pr-4"><%= t(".created") %></th>
            <th class="border-b border-stone-200 py-2"><%= t(".skipped") %></th>
          </tr>
        </thead>
        <tbody>
          <% @data_import.summary.each do |record_type, counts| %>
            <tr>
              <td class="border-b border-stone-100 py-2 pr-4 font-medium text-stone-950"><%= record_type %></td>
              <td class="border-b border-stone-100 py-2 pr-4 text-stone-700"><%= counts["created"] %></td>
              <td class="border-b border-stone-100 py-2 text-stone-700"><%= counts["skipped"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @data_import.warnings.any? %>
        <section class="mt-6">
          <h2 class="font-semibold text-stone-950"><%= t(".warnings") %></h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-stone-700">
            <% @data_import.warnings.each do |warning| %>
              <li><%= warning %></li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </section>
  </section>
</main>
