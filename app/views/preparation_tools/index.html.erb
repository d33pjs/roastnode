<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-5xl px-6 py-10">
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= link_to t(".back"), root_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
        <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>
        <p class="mt-2 text-stone-700"><%= current_workspace.name %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".new"), new_preparation_tool_path, class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
      <% end %>
    </header>

    <div class="overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-stone-200">
        <thead class="bg-stone-100">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".name") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".method") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".status") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @preparation_tools.each do |tool| %>
            <tr>
              <td class="px-4 py-3 text-sm font-medium text-stone-950"><%= tool.name %></td>
              <td class="px-4 py-3 text-sm text-stone-700"><%= tool.brew_method.humanize %></td>
              <td class="px-4 py-3 text-sm text-stone-700"><%= tool.active? ? t(".active") : t(".inactive") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
