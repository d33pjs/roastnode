<main class="rn-page">
  <section class="rn-shell max-w-4xl py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link", label: t(".back"), path: gear_path %>
    <div class="mt-5">
      <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
    </div>

    <%= render "form", preparation_tool: @preparation_tool, submit_label: t(".create") %>
  </section>
</main>
