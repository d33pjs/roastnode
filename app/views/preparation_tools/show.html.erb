<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-5xl px-6 py-10">
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render "shared/back_link", label: t(".back"), path: preparation_tools_path %>
        <p data-testid="preparation-tool-status" class="mt-4 text-sm font-semibold uppercase text-stone-600"><%= @preparation_tool.active? ? t(".active") : t(".inactive") %></p>
        <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= @preparation_tool.name %></h1>
        <p class="mt-2 text-stone-700"><%= @preparation_tool.brew_method.humanize %></p>
      </div>

      <% if current_workspace_policy.manage? %>
        <div class="flex flex-wrap gap-2">
          <%= link_to t(".edit"), edit_preparation_tool_path(@preparation_tool), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
          <% if @preparation_tool.active? %>
            <%= button_to t(".archive"), archive_preparation_tool_path(@preparation_tool), method: :patch, class: "rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
          <% else %>
            <%= button_to t(".reopen"), reopen_preparation_tool_path(@preparation_tool), method: :patch, class: "rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-800" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <%= form_with url: preparation_tool_path(@preparation_tool), method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do |form| %>
      <div>
        <%= form.label :start_date, t(".start_date"), class: "block text-xs font-bold uppercase text-stone-500" %>
        <%= form.date_field :start_date, value: @preparation_tool_statistics_start_date&.iso8601, data: { testid: "preparation-tool-statistics-start-date" }, class: "mt-1 rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 shadow-sm" %>
      </div>
      <div>
        <%= form.label :end_date, t(".end_date"), class: "block text-xs font-bold uppercase text-stone-500" %>
        <%= form.date_field :end_date, value: @preparation_tool_statistics_end_date&.iso8601, data: { testid: "preparation-tool-statistics-end-date" }, class: "mt-1 rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 shadow-sm" %>
      </div>
      <%= form.submit t(".apply_filters"), class: "rounded-lg bg-stone-950 px-4 py-2 font-semibold text-white shadow-sm" %>
      <%= link_to t(".reset_filters"), preparation_tool_path(@preparation_tool), class: "rounded-lg border border-stone-300 bg-white px-4 py-2 font-semibold text-stone-950 shadow-sm" %>
    <% end %>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".used_in_brews") %></p>
        <p data-testid="preparation-tool-brew-count" class="mt-2 text-3xl font-bold text-stone-950"><%= @preparation_tool_statistics[:totals][:brew_count] %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".total_ground") %></p>
        <p data-testid="preparation-tool-total-ground" class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_grams(@preparation_tool_statistics[:totals][:total_bean_weight_grams]) %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".position") %></p>
        <p class="mt-2 text-3xl font-bold text-stone-950"><%= @preparation_tool.position %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".method") %></p>
        <p class="mt-2 text-lg font-bold text-stone-950"><%= @preparation_tool.brew_method.humanize %></p>
      </div>
    </section>

    <section class="mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".analytics") %></h2>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".average_rating") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950">
            <% if @preparation_tool_statistics[:averages][:rating].present? %>
              <%= profile_number(@preparation_tool_statistics[:averages][:rating], precision: 1) %>/5
            <% else %>
              <%= t(".unknown") %>
            <% end %>
          </p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".average_yield") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_grams(@preparation_tool_statistics[:averages][:beverage_grams]) %></p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".average_time") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950"><%= brew_card_seconds(@preparation_tool_statistics[:averages][:total_time_seconds]) %></p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".channeling_rate") %></p>
          <p data-testid="preparation-tool-channeling-rate" class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_percent(@preparation_tool_statistics[:rates][:channeling_percent]) %></p>
          <p class="mt-1 text-xs font-semibold text-stone-500"><%= t(".channeling_count", count: @preparation_tool_statistics[:rates][:channeling_count], total: @preparation_tool_statistics[:totals][:brew_count]) %></p>
        </div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".best_brews") %></h3>
          <div data-testid="preparation-tool-best-brews" class="mt-3 grid gap-2">
            <% if @preparation_tool_statistics[:best_brews].any? %>
              <% @preparation_tool_statistics[:best_brews].each do |brew| %>
                <%= link_to brew_path(brew), class: "block rounded-md border border-stone-200 p-3 hover:bg-stone-50" do %>
                  <span class="block text-sm font-bold text-stone-950"><%= brew_card_timestamp(brew) %></span>
                  <span class="mt-1 block text-sm text-stone-600"><%= brew_card_grams(brew.beverage_grams) %> · <%= brew_card_ratio(brew) %> · <%= brew_card_rating_label(brew.rating) %></span>
                <% end %>
              <% end %>
            <% else %>
              <p class="text-sm text-stone-600"><%= t(".no_brews") %></p>
            <% end %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".recent_brews") %></h3>
          <div data-testid="preparation-tool-recent-brews" class="mt-3 grid gap-2">
            <% if @recent_brews.any? %>
              <% @recent_brews.each do |brew| %>
                <%= link_to brew_path(brew), class: "block rounded-md border border-stone-200 p-3 hover:bg-stone-50" do %>
                  <span class="block text-sm font-bold text-stone-950"><%= t(".brew", bean: brew.bean.name) %></span>
                  <span class="mt-1 block text-sm text-stone-600"><%= brew_card_timestamp(brew) %> · <%= t(".grind") %>: <%= brew.grind_setting.presence || t(".unknown") %> · <%= t(".time") %>: <%= brew_card_seconds(brew.total_time_seconds) %></span>
                <% end %>
              <% end %>
            <% else %>
              <p class="text-sm text-stone-600"><%= t(".no_brews") %></p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".taste_balance") %></h3>
          <div class="mt-3 rounded-md border border-stone-200 p-3">
            <%= render "statistics/bar_list", values: @preparation_tool_statistics[:distributions][:taste_balance], maximum: @preparation_tool_statistics[:distributions][:taste_balance].values.max, empty_label: t(".no_brews") %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".retention_markers") %></h3>
          <div class="mt-3 rounded-md border border-stone-200 p-3">
            <%= render "statistics/bar_list", values: @preparation_tool_statistics[:distributions][:retention_marker], maximum: @preparation_tool_statistics[:distributions][:retention_marker].values.max, empty_label: t(".no_brews") %>
          </div>
        </div>
      </div>
    </section>

    <% if @preparation_tool.notes.present? %>
      <section class="mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-stone-950"><%= t(".notes") %></h2>
        <p class="mt-2 whitespace-pre-line text-stone-700"><%= @preparation_tool.notes %></p>
      </section>
    <% end %>

    <%= render "shared/record_links_list", record: @preparation_tool, section_class: "mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm", title_class: "font-semibold text-stone-950" %>

    <%= render "shared/photo_grid",
      record: @preparation_tool,
      title: t(".photos"),
      section_class: "mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "font-semibold text-stone-950",
      actions_allowed: current_workspace_policy.manage? %>

    <% if current_workspace_policy.manage? %>
      <section data-testid="preparation-tool-danger-zone" class="mt-8 rounded-lg border border-red-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-red-800"><%= t(".danger_zone") %></h2>
        <p class="mt-2 text-sm text-stone-700"><%= t(".danger_zone_body", count: @preparation_tool.brews.count) %></p>
        <%= button_to t(".delete"),
          preparation_tool_path(@preparation_tool),
          method: :delete,
          form: { data: { turbo_confirm: t(".delete_confirmation", count: @preparation_tool.brews.count) } },
          class: "mt-4 rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
      </section>
    <% end %>
  </section>
</main>
