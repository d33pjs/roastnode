<% if current_workspace_policy.write? %>
  <details class="mt-6 rounded-2xl border border-rn-line bg-rn-surface p-5" data-testid="bean-group-link">
    <summary class="cursor-pointer text-lg font-black text-rn-ink"><%= t("bean_collection_operations.link_title") %></summary>
    <p class="mt-3 text-sm text-rn-muted"><%= t("bean_collection_operations.link_help") %></p>
    <p class="mt-2 text-sm font-bold text-rn-muted"><%= t("bean_collection_operations.current_bags", count: bean.coffee_history.beans.count) %></p>
    <%= form_with url: bean_group_link_path(bean), method: :patch, scope: :bean_group_link, class: "mt-4 grid gap-3 sm:grid-cols-[1fr_auto]" do |form| %>
      <div>
        <%= form.label :target_bean_id, t("bean_collection_operations.target"), class: "block text-sm font-bold text-rn-ink" %>
        <% options = current_workspace.beans.where.not(id: bean.id).order(:roaster_name, :name, :opened_on).map { |candidate| ["#{candidate.display_name} · #{candidate.bag_size_grams.to_i} g · #{candidate.opened_on || t('bean_collection_operations.unopened')}", candidate.id] } %>
        <%= form.select :target_bean_id, [[t("bean_collection_operations.separate"), "separate"]] + options, {}, class: "mt-1 w-full rounded-xl border border-rn-line bg-rn-surface px-3 py-3 text-rn-ink" %>
      </div>
      <%= form.submit t("bean_collection_operations.link_save"), class: "self-end rounded-xl bg-[var(--rn-accent-strong)] px-4 py-3 text-sm font-bold text-white" %>
    <% end %>
  </details>
<% end %>
