<%= form_with model: bean, class: "mt-8 grid gap-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
  <% if bean.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <%= bean.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="grid gap-5">
    <div class="border-b border-stone-200 pb-3">
      <h2 class="text-lg font-semibold text-stone-950"><%= t("beans.form.bean_information") %></h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :name, t("beans.form.name"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :name, autofocus: true, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :roaster_name, t("beans.form.roaster"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :roaster_name, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <%= form.label :bag_size_grams, t("beans.form.bag_size"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.number_field :bag_size_grams, step: 0.1, inputmode: "decimal", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :remaining_grams, t("beans.form.remaining"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.number_field :remaining_grams, step: 0.1, inputmode: "decimal", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :opened_on, t("beans.form.opened_on"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.date_field :opened_on, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <%= form.label :purchased_on, t("beans.form.purchased_on"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.date_field :purchased_on, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :roast_date, t("beans.form.roast_date"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.date_field :roast_date, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :purchase_price, t("beans.form.purchase_price"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.number_field :purchase_price, step: 0.01, inputmode: "decimal", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-4">
      <div>
        <%= form.label :roast_type, t("beans.form.roast_type"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.select :roast_type, Bean::ROAST_TYPES.map { |type| [ type.humanize, type ] }, {}, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :roast_degree, t("beans.form.roast_degree"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.number_field :roast_degree, step: 0.5, min: 0, max: 5, inputmode: "decimal", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :rating, t("beans.form.rating"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.number_field :rating, min: 0, max: 5, inputmode: "numeric", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :blend_type, t("beans.form.blend_type"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.select :blend_type, Bean::BLEND_TYPES.map { |type| [ type.humanize, type ] }, {}, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>
    </div>

    <label class="flex items-center gap-2 text-sm font-medium text-stone-700">
      <%= form.check_box :decaffeinated, class: "h-4 w-4 rounded border-stone-300 text-stone-950" %>
      <%= t("beans.form.decaffeinated") %>
    </label>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :purchase_url, t("beans.form.purchase_url"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.url_field :purchase_url, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <div>
        <%= form.label :purchase_source, t("beans.form.purchase_source"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_field :purchase_source, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= form.label :tasting_notes, t("beans.form.tasting_notes"), class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_area :tasting_notes, rows: 3, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
    </div>
  </section>

  <section class="grid gap-5">
    <div class="border-b border-stone-200 pb-3">
      <h2 class="text-lg font-semibold text-stone-950"><%= t("beans.form.variety_information") %></h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-3">
      <% %i[country region farm farmer elevation variety process harvested blend_percentage].each do |field| %>
        <div>
          <%= form.label field, t("beans.form.#{field}"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field field, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>
      <% end %>
    </div>
  </section>

  <div>
    <%= form.label :notes, t("beans.form.notes"), class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :photos, t("beans.form.photos"), class: "block text-sm font-medium text-stone-700" %>
    <%= form.file_field :photos, multiple: true, accept: "image/*", class: "mt-1 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
  </div>

  <%= form.submit submit_label, class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
<% end %>
