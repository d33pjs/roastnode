<% label_class = "block text-sm font-extrabold text-rn-muted" %>
<% input_class = "mt-1 w-full rounded-2xl border border-rn-line bg-rn-surface px-3 py-2.5 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
<% section_class = "grid gap-4 rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5" %>
<% section_title_class = "text-lg font-black text-rn-ink" %>

<%= form_with model: bean, class: "mt-6 grid gap-4" do |form| %>
  <% if bean.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800">
      <%= bean.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section data-testid="bean-form-section" data-section="identity" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("beans.form.sections.identity") %></h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :name, t("beans.form.name"), class: label_class %>
        <%= form.text_field :name, autofocus: true, class: input_class %>
      </div>

      <div data-controller="roaster-suggestions" data-roaster-suggestions-url-value="<%= roaster_suggestions_beans_path(format: :json) %>" class="relative">
        <%= form.label :roaster_name, t("beans.form.roaster"), class: label_class %>
        <%= form.text_field :roaster_name,
          autocomplete: "off",
          class: input_class,
          data: {
            roaster_suggestions_target: "input",
            action: "input->roaster-suggestions#search focus->roaster-suggestions#search blur->roaster-suggestions#blur"
          } %>
        <div data-roaster-suggestions-target="list" class="hidden absolute z-20 mt-2 max-h-56 w-full overflow-auto rounded-2xl border border-rn-line bg-rn-surface p-1 shadow-lg" role="listbox"></div>
      </div>
    </div>

    <div>
      <%= form.label :photos, t("beans.form.photos"), class: label_class %>
      <%= render "shared/photo_upload_input", form: %>
    </div>
  </section>

  <section data-testid="bean-form-section" data-section="inventory" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("beans.form.sections.inventory") %></h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <%= form.label :bag_status, t("beans.form.status"), class: label_class %>
        <%= form.select :bag_status, Bean::BAG_STATUSES.map { |status| [ t("beans.statuses.#{status}"), status ] }, { selected: bean.bag_status }, class: input_class %>
      </div>

      <div>
        <%= form.label :grind_state, t("beans.form.grind_state"), class: label_class %>
        <%= form.select :grind_state, Bean::GRIND_STATES.map { |state| [ t("beans.grind_states.#{state}"), state ] }, {}, class: input_class %>
      </div>

      <div>
        <%= form.label :bag_size_grams, t("beans.form.bag_size"), class: label_class %>
        <%= form.text_field :bag_size_grams, inputmode: "decimal", class: input_class %>
      </div>

      <div>
        <%= form.label :remaining_grams, t("beans.form.remaining"), class: label_class %>
        <%= form.text_field :remaining_grams, inputmode: "decimal", class: input_class %>
      </div>

      <div>
        <%= form.label :opened_on, t("beans.form.opened_on"), class: label_class %>
        <%= form.date_field :opened_on, class: input_class %>
      </div>
    </div>
  </section>

  <section data-testid="bean-form-section" data-section="roast" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("beans.form.sections.roast") %></h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <%= form.label :roast_date, t("beans.form.roast_date"), class: label_class %>
        <%= form.date_field :roast_date, class: input_class %>
      </div>

      <div>
        <%= form.label :roast_type, t("beans.form.roast_type"), class: label_class %>
        <%= form.select :roast_type, Bean::ROAST_TYPES.map { |type| [ type.humanize, type ] }, {}, class: input_class %>
      </div>

      <div>
        <%= form.label :roast_degree, t("beans.form.roast_degree"), class: label_class %>
        <%= form.text_field :roast_degree, inputmode: "decimal", class: input_class %>
      </div>

      <div>
        <%= form.label :rating, t("beans.form.rating"), class: label_class %>
        <%= form.number_field :rating, min: 0, max: 5, inputmode: "numeric", class: input_class %>
      </div>

      <label class="flex items-center gap-3 rounded-2xl border border-rn-line bg-[var(--rn-surface-muted)] px-3 py-3 text-sm font-extrabold text-rn-ink lg:self-end">
        <%= form.check_box :decaffeinated, class: "h-4 w-4 rounded border-rn-line text-rn-ink" %>
        <%= t("beans.form.decaffeinated") %>
      </label>
    </div>
  </section>

  <section data-testid="bean-form-section" data-section="origin" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("beans.form.sections.origin") %></h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% %i[country region farm farmer elevation variety process harvested blend_type blend_percentage].each do |field| %>
        <div>
          <%= form.label field, t("beans.form.#{field}"), class: label_class %>
          <% if field == :blend_type %>
            <%= form.select :blend_type, Bean::BLEND_TYPES.map { |type| [ type.humanize, type ] }, {}, class: input_class %>
          <% else %>
            <%= form.text_field field, class: input_class %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section data-testid="bean-form-section" data-section="purchase" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("beans.form.sections.purchase") %></h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :purchased_on, t("beans.form.purchased_on"), class: label_class %>
        <%= form.date_field :purchased_on, class: input_class %>
      </div>

      <div>
        <%= form.label :purchase_price, t("beans.form.purchase_price"), class: label_class %>
        <%= form.text_field :purchase_price, inputmode: "decimal", class: input_class %>
      </div>

      <div>
        <%= form.label :purchase_source, t("beans.form.purchase_source"), class: label_class %>
        <%= form.text_field :purchase_source, class: input_class %>
      </div>

      <div>
        <%= form.label :purchase_url, t("beans.form.purchase_url"), class: label_class %>
        <%= form.url_field :purchase_url, class: input_class %>
      </div>
    </div>
  </section>

  <section data-testid="bean-form-section" data-section="taste" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("beans.form.sections.taste") %></h2>
    </div>

    <div>
      <%= form.label :tasting_notes, t("beans.form.tasting_notes"), class: label_class %>
      <%= form.text_area :tasting_notes, rows: 3, class: input_class %>
    </div>

    <div>
      <%= form.label :notes, t("beans.form.notes"), class: label_class %>
      <%= form.text_area :notes, rows: 4, class: input_class %>
    </div>

    <div>
      <%= form.label :public_note, t("beans.form.public_note"), class: label_class %>
      <%= form.text_area :public_note, rows: 4, class: input_class %>
    </div>
  </section>

  <%= render "shared/record_links_fields",
    form:,
    record: bean,
    label_class:,
    input_class:,
    section_class:,
    section_title_class: %>

  <%= form.submit submit_label, class: "rounded-2xl bg-[var(--rn-accent-strong)] px-5 py-3 text-sm font-extrabold text-[#f8faf6] shadow-sm hover:opacity-90" %>
<% end %>
