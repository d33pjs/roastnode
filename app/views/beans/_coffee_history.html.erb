<div data-testid="bean-coffee-history" class="min-w-0 border-t border-rn-line pt-4">
  <%= label_tag "bean_coffee_history_choice", t("coffee_history.title"), class: label_class %>
  <% bag_count = bean.coffee_history&.persisted? ? bean.coffee_history.beans.count : 0 %>
  <p class="mt-1 text-sm text-rn-muted"><%= bag_count > 1 ? t("coffee_history.current_shared", count: bag_count) : t("coffee_history.current_independent") %></p>
  <% history_options = coffee_history_options(bean, @coffee_history_choice) %>
  <% selected_details = history_options.find { |_, value| value == @coffee_history_choice.to_s }&.first if @coffee_history_choice.present? && @coffee_history_choice != "separate" %>
  <%= select_tag "bean[coffee_history_choice]", options_for_select(history_options, @coffee_history_choice.to_s), id: "bean_coffee_history_choice", class: input_class, data: { coffee_history_choice_target: "choice", action: "change->coffee-history-choice#choiceChanged" }, aria: { describedby: "coffee-history-details coffee-history-help coffee-history-status" } %>
  <%= tag.p selected_details, id: "coffee-history-details", hidden: selected_details.blank?, data: { coffee_history_choice_target: "details" }, aria: { live: "polite" }, class: "mt-2 break-words text-sm font-semibold text-rn-ink" %>
  <p id="coffee-history-help" class="mt-2 text-xs text-rn-muted"><%= t("coffee_history.help") %></p>
  <p id="coffee-history-status" data-coffee-history-choice-target="status" aria-live="polite" class="mt-1 text-xs text-rn-muted"></p>
</div>
