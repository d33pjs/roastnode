<main class="rn-page overflow-x-hidden">
  <section class="rn-shell max-w-6xl py-5 sm:px-6 lg:py-10">
    <header class="mb-5 flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
        <h1 class="mt-4 text-3xl font-black leading-tight text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
        <p class="mt-1 text-sm font-semibold text-rn-muted"><%= current_workspace.name %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".new"), new_bean_path, class: "shrink-0 rounded-2xl bg-[var(--rn-accent-strong)] px-3.5 py-2.5 text-sm font-extrabold text-[#f8faf6] shadow-sm hover:opacity-90 sm:px-4 sm:py-3" %>
      <% end %>
    </header>

    <div data-testid="bean-card-list" class="grid max-w-full min-w-0 gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% if @beans.any? %>
        <% @beans.each do |bean| %>
          <% remaining_percent = bean.remaining_percent %>
          <% remaining_state = if bean.nearly_finished?
            "low"
          elsif remaining_percent <= 45
            "medium"
          else
            "plenty"
          end %>
          <% remaining_bar_class = {
            "plenty" => "bg-emerald-600",
            "medium" => "bg-amber-500",
            "low" => "bg-red-600"
          }.fetch(remaining_state) %>

          <%= link_to bean_path(bean), data: { testid: "bean-card" }, class: "block max-w-full min-w-0 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface p-3 shadow-sm hover:bg-[var(--rn-surface-muted)] sm:p-4" do %>
            <div class="flex min-w-0 items-start gap-2.5 sm:gap-3">
              <%= render "shared/record_photo_thumb",
                record: bean,
                testid: "bean-card-photo",
                class_name: "h-12 w-12 shrink-0 rounded-xl object-cover ring-1 ring-stone-200 sm:h-14 sm:w-14 sm:rounded-2xl" %>

              <div class="min-w-0 flex-1">
                <div class="flex min-w-0 items-start justify-between gap-2">
                  <div class="min-w-0">
                    <p class="truncate text-sm font-black text-rn-ink sm:text-base"><%= bean.name %></p>
                    <p class="mt-0.5 truncate text-xs font-semibold text-rn-muted sm:text-sm"><%= bean.roaster_name.presence || t(".unknown") %></p>
                    <% if bean.rating.present? %>
                      <p data-testid="bean-card-rating-<%= bean.id %>" class="mt-1 text-[0.68rem] font-extrabold text-amber-700 sm:text-xs"><%= t(".rating", rating: bean.rating) %></p>
                    <% end %>
                  </div>
                  <span class="shrink-0 rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 text-[0.65rem] font-extrabold text-rn-muted sm:px-2.5 sm:py-1 sm:text-xs"><%= t("beans.statuses.#{bean.bag_status}") %></span>
                </div>

                <% if bean.finished? %>
                  <div data-testid="bean-card-finished-stats-<%= bean.id %>" class="mt-2.5 rounded-xl bg-[var(--rn-surface-muted)] px-3 py-2 text-[0.68rem] font-extrabold text-rn-muted sm:mt-3 sm:text-xs">
                    <p class="text-rn-ink">
                      <%= t(".finished_stats",
                        used: statistics_grams(bean.finished_used_grams),
                        days: t(".days", count: bean.finished_open_days),
                        per_day: statistics_grams(bean.finished_grams_per_day)) %>
                    </p>
                    <% if bean.remaining_grams.to_d.positive? %>
                      <p class="mt-1"><%= t(".leftover", amount: statistics_grams(bean.remaining_grams)) %></p>
                    <% end %>
                  </div>
                <% else %>
                  <div class="mt-2.5 sm:mt-3">
                    <div class="flex min-w-0 items-center justify-between gap-2 text-[0.68rem] font-extrabold text-rn-muted sm:text-xs">
                      <span class="shrink-0"><%= t(".remaining") %></span>
                      <span data-testid="bean-card-remaining-<%= bean.id %>" class="min-w-0 truncate text-right"><%= t(".remaining_of", remaining: statistics_grams(bean.remaining_grams), total: statistics_grams(bean.bag_size_grams)) %></span>
                    </div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-[var(--rn-surface-muted)] sm:h-2">
                      <div data-testid="bean-card-progress-<%= bean.id %>" data-remaining-state="<%= remaining_state %>" class="h-full rounded-full <%= remaining_bar_class %>" style="width: <%= remaining_percent %>%"></div>
                    </div>
                    <% if remaining_state == "low" && bean.open? %>
                      <p data-testid="bean-card-low-warning-<%= bean.id %>" class="mt-1 text-[0.68rem] font-extrabold text-red-700 sm:text-xs"><%= t(".low_remaining") %></p>
                    <% end %>
                  </div>
                <% end %>

                <div class="mt-2 flex min-w-0 flex-wrap gap-1.5 text-[0.68rem] font-bold text-rn-muted sm:mt-3 sm:gap-2 sm:text-xs">
                  <% if bean.opened_on.present? %>
                    <span class="max-w-full truncate rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 sm:px-2.5 sm:py-1"><%= t(".opened_on", date: l(bean.opened_on)) %></span>
                  <% end %>
                  <% if bean.finished_at.present? %>
                    <span data-testid="bean-card-finished-on-<%= bean.id %>" class="max-w-full truncate rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 sm:px-2.5 sm:py-1"><%= t(".finished_on", date: l(bean.finished_at.to_date)) %></span>
                  <% end %>
                  <% if bean.roast_date.present? %>
                    <span class="max-w-full truncate rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 sm:px-2.5 sm:py-1"><%= t(".roasted_on", date: l(bean.roast_date)) %></span>
                  <% end %>
                  <% if bean.country.present? %>
                    <span class="max-w-full truncate rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 sm:px-2.5 sm:py-1"><%= bean.country %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p class="rounded-2xl border border-rn-line bg-rn-surface p-4 text-sm font-semibold text-rn-muted"><%= t(".none") %></p>
      <% end %>
    </div>
  </section>
</main>
