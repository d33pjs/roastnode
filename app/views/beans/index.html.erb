<main class="rn-page">
  <section class="rn-shell max-w-6xl py-6 sm:px-6 lg:py-10">
    <header class="mb-6 flex items-start justify-between gap-4">
      <div>
        <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
        <h1 class="mt-4 text-4xl font-black leading-tight text-rn-ink"><%= t(".title") %></h1>
        <p class="mt-2 text-sm font-semibold text-rn-muted"><%= current_workspace.name %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".new"), new_bean_path, class: "shrink-0 rounded-2xl bg-[var(--rn-accent-strong)] px-4 py-3 text-sm font-extrabold text-[#f8faf6] shadow-sm hover:opacity-90" %>
      <% end %>
    </header>

    <div data-testid="bean-mobile-list" class="grid gap-3 md:hidden">
      <% if @beans.any? %>
        <% @beans.each do |bean| %>
          <% remaining_percent = if bean.bag_size_grams.to_d.positive?
            ((bean.remaining_grams.to_d / bean.bag_size_grams.to_d) * 100).clamp(0, 100)
          else
            0
          end %>

          <%= link_to bean_path(bean), data: { testid: "bean-mobile-card" }, class: "block rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm" do %>
            <div class="flex items-start gap-3">
              <%= render "shared/record_photo_thumb",
                record: bean,
                testid: "bean-mobile-card-photo",
                class_name: "h-16 w-16 shrink-0 rounded-2xl object-cover ring-1 ring-stone-200" %>

              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="truncate text-base font-black text-rn-ink"><%= bean.name %></p>
                    <p class="mt-0.5 truncate text-sm font-semibold text-rn-muted"><%= bean.roaster_name.presence || t(".unknown") %></p>
                  </div>
                  <span class="shrink-0 rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1 text-xs font-extrabold text-rn-muted"><%= t("beans.statuses.#{bean.bag_status}") %></span>
                </div>

                <div class="mt-3">
                  <div class="flex items-center justify-between gap-3 text-xs font-extrabold text-rn-muted">
                    <span><%= t(".remaining") %></span>
                    <span data-testid="bean-mobile-card-remaining-<%= bean.id %>"><%= t(".remaining_of", remaining: statistics_grams(bean.remaining_grams), total: statistics_grams(bean.bag_size_grams)) %></span>
                  </div>
                  <div class="mt-1 h-2 overflow-hidden rounded-full bg-[var(--rn-surface-muted)]">
                    <div data-testid="bean-mobile-card-progress-<%= bean.id %>" class="h-full rounded-full bg-[var(--rn-accent-strong)]" style="width: <%= remaining_percent %>%"></div>
                  </div>
                </div>

                <div class="mt-3 flex flex-wrap gap-2 text-xs font-bold text-rn-muted">
                  <% if bean.opened_on.present? %>
                    <span class="rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1"><%= t(".opened_on", date: l(bean.opened_on)) %></span>
                  <% end %>
                  <% if bean.roast_date.present? %>
                    <span class="rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1"><%= t(".roasted_on", date: l(bean.roast_date)) %></span>
                  <% end %>
                  <% if bean.country.present? %>
                    <span class="rounded-full bg-[var(--rn-surface-muted)] px-2.5 py-1"><%= bean.country %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p class="rounded-2xl border border-rn-line bg-rn-surface p-4 text-sm font-semibold text-rn-muted"><%= t(".none") %></p>
      <% end %>
    </div>

    <div data-testid="bean-desktop-table" class="hidden md:block">
      <div class="overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
        <table class="min-w-full divide-y divide-stone-200">
          <thead class="bg-[var(--rn-surface-muted)]">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-extrabold text-rn-muted"><%= t(".bean") %></th>
              <th class="px-4 py-3 text-left text-sm font-extrabold text-rn-muted"><%= t(".roaster") %></th>
              <th class="px-4 py-3 text-left text-sm font-extrabold text-rn-muted"><%= t(".remaining") %></th>
              <th class="px-4 py-3 text-left text-sm font-extrabold text-rn-muted"><%= t(".status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @beans.each do |bean| %>
              <tr>
                <td class="px-4 py-3 text-sm font-extrabold text-rn-ink">
                  <%= link_to bean_path(bean), class: "flex items-center gap-3 hover:underline" do %>
                    <%= render "shared/record_photo_thumb",
                      record: bean,
                      testid: "bean-list-photo",
                      class_name: "h-12 w-12 shrink-0 rounded-xl object-cover ring-1 ring-stone-200" %>
                    <span><%= bean.name %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-rn-muted"><%= bean.roaster_name.presence || t(".unknown") %></td>
                <td data-testid="bean-list-remaining-<%= bean.id %>" class="px-4 py-3 text-sm text-rn-muted"><%= t(".remaining_of", remaining: statistics_grams(bean.remaining_grams), total: statistics_grams(bean.bag_size_grams)) %></td>
                <td class="px-4 py-3 text-sm text-rn-muted"><%= t("beans.statuses.#{bean.bag_status}") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>
