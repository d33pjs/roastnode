<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <%= link_to t(".back"), beans_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>

      <% if current_workspace_policy.write? %>
        <div class="flex flex-wrap gap-2">
          <%= link_to t(".edit"), edit_bean_path(@bean), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
          <%= button_to t(".duplicate"), duplicate_bean_path(@bean), method: :post, class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
          <% if @bean.archived_at.present? %>
            <%= button_to t(".reopen"), reopen_bean_path(@bean), method: :patch, class: "rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-800" %>
          <% else %>
            <%= button_to t(".close"), close_bean_path(@bean), method: :patch, class: "rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <header class="mt-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase text-stone-600"><%= @bean.roaster_name.presence || t(".unknown_roaster") %></p>
      <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= @bean.name %></h1>
      <p class="mt-3 text-stone-700"><%= @bean.origin.presence || t(".unknown_origin") %></p>
    </header>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".remaining") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= number_with_precision(@bean.remaining_grams, precision: 1, strip_insignificant_zeros: true) %> g</p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".bag_size") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= number_with_precision(@bean.bag_size_grams, precision: 1, strip_insignificant_zeros: true) %> g</p>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".status") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= @bean.open? ? t(".open") : t(".closed") %></p>
      </section>
    </div>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".details") %></h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% {
          purchased_on: @bean.purchased_on,
          roast_date: @bean.roast_date,
          roast_type: @bean.roast_type.humanize,
          roast_degree: @bean.roast_degree,
          rating: @bean.rating,
          blend_type: @bean.blend_type.humanize,
          purchase_price: number_to_currency(@bean.purchase_price, unit: "€"),
          tasting_notes: @bean.tasting_notes,
          decaffeinated: @bean.decaffeinated? ? t(".yes") : t(".no"),
          purchase_url: @bean.purchase_url,
          country: @bean.country,
          region: @bean.region,
          farm: @bean.farm,
          farmer: @bean.farmer,
          elevation: @bean.elevation,
          variety: @bean.variety,
          process: @bean.process,
          harvested: @bean.harvested,
          blend_percentage: @bean.blend_percentage
        }.each do |field, value| %>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".#{field}") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= value.presence || t(".unknown") %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".notes") %></h2>
      <p class="mt-2 whitespace-pre-line text-stone-700"><%= @bean.notes.presence || t(".no_notes") %></p>
    </section>

    <%= render "shared/photo_grid",
      record: @bean,
      title: t(".photos"),
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>
  </section>
</main>
