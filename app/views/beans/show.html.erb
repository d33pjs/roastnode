<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <%= render "shared/back_link", label: t(".back"), path: beans_path %>

      <% if @bean.purchase_url.present? || current_workspace_policy.write? %>
        <div class="flex flex-wrap gap-2">
          <% if @bean.purchase_url.present? %>
            <%= link_to t(".rebuy"), @bean.purchase_url, target: "_blank", rel: "noopener", data: { testid: "bean-rebuy-link" }, class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
          <% end %>

          <% if current_workspace_policy.write? %>
            <%= link_to t(".edit"), edit_bean_path(@bean), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
            <%= link_to t(".adjust_inventory"), new_bean_inventory_adjustment_path(@bean), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
            <% if PublicBeanShare.publishable_bean?(@bean) %>
              <% public_bean_share = @bean.public_bean_share %>
              <% if public_bean_share.present? %>
                <% if public_bean_share.enabled? && public_bean_share.manageable_by?(Current.user) %>
                  <% public_share_title = public_bean_share.title.presence || PublicBeanShare.default_title_for(@bean) %>
                  <%= render "shared/native_share_button",
                    url: public_bean_page_url(public_bean_share.token),
                    title: public_share_title,
                    text: t("beans.native_share.text", title: public_share_title),
                    label: t("shared.native_share.share_public_bean"),
                    testid: "bean-native-share-button-#{@bean.id}",
                    button_class: "inline-flex h-10 w-10 items-center justify-center rounded-full text-stone-700 hover:bg-stone-100 hover:text-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-400" %>
                <% end %>
                <% if public_bean_share.manageable_by?(Current.user) %>
                  <%= link_to t(".edit_public_share"), edit_bean_public_bean_share_path(@bean), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
                <% end %>
              <% else %>
                <%= link_to t(".share_publicly"), new_bean_public_bean_share_path(@bean), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
              <% end %>
            <% end %>
            <%= button_to t(".duplicate"), duplicate_bean_path(@bean), method: :post, class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
            <% if @bean.stock? %>
              <%= button_to t(".open_bag"), open_bag_bean_path(@bean), method: :patch, form: { data: { testid: "bean-open-bag-form" } }, class: "rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-800" %>
            <% elsif @bean.archived? || @bean.finished? %>
              <%= button_to t(".reopen"), reopen_bean_path(@bean), method: :patch, class: "rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-800" %>
            <% else %>
              <%= button_to t(".finish"), finish_bean_path(@bean), method: :patch, form: { data: { testid: "bean-finish-form" } }, class: "rounded-md bg-stone-950 px-4 py-2 text-sm font-semibold text-white hover:bg-stone-800" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <header class="mt-4 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <p class="text-sm font-semibold uppercase text-stone-600"><%= @bean.roaster_name.presence || t(".unknown_roaster") %></p>
          <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= @bean.name %></h1>
          <p data-testid="bean-header-origin" class="mt-3 text-stone-700"><%= bean_origin_label(@bean) %></p>
        </div>

        <% if @bean.primary_photo_attachment.present? %>
          <%= link_to "#bean-photos", class: "block shrink-0 rounded-md border border-stone-200 bg-stone-50 p-2 hover:bg-stone-100" do %>
            <%= image_tag media_attachment_path(@bean.primary_photo_attachment, variant: :thumbnail), alt: "", data: { testid: "bean-header-photo" }, class: "h-32 w-32 object-contain sm:h-36 sm:w-36" %>
          <% end %>
        <% end %>
      </div>
    </header>

    <% remaining_percent = @bean.remaining_percent %>
    <% remaining_state = if @bean.nearly_finished?
      "low"
    elsif remaining_percent <= 45
      "medium"
    else
      "plenty"
    end %>
    <% remaining_bar_class = {
      "plenty" => "bg-emerald-600",
      "medium" => "bg-amber-500",
      "low" => "bg-red-600"
    }.fetch(remaining_state) %>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <section data-testid="bean-remaining-card" class="min-w-0 rounded-lg border border-stone-200 bg-white p-4 shadow-sm sm:p-5">
        <h2 class="text-xs font-bold uppercase leading-tight text-stone-500"><%= t(".remaining") %></h2>
        <div class="mt-2 overflow-hidden">
          <p data-testid="bean-remaining-value" class="overflow-hidden text-ellipsis whitespace-nowrap text-2xl font-bold leading-8 text-stone-950"><%= profile_grams(@bean.remaining_grams) %></p>
          <p data-testid="bean-remaining-context" class="mt-1 overflow-hidden text-ellipsis whitespace-nowrap text-xs font-semibold leading-tight text-stone-500"><%= t(".remaining_bag_context", total: profile_grams(@bean.bag_size_grams)) %></p>
        </div>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-stone-100">
          <div data-testid="bean-detail-progress" data-remaining-state="<%= remaining_state %>" class="h-full rounded-full <%= remaining_bar_class %>" style="width: <%= remaining_percent %>%"></div>
        </div>
      </section>
      <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".brew_count") %></h2>
        <p data-testid="bean-detail-brew-count" class="mt-2 text-2xl font-bold text-stone-950"><%= @bean_statistics[:totals][:brew_count] %></p>
      </section>
      <section data-testid="bean-status-card" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".status") %></h2>
        <p class="mt-2 text-2xl font-bold text-stone-950"><%= t("beans.statuses.#{@bean.bag_status}") %></p>
      </section>
    </div>

    <% cost_metrics = {
      cost_per_kg: @bean.cost_per_kg,
      cost_per_package: @bean.cost_per_package,
      cost_per_shot: @bean.cost_per_shot
    }.compact %>
    <% if cost_metrics.any? %>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <% cost_metrics.each do |field, value| %>
          <section class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-semibold uppercase text-stone-600"><%= t(".#{field}") %></h2>
            <p data-testid="bean-<%= field.to_s.tr("_", "-") %>" class="mt-2 text-2xl font-bold text-stone-950"><%= profile_money(value) %></p>
          </section>
        <% end %>
      </div>
    <% end %>

    <section data-testid="bean-grinder-suggestions" class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-stone-950"><%= t(".grinder_tendency") %></h2>
          <p class="mt-1 text-sm text-stone-600"><%= t(".grinder_tendency_target") %></p>
        </div>
        <% if @bean.duplicated_from_bean_id.present? && params[:suggest_grinder].blank? && @grinder_tendency_first_brew.present? %>
          <%= link_to t(".calculate_grinder_tendency"), bean_path(@bean, suggest_grinder: "1"), data: { testid: "bean-grinder-manual-suggest" }, class: "shrink-0 rounded-md border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
        <% end %>
      </div>

      <% if @grinder_setting_suggestions.any? %>
        <div class="mt-4 grid gap-3 md:grid-cols-2">
          <% @grinder_setting_suggestions.each do |suggestion| %>
            <article data-testid="bean-grinder-suggestion" class="rounded-md border border-stone-200 p-4">
              <p class="text-xs font-bold uppercase text-stone-500"><%= suggestion[:grinder].name %></p>
              <p class="mt-2 text-2xl font-bold text-stone-950"><%= suggestion[:suggested_setting] %></p>
              <p class="mt-2 text-sm text-stone-600">
                <%= t(".grinder_suggestion_basis", count: suggestion[:comparable_brew_count]) %>
              </p>
              <p class="mt-1 text-sm font-semibold text-stone-700">
                <%= t(".grinder_suggestion_calibration",
                  setting: suggestion[:calibration_setting],
                  ratio: profile_number(suggestion[:calibration_ratio], precision: 2),
                  time: profile_number(suggestion[:calibration_total_time_seconds], precision: 0)) %>
              </p>
              <% if suggestion[:average_rating].present? %>
                <p class="mt-1 text-xs font-semibold text-stone-500">
                  <%= t(".grinder_suggestion_rating", rating: profile_number(suggestion[:average_rating], precision: 1)) %>
                </p>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <% if @bean.duplicated_from_bean_id.present? && params[:suggest_grinder].blank? %>
          <p data-testid="bean-grinder-suggestions-empty" class="mt-4 text-sm text-stone-600"><%= t(".duplicated_grinder_suggestion_skipped") %></p>
        <% elsif @grinder_tendency_first_brew.present? %>
          <div data-testid="bean-grinder-calibration" class="mt-4 rounded-md border border-stone-200 p-4">
            <p class="text-xs font-bold uppercase text-stone-500"><%= @grinder_tendency_first_brew.grinder&.name || t(".unknown") %></p>
            <p class="mt-2 text-sm font-semibold text-stone-800">
              <%= t(".grinder_calibration_summary",
                setting: @grinder_tendency_first_brew.grind_setting.presence || t(".unknown"),
                ratio: brew_card_ratio_value(@grinder_tendency_first_brew),
                time: brew_card_seconds(@grinder_tendency_first_brew.total_time_seconds)) %>
            </p>
          </div>
          <p data-testid="bean-grinder-suggestions-empty" class="mt-3 text-sm text-stone-600"><%= t(".no_grinder_suggestion") %></p>
        <% else %>
          <p data-testid="bean-grinder-suggestions-empty" class="mt-4 text-sm text-stone-600"><%= t(".no_first_brew_grinder_suggestion") %></p>
        <% end %>
      <% end %>

      <div data-testid="bean-grind-setting-distribution" class="mt-5">
        <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".grinder_settings") %></h3>
        <div class="mt-3 rounded-md border border-stone-200 p-3">
          <%= render "statistics/bar_list", values: @bean_statistics[:distributions][:grind_setting], maximum: @bean_statistics[:distributions][:grind_setting].values.max, empty_label: t(".no_grind_settings") %>
        </div>
      </div>
    </section>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".analytics") %></h2>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".consumed") %></p>
          <p data-testid="bean-consumed" class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_grams(@bean_statistics[:totals][:total_bean_weight_grams]) %></p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".remaining_percent") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_percent(@bean_statistics[:totals][:remaining_percent]) %></p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".open_age") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950">
            <% if @bean_statistics[:totals][:open_age_days].present? %>
              <%= t(".days", count: @bean_statistics[:totals][:open_age_days]) %>
            <% else %>
              <%= t(".unknown") %>
            <% end %>
          </p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".average_rating") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950">
            <% if @bean_statistics[:averages][:rating].present? %>
              <%= profile_number(@bean_statistics[:averages][:rating], precision: 1) %>/5
            <% else %>
              <%= t(".unknown") %>
            <% end %>
          </p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".channeling_rate") %></p>
          <p data-testid="bean-channeling-rate" class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_percent(@bean_statistics[:rates][:channeling_percent]) %></p>
          <p data-testid="bean-channeling-count" class="mt-1 text-xs font-semibold text-stone-500"><%= t(".channeling_count", count: @bean_statistics[:rates][:channeling_count], total: @bean_statistics[:rates][:channeling_brew_count], brews: t(".espresso_brews", count: @bean_statistics[:rates][:channeling_brew_count])) %></p>
        </div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".best_brews") %></h3>
          <div data-testid="bean-best-brews" class="mt-3 grid gap-2">
            <% if @bean_statistics[:best_brews].any? %>
              <% @bean_statistics[:best_brews].each do |brew| %>
                <%= link_to brew_path(brew), class: "block rounded-md border border-stone-200 p-3 hover:bg-stone-50" do %>
                  <span class="block text-sm font-bold text-stone-950"><%= brew_card_timestamp(brew) %></span>
                  <span class="mt-1 block text-sm text-stone-600"><%= brew_card_grams(brew.beverage_grams) %> · <%= brew_card_ratio(brew) %> · <%= brew_card_rating_label(brew.rating) %></span>
                <% end %>
              <% end %>
            <% else %>
              <p class="text-sm text-stone-600"><%= t(".no_brews") %></p>
            <% end %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".recent_brews") %></h3>
          <div data-testid="bean-recent-brews" class="mt-3 grid gap-2">
            <% if @bean_statistics[:recent_brews].any? %>
              <% @bean_statistics[:recent_brews].each do |brew| %>
                <%= link_to brew_path(brew), class: "block rounded-md border border-stone-200 p-3 hover:bg-stone-50" do %>
                  <span class="block text-sm font-bold text-stone-950"><%= brew_card_timestamp(brew) %></span>
                  <span class="mt-1 block text-sm text-stone-600"><%= t(".grind") %>: <%= brew.grind_setting.presence || t(".unknown") %> · <%= t(".time") %>: <%= brew_card_seconds(brew.total_time_seconds) %> · <%= t(".yield") %>: <%= brew_card_grams(brew.beverage_grams) %></span>
                <% end %>
              <% end %>
            <% else %>
              <p class="text-sm text-stone-600"><%= t(".no_brews") %></p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".taste_balance") %></h3>
          <div class="mt-3 rounded-md border border-stone-200 p-3">
            <%= render "statistics/bar_list", values: @bean_statistics[:distributions][:taste_balance], maximum: @bean_statistics[:distributions][:taste_balance].values.max, empty_label: t(".no_brews") %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".retention_markers") %></h3>
          <div class="mt-3 rounded-md border border-stone-200 p-3">
            <%= render "statistics/bar_list", values: @bean_statistics[:distributions][:retention_marker], maximum: @bean_statistics[:distributions][:retention_marker].values.max, empty_label: t(".no_brews") %>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".details") %></h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% {
          purchased_on: @bean.purchased_on,
          roast_date: @bean.roast_date,
          roast_type: @bean.roast_type.humanize,
          roast_degree: @bean.roast_degree,
          rating: @bean.rating,
          blend_type: @bean.blend_type.humanize,
          purchase_price: profile_money(@bean.purchase_price),
          tasting_notes: @bean.tasting_notes,
          decaffeinated: @bean.decaffeinated? ? t(".yes") : t(".no"),
          continent: @bean.continent,
          country: @bean.country,
          country_of_manufacturer: @bean.country_of_manufacturer,
          region: @bean.region,
          farm: @bean.farm,
          farmer: @bean.farmer,
          manufacturer: @bean.manufacturer,
          elevation: @bean.elevation,
          variety: @bean.variety,
          process: @bean.process,
          harvested: @bean.harvested,
          blend_percentage: @bean.blend_percentage
        }.each do |field, value| %>
          <div>
            <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".#{field}") %></dt>
            <dd class="mt-1 text-sm font-semibold text-stone-950"><%= value.presence || t(".unknown") %></dd>
          </div>
        <% end %>
        <div>
          <dt class="text-xs font-bold uppercase text-stone-500"><%= t(".purchase_url") %></dt>
          <dd data-testid="bean-detail-purchase-url" class="mt-1 text-sm font-semibold text-stone-950">
            <% if @bean.purchase_url.present? %>
              <%= link_to bean_purchase_url_label(@bean.purchase_url), @bean.purchase_url, target: "_blank", rel: "noopener", class: "break-words text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-700" %>
            <% else %>
              <%= t(".unknown") %>
            <% end %>
          </dd>
        </div>
      </dl>
    </section>

    <%= render "shared/record_links_list", record: @bean %>

    <section class="mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".notes") %></h2>
      <p class="mt-2 whitespace-pre-line text-stone-700"><%= @bean.notes.presence || t(".no_notes") %></p>
    </section>

    <%= render "shared/photo_grid",
      record: @bean,
      title: t(".photos"),
      section_id: "bean-photos",
      section_class: "mt-6 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "text-lg font-semibold text-stone-950" %>

    <% if current_workspace_policy.write? %>
      <section data-testid="bean-issues-zone" class="mt-6 rounded-lg border border-amber-300 bg-amber-50 p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-amber-950"><%= t(".issues") %></h2>
        <p class="mt-2 text-sm text-amber-900"><%= t(".issues_body") %></p>
        <% unless @bean.archived? %>
          <%= button_to t(".close"),
            close_bean_path(@bean),
            method: :patch,
            class: "mt-4 rounded-md border border-amber-500 bg-white px-4 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-100" %>
        <% end %>
      </section>

      <section data-testid="bean-danger-zone" class="mt-6 rounded-lg border border-red-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-red-800"><%= t(".danger_zone") %></h2>
        <p class="mt-2 text-sm text-stone-700"><%= t(".danger_zone_body", count: @bean.brews.count) %></p>
        <%= button_to t(".delete"),
          bean_path(@bean),
          method: :delete,
          form: { data: { turbo_confirm: t(".delete_confirmation", count: @bean.brews.count) } },
          class: "mt-4 rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
      </section>
    <% end %>
  </section>
</main>
