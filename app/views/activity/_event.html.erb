<% presenter = Activity::Presenter.new(event, helpers: self) %>
<% path = presenter.path %>
<% state = presenter.restricted? ? "restricted" : (path ? "linked" : "tombstone") %>
<% card = capture do %>
  <span data-testid="activity-icon-container" class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full shadow-[0_3px_0_rgba(0,0,0,0.28)] ring-2 ring-stone-800 <%= presenter.icon_container_classes %>"><%= material_symbol(presenter.icon) %></span>
  <span class="min-w-0">
    <span data-testid="activity-summary" class="block break-words text-sm font-extrabold leading-snug text-stone-50 sm:text-base"><%= presenter.summary %></span>
    <span class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs font-semibold text-stone-400">
      <span class="tabular-nums"><%= profile_timestamp(presenter.timestamp) %></span>
      <span aria-hidden="true">·</span>
      <span data-testid="activity-category-label" class="inline-flex rounded-md border border-stone-700 bg-stone-900 px-1.5 py-0.5 text-[0.68rem] font-black uppercase tracking-[0.08em] text-stone-200"><%= presenter.category_label %></span>
      <% if presenter.restricted? %><span data-testid="activity-restricted" class="inline-flex rounded-md border border-stone-700 px-1.5 py-0.5 text-[0.68rem] font-black uppercase tracking-[0.08em] text-stone-300"><%= t("activity.index.restricted") %></span><% end %>
    </span>
  </span>
<% end %>
<% state_classes = path ? "" : "bg-stone-900/45" %>
<% attributes = { data: { testid: "activity-card", visibility: event.visibility, state: }, class: "flex min-w-0 gap-3 border-b border-stone-800 px-3 py-3 last:border-b-0 sm:gap-4 sm:px-4 #{state_classes}" } %>
<% if path %>
  <%= link_to path, **attributes.merge(class: "#{attributes[:class]} transition-colors hover:bg-stone-900 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-amber-200") do %><%= card %><% end %>
<% else %>
  <%= tag.div(card, **attributes) %>
<% end %>
