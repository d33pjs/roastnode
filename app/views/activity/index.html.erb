<main class="rn-page">
  <section class="rn-shell max-w-6xl py-6 sm:px-6 lg:py-10">
    <header class="border-b border-rn-line pb-6">
      <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
      <p class="mt-4 text-sm font-extrabold uppercase tracking-[0.08em] text-rn-ink"><%= current_workspace.name %></p>
      <h1 class="mt-2 text-4xl font-black text-rn-ink"><%= t(".title") %></h1>
    </header>

    <% filter_input_class = "mt-1 w-full rounded-2xl border border-stone-700 bg-stone-900 px-3 py-2.5 text-stone-50 shadow-inner [color-scheme:dark] focus:border-amber-200 focus:outline-none focus:ring-1 focus:ring-amber-200" %>
    <%= form_with url: activity_path, method: :get, data: { testid: "activity-filter-panel" }, class: "mt-6 grid gap-3 rounded-3xl border border-stone-800 bg-stone-950 p-4 shadow-xl shadow-stone-950/15 sm:grid-cols-2 sm:p-5 lg:grid-cols-[1.15fr_1.15fr_1fr_1fr_auto]" do |form| %>
      <div>
        <%= form.label :category, t(".category"), class: "block text-xs font-extrabold uppercase tracking-[0.08em] text-stone-300" %>
        <%= form.select :category, options_for_select(ActivityEvent::CATEGORIES.map { |value| [t("activity.categories.#{value}"), value] }, params[:category]), { include_blank: t(".all_categories") }, data: { testid: "activity-category" }, class: filter_input_class %>
      </div>
      <div>
        <%= form.label :actor, t(".actor"), class: "block text-xs font-extrabold uppercase tracking-[0.08em] text-stone-300" %>
        <%= form.select :actor, options_for_select(@actor_options.map { |option| [option.label, option.value] }, params[:actor]), { include_blank: t(".all_actors") }, data: { testid: "activity-actor" }, class: filter_input_class %>
      </div>
      <div>
        <%= form.label :start_date, t(".start_date"), class: "block text-xs font-extrabold uppercase tracking-[0.08em] text-stone-300" %>
        <%= form.date_field :start_date, value: params[:start_date], data: { testid: "activity-start-date" }, class: filter_input_class %>
      </div>
      <div>
        <%= form.label :end_date, t(".end_date"), class: "block text-xs font-extrabold uppercase tracking-[0.08em] text-stone-300" %>
        <%= form.date_field :end_date, value: params[:end_date], data: { testid: "activity-end-date" }, class: filter_input_class %>
      </div>
      <%= form.submit t(".filter"), class: "self-end rounded-2xl bg-[var(--rn-honey)] px-5 py-2.5 font-extrabold text-stone-950 shadow-[0_3px_0_#713f12] hover:bg-amber-200 focus:outline-none focus:ring-2 focus:ring-amber-200 focus:ring-offset-2 focus:ring-offset-stone-950 sm:col-span-2 lg:col-span-1" %>
    <% end %>

    <% if @activity.any? %>
      <div data-testid="activity-feed-panel" class="mt-8 overflow-hidden rounded-3xl border border-stone-800 bg-stone-950 shadow-xl shadow-stone-950/15">
        <%= render partial: "activity/event", collection: @activity.records, as: :event %>
      </div>
      <%= render "shared/history_pagination", paginator: @activity, params: request.query_parameters.except("page") %>
    <% else %>
      <p data-testid="activity-empty" class="mt-8 rounded-3xl border border-stone-800 bg-stone-950 p-5 text-sm font-semibold text-stone-200 shadow-xl shadow-stone-950/15">
        <%= t(@activity_filters_active ? ".filtered_empty" : ".empty") %>
      </p>
    <% end %>
  </section>
</main>
