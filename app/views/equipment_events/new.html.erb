<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-3xl px-6 py-10">
    <%= link_to t(".back"), root_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
    <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>

    <%= form_with model: @equipment_event, class: "mt-8 grid gap-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
      <% if @equipment_event.errors.any? %>
        <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
          <%= @equipment_event.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :event_type, t(".event_type"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :event_type, EquipmentEvent.event_types.keys.map { |event_type| [ event_type.humanize, event_type ] }, {}, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :occurred_at, t(".occurred_at"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.datetime_field :occurred_at, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
        </div>
      </div>

      <fieldset>
        <legend class="text-sm font-medium text-stone-700"><%= t(".equipment") %></legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          <% @equipment_options.each do |item| %>
            <label for="<%= dom_id(item, :event) %>" class="flex items-center gap-2 rounded-md border border-stone-200 px-3 py-2 text-sm text-stone-800">
              <%= check_box_tag "equipment_event[equipment_ids][]", item.id, @equipment_event.equipment.include?(item), id: dom_id(item, :event), class: "rounded border-stone-300 text-stone-950" %>
              <span><%= item.name %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div>
        <%= form.label :notes, t(".notes"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.text_area :notes, rows: 4, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
      </div>

      <%= form.submit t(".create"), class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
    <% end %>
  </section>
</main>
