<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-3xl px-6 py-10">
    <%= link_to t(".back"), root_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>

    <article class="mt-6 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= @equipment_event.event_type.humanize %></h1>
      <p class="mt-2 text-stone-700"><%= t(".byline", user: @equipment_event.user.email_address) %></p>
      <p class="mt-1 text-sm text-stone-600"><%= l(@equipment_event.occurred_at, format: :short) %></p>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-stone-600"><%= t(".equipment") %></dt>
          <dd class="mt-1 font-semibold text-stone-950"><%= @equipment_event.equipment.map(&:name).to_sentence %></dd>
        </div>
      </dl>

      <% if @equipment_event.notes.present? %>
        <section class="mt-6 border-t border-stone-100 pt-6">
          <h2 class="font-semibold text-stone-950"><%= t(".notes") %></h2>
          <p class="mt-2 whitespace-pre-line text-stone-700"><%= @equipment_event.notes %></p>
        </section>
      <% end %>
    </article>
  </section>
</main>
