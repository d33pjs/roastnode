<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-3xl px-6 py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".edit"), edit_equipment_event_path(@equipment_event), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
      <% end %>
    </div>

    <article class="mt-6 rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= @equipment_event.event_type_summary %></h1>
      <p class="mt-2 text-stone-700"><%= t(".byline", user: @equipment_event.user.display_label) %></p>
      <p class="mt-1 text-sm text-stone-600"><%= profile_timestamp(@equipment_event.occurred_at) %></p>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-stone-600"><%= t(".equipment") %></dt>
          <dd data-testid="equipment-event-equipment" class="mt-1 flex flex-wrap gap-1.5 font-semibold text-stone-950">
            <% @equipment_event.equipment.each do |item| %>
              <%= link_to item.name, equipment_path(item), class: "rounded-full bg-stone-100 px-2.5 py-1 text-sm text-stone-800 hover:bg-stone-200" %>
            <% end %>
          </dd>
        </div>
      </dl>

      <% if @equipment_event.notes.present? %>
        <section class="mt-6 border-t border-stone-100 pt-6">
          <h2 class="font-semibold text-stone-950"><%= t(".notes") %></h2>
          <p class="mt-2 whitespace-pre-line text-stone-700"><%= @equipment_event.notes %></p>
        </section>
      <% end %>

      <%= render "shared/photo_grid",
        record: @equipment_event,
        title: t(".photos"),
        section_class: "mt-6 border-t border-stone-100 pt-6",
        title_class: "font-semibold text-stone-950" %>
    </article>

    <% if current_workspace_policy.write? %>
      <section data-testid="equipment-event-danger-zone" class="mt-6 rounded-lg border border-red-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-red-800"><%= t(".danger_zone") %></h2>
        <p class="mt-2 text-sm text-stone-700"><%= t(".danger_zone_body") %></p>
        <%= button_to t(".delete"),
          equipment_event_path(@equipment_event),
          method: :delete,
          form: { data: { turbo_confirm: t(".delete_confirmation") } },
          class: "mt-4 rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
      </section>
    <% end %>
  </section>
</main>
