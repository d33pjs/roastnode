<main class="rn-page overflow-x-hidden">
  <section class="rn-shell max-w-3xl py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link",
      label: t(".back"),
      path: equipment_event_path(@equipment_event),
      prefer_referrer: @equipment_event.errors.empty? %>
    <div class="mt-5">
      <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
    </div>

    <%= render "shared/photo_grid",
      record: @equipment_event,
      title: t(".photos"),
      section_class: "mt-6 rounded-2xl border border-rn-line bg-rn-surface p-5 shadow-sm",
      title_class: "font-extrabold text-rn-ink" %>

    <%= render "form", equipment_event: @equipment_event, submit_label: t(".update") %>
  </section>
</main>
