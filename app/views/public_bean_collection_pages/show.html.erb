<% content_for :hide_app_navigation, true %>
<% content_for :title, @snapshot["title"].presence || t("bean_collections.public.default_title") %>
<% content_for :head do %><meta name="robots" content="noindex, nofollow"><% end %>
<%= render "public_bean_collection_pages/styles" %>
<% snapshot = @snapshot || {} %>
<main class="rn-page collection-page" data-testid="public-bean-collection">
  <div class="rn-shell">
    <% if @preview %>
      <aside class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-rn-line bg-[var(--rn-surface-muted)] p-4" data-testid="collection-preview-banner">
        <p class="text-sm font-bold"><%= t("bean_collections.public.preview_notice") %></p>
        <%= link_to t("bean_collections.public.back_to_editor"), edit_public_bean_collection_path, class: "collection-link text-sm" %>
      </aside>
    <% end %>
    <header class="flex items-center justify-between gap-6 border-b border-rn-line py-4">
      <%= render "shared/brand_wordmark", container_class: "block h-8 w-36 sm:h-10 sm:w-44", image_class: "h-full w-full object-contain object-left" %>
      <% if snapshot.dig("workspace", "name").present? %>
        <p class="text-right text-sm font-bold text-rn-muted"><%= snapshot.dig("workspace", "name") %></p>
      <% end %>
    </header>
    <section class="collection-hero" aria-labelledby="collection-title">
      <p class="collection-eyebrow mb-4"><%= t("bean_collections.public.eyebrow") %></p>
      <h1 id="collection-title" class="collection-title"><%= snapshot["title"].presence || t("bean_collections.public.default_title") %></h1>
      <% if snapshot["description"].present? %><p class="collection-description mt-6"><%= snapshot["description"] %></p><% end %>
      <p class="mt-6 text-sm font-semibold text-rn-muted"><%= t("bean_collections.public.coffee_count", count: @total_groups.to_i) %> <span aria-hidden="true">·</span> <%= t("bean_collections.public.personal_experience") %></p>
    </section>
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <nav class="collection-tabs" aria-label="<%= t("bean_collections.public.views") %>">
        <%= link_to t("bean_collections.public.top_ten"), collection_public_path("top"), class: "collection-tab", aria: { current: @view == "top" ? "page" : nil } %>
        <%= link_to t("bean_collections.public.all_coffees"), collection_public_path("all"), class: "collection-tab", aria: { current: @view == "all" ? "page" : nil } %>
      </nav>
      <p class="text-xs font-semibold text-rn-muted"><%= t("bean_collections.public.ranked_by") %></p>
    </div>
    <% if Array(@groups).any? %>
      <div class="grid gap-5">
        <% unranked_heading_shown = false %>
        <% Array(@groups).each do |group| %>
          <% if group["rank"].blank? && !unranked_heading_shown %>
            <h2 class="collection-eyebrow mt-5 mb-1"><%= t("bean_collections.public.unrated_coffees") %></h2>
            <% unranked_heading_shown = true %>
          <% end %>
          <%= render "public_bean_collection_pages/group", group: %>
        <% end %>
      </div>
    <% else %>
      <section class="rounded-3xl border border-dashed border-rn-line bg-rn-surface px-6 py-16 text-center">
        <p class="collection-eyebrow"><%= t("bean_collections.public.empty_eyebrow") %></p>
        <h2 class="mt-3 text-3xl font-black tracking-tight"><%= t("bean_collections.public.empty_title") %></h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-rn-muted"><%= t(@view == "top" ? "bean_collections.public.empty_top" : "bean_collections.public.empty_body") %></p>
        <% if @view == "top" && @total_groups.to_i.positive? %><%= link_to t("bean_collections.public.all_coffees"), collection_public_path("all"), class: "collection-link mt-5 inline-block text-sm" %><% end %>
      </section>
    <% end %>
    <details class="collection-details mt-10 border-b border-rn-line">
      <summary><%= t("bean_collections.public.methodology_title") %></summary>
      <div class="max-w-3xl px-5 pb-6 text-sm leading-relaxed text-rn-muted">
        <p><%= t("bean_collections.public.methodology") %></p>
        <p class="mt-3"><%= t("bean_collections.public.disclaimer") %></p>
        <% if (date = collection_date(snapshot["generated_at"])).present? %><p class="mt-3"><%= t("bean_collections.public.updated", date:) %></p><% end %>
      </div>
    </details>
  </div>
</main>
