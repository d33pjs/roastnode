<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-2xl px-6 py-10">
    <%= render "shared/back_link", label: t(".back"), path: bean_path(@bean) %>
    <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>
    <p class="mt-2 text-stone-700"><%= @bean.display_name %></p>

    <%= render "form", bean: @bean, inventory_adjustment: @inventory_adjustment, submit_label: t(".create") %>
  </section>
</main>
