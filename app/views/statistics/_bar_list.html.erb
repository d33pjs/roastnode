<% if values.any? %>
  <div class="space-y-3">
    <% values.each do |label, count| %>
      <div class="min-w-0"><div class="flex min-w-0 items-center justify-between gap-4 text-sm"><span class="min-w-0 font-bold text-rn-ink"><%= label.to_s.humanize %></span><span class="shrink-0 text-rn-muted"><%= count %></span></div><div class="mt-1.5 h-2 overflow-hidden rounded-full bg-[var(--rn-surface-muted)]"><div class="h-full rounded-full bg-[var(--rn-accent-strong)]" style="width: <%= statistics_bar_width(count, maximum) %>%"></div></div></div>
    <% end %>
  </div>
<% else %>
  <p class="text-sm text-rn-muted"><%= empty_label %></p>
<% end %>
