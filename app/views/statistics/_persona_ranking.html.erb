<section aria-labelledby="statistics-persona-<%= kind %>-heading" class="min-w-0 rounded-2xl border border-rn-line bg-rn-surface p-4 sm:p-5">
  <h3 id="statistics-persona-<%= kind %>-heading" class="text-xl font-black text-rn-ink"><%= t("statistics.personas.#{kind}_title") %></h3>
  <p class="mt-1 text-sm leading-5 text-rn-muted"><%= t("statistics.personas.#{kind}_help") %></p>
  <ol data-testid="statistics-persona-<%= kind %>" class="mt-5 max-h-96 space-y-5 overflow-y-auto pr-1" aria-label="<%= t("statistics.personas.#{kind}_title") %>" tabindex="0">
    <% people.each_with_index do |person, index| %>
      <li class="min-w-0">
        <div class="flex min-w-0 items-start justify-between gap-4">
          <span class="flex min-w-0 items-baseline gap-2 text-sm font-extrabold text-rn-ink"><span class="shrink-0 text-xs font-semibold tabular-nums text-rn-muted" aria-hidden="true"><%= format("%02d", index + 1) %></span><span class="min-w-0 break-words"><%= person[:label] %></span></span>
          <span class="shrink-0 text-lg font-black tabular-nums leading-5 text-rn-ink"><%= person[:count] %><span class="sr-only"> <%= t("statistics.personas.coffees") %></span></span>
        </div>
        <div aria-hidden="true" class="mt-2 h-2 overflow-hidden rounded-full bg-[var(--rn-surface-muted)]">
          <div class="h-full rounded-full bg-[var(--rn-accent-strong)]" style="width: <%= statistics_bar_width(person[:count], people.first[:count]) %>%"></div>
        </div>
        <p class="mt-2 text-xs leading-5 text-rn-muted">
          <% if kind == :makers %>
            <%= t("statistics.personas.maker_breakdown", self_count: person[:self_count], others_count: person[:others_count]) %>
          <% else %>
            <%= t("statistics.personas.beans_tried", count: person[:bean_count]) %> · <%= t("statistics.personas.rated_coffees", count: person[:rated_count]) %>
          <% end %>
        </p>
      </li>
    <% end %>
  </ol>
</section>
