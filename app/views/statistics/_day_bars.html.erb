<% empty_label = local_assigns.fetch(:empty_label, t("statistics.index.no_day_series_data")) %>
<% visible_points = points.last(10) %>
<% visible_maximum = visible_points.map { |point| point[value_key] }.compact.max %>
<% if visible_maximum.to_f.positive? %>
  <div class="space-y-2">
    <% visible_points.each do |point| %>
      <% value = point[value_key] %>
      <div data-testid="statistics-day-series-point" class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 text-sm sm:grid-cols-[5.5rem_minmax(0,1fr)_3rem]">
        <span class="min-w-0 text-rn-muted"><%= l(point[:date], format: :short) %></span>
        <div class="order-3 col-span-2 h-2 min-w-0 overflow-hidden rounded-full bg-[var(--rn-surface-muted)] sm:order-none sm:col-span-1">
          <div class="h-full rounded-full bg-[var(--rn-accent-strong)]" style="width: <%= statistics_bar_width(value, visible_maximum) %>%"></div>
        </div>
        <span class="text-right font-bold text-rn-ink"><%= suffix.present? ? profile_number(value, precision: 1) : value %><%= suffix %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <p data-testid="statistics-day-series-empty" class="text-sm text-rn-muted"><%= empty_label %></p>
<% end %>
