<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-6xl px-6 py-10">
    <header class="border-b border-stone-200 pb-8">
      <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
      <p class="mt-4 text-sm font-semibold uppercase text-stone-600"><%= current_workspace.name %></p>
      <h1 class="mt-2 text-4xl font-bold text-stone-950"><%= t(".title") %></h1>
      <div class="mt-4">
        <%= link_to t(".all_brews"),
          brews_path,
          data: { testid: "statistics-all-brews-button" },
          class: "inline-flex rounded-lg bg-stone-950 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
      </div>
      <%= form_with url: statistics_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
        <div>
          <%= form.label :start_date, t(".start_date"), class: "block text-sm font-semibold uppercase text-stone-600" %>
          <%= form.date_field :start_date, value: @statistics_start_date.iso8601, data: { testid: "statistics-start-date" }, class: "mt-1 rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 shadow-sm" %>
        </div>
        <div>
          <%= form.label :end_date, t(".end_date"), class: "block text-sm font-semibold uppercase text-stone-600" %>
          <%= form.date_field :end_date, value: @statistics_end_date.iso8601, data: { testid: "statistics-end-date" }, class: "mt-1 rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 shadow-sm" %>
        </div>
        <%= form.submit t(".apply_filters"), class: "rounded-lg bg-stone-950 px-4 py-2 font-semibold text-white shadow-sm" %>
        <%= link_to t(".reset_timerange"), statistics_path, class: "rounded-lg border border-stone-300 bg-white px-4 py-2 font-semibold text-stone-950 shadow-sm" %>
      <% end %>
      <div data-testid="statistics-timeframes" class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold uppercase text-stone-600"><%= t(".quick_timeframes") %></span>
        <% @statistics_timeframe_options.each do |timeframe| %>
          <% active = @statistics_timeframe == timeframe %>
          <%= link_to t(".timeframes.#{timeframe}"),
            statistics_path(timeframe:),
            aria: { current: active ? "page" : nil },
            data: { testid: "statistics-timeframe-#{timeframe}" },
            class: [
              "rounded-lg border px-3 py-1.5 text-sm font-semibold shadow-sm",
              active ? "border-stone-950 bg-stone-950 text-white" : "border-stone-300 bg-white text-stone-950 hover:bg-stone-100"
            ] %>
        <% end %>
      </div>
    </header>

    <section class="grid gap-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
      <div data-testid="statistics-total-brews-card" class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <p class="text-sm font-semibold uppercase text-stone-700"><%= t(".total_brews") %></p>
          <%= link_to t(".view_all"), brews_path, class: "text-sm font-semibold text-stone-950 underline decoration-stone-300 underline-offset-2 hover:decoration-stone-950" %>
        </div>
        <p data-testid="total-brews" class="mt-2 text-3xl font-bold text-stone-950"><%= @statistics[:totals][:total_brews] %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".total_ground") %></p>
        <p data-testid="total-ground" class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_grams(@statistics[:totals][:total_bean_weight_grams]) %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".open_beans") %></p>
        <% if @statistics[:totals][:open_beans].positive? %>
          <p data-testid="open-beans" class="mt-2 text-3xl font-bold text-stone-950"><%= @statistics[:totals][:open_beans] %></p>
        <% else %>
          <p data-testid="open-beans" class="mt-2 text-base font-semibold text-stone-700"><%= t(".no_open_beans") %></p>
        <% end %>
        <p class="mt-1 text-sm text-stone-600"><%= t(".current_inventory_note") %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".known_spend") %></p>
        <% if @statistics[:totals][:known_spend_bean_count].positive? %>
          <p data-testid="known-spend" class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_money(@statistics[:totals][:known_spend_cents]) %></p>
        <% else %>
          <p data-testid="known-spend" class="mt-2 text-base font-semibold text-stone-700"><%= t(".no_known_spend") %></p>
        <% end %>
        <p class="mt-1 text-sm text-stone-600"><%= t(".current_inventory_note") %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".average_brew_cost") %></p>
        <% if @statistics[:totals][:priced_brew_count].positive? %>
          <p data-testid="average-brew-cost" class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_money(@statistics[:totals][:average_known_brew_cost_cents]) %></p>
        <% else %>
          <p data-testid="average-brew-cost" class="mt-2 text-base font-semibold text-stone-700"><%= t(".no_average_brew_cost") %></p>
        <% end %>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".channeling_rate") %></p>
        <p class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_percent(@statistics[:rates][:channeling_percent]) %></p>
      </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".equipment") %></h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <% { grinder: t(".most_used_grinder"), machine: t(".most_used_machine") }.each do |key, label| %>
            <% leader = @statistics[:leaders][key] %>
            <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
              <p class="text-sm font-semibold uppercase text-stone-600"><%= label %></p>
              <p class="mt-2 text-2xl font-bold text-stone-950"><%= leader&.fetch(:name) || t(".unknown") %></p>
              <p class="mt-1 text-sm text-stone-600"><%= t(".brew_count", count: leader&.fetch(:count) || 0) %></p>
            </div>
          <% end %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".markers") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/bar_list", values: @statistics[:distributions][:retention_marker], maximum: @statistics[:distributions][:retention_marker].values.max, empty_label: t(".no_data") %>
        </div>
      </section>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".brews_by_day") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/day_bars", points: @statistics[:series][:brews_by_day], value_key: :count, maximum: @statistics[:series][:brews_by_day].map { |point| point[:count] }.max, suffix: "" %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".consumption_by_day") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/day_bars", points: @statistics[:series][:consumption_by_day], value_key: :grams, maximum: @statistics[:series][:consumption_by_day].map { |point| point[:grams] }.max, suffix: "g" %>
        </div>
      </section>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".taste_balance") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/bar_list", values: @statistics[:distributions][:taste_balance], maximum: @statistics[:distributions][:taste_balance].values.max, empty_label: t(".no_data") %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".beans") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <% { roasters: t(".roasters"), origins: t(".origins"), processes: t(".processes") }.each do |key, label| %>
            <div class="mb-5 last:mb-0">
              <h3 class="text-sm font-semibold uppercase text-stone-600"><%= label %></h3>
              <%= render "statistics/breakdown_list", values: @statistics[:breakdowns][key] %>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  </section>
</main>
