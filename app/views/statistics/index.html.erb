<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-6xl px-6 py-10">
    <header class="border-b border-stone-200 pb-8">
      <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
      <p class="mt-4 text-sm font-semibold uppercase text-stone-600"><%= current_workspace.name %></p>
      <h1 class="mt-2 text-4xl font-bold text-stone-950"><%= t(".title") %></h1>
    </header>

    <section class="grid gap-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".total_brews") %></p>
        <p data-testid="total-brews" class="mt-2 text-3xl font-bold text-stone-950"><%= @statistics[:totals][:total_brews] %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".total_ground") %></p>
        <p data-testid="total-ground" class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_grams(@statistics[:totals][:total_bean_weight_grams]) %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".open_beans") %></p>
        <p data-testid="open-beans" class="mt-2 text-3xl font-bold text-stone-950"><%= @statistics[:totals][:open_beans] %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".known_spend") %></p>
        <p class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_money(@statistics[:totals][:known_spend_cents]) %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".average_brew_cost") %></p>
        <p class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_money(@statistics[:totals][:average_known_brew_cost_cents]) %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".channeling_rate") %></p>
        <p class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_percent(@statistics[:rates][:channeling_percent]) %></p>
      </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".equipment") %></h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <% { grinder: t(".most_used_grinder"), machine: t(".most_used_machine") }.each do |key, label| %>
            <% leader = @statistics[:leaders][key] %>
            <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
              <p class="text-sm font-semibold uppercase text-stone-600"><%= label %></p>
              <p class="mt-2 text-2xl font-bold text-stone-950"><%= leader&.fetch(:name) || t(".unknown") %></p>
              <p class="mt-1 text-sm text-stone-600"><%= t(".brew_count", count: leader&.fetch(:count) || 0) %></p>
            </div>
          <% end %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".markers") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/bar_list", values: @statistics[:distributions][:retention_marker], maximum: @statistics[:distributions][:retention_marker].values.max, empty_label: t(".no_data") %>
        </div>
      </section>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".brews_by_day") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/day_bars", points: @statistics[:series][:brews_by_day], value_key: :count, maximum: @statistics[:series][:brews_by_day].map { |point| point[:count] }.max, suffix: "" %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".consumption_by_day") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/day_bars", points: @statistics[:series][:consumption_by_day], value_key: :grams, maximum: @statistics[:series][:consumption_by_day].map { |point| point[:grams] }.max, suffix: "g" %>
        </div>
      </section>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".taste_balance") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <%= render "statistics/bar_list", values: @statistics[:distributions][:taste_balance], maximum: @statistics[:distributions][:taste_balance].values.max, empty_label: t(".no_data") %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".beans") %></h2>
        <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
          <% { roasters: t(".roasters"), origins: t(".origins"), processes: t(".processes") }.each do |key, label| %>
            <div class="mb-5 last:mb-0">
              <h3 class="text-sm font-semibold uppercase text-stone-600"><%= label %></h3>
              <%= render "statistics/breakdown_list", values: @statistics[:breakdowns][key] %>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  </section>
</main>
