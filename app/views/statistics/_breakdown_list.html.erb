<% if values.any? %>
  <div class="mt-2 flex flex-wrap gap-2">
    <% values.first(5).each do |value| %>
      <span class="rounded-full border border-stone-200 px-3 py-1 text-sm font-medium text-stone-800">
        <%= value[:label] %> · <%= value[:count] %>
      </span>
    <% end %>
  </div>
<% else %>
  <p class="mt-2 text-sm text-stone-600"><%= t("statistics.index.no_data") %></p>
<% end %>
