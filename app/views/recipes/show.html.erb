<main class="rn-page">
  <section class="rn-shell max-w-6xl py-6 sm:px-6 lg:py-10">
    <div>
      <div data-testid="recipe-detail-header-controls" class="flex items-center justify-between gap-3">
        <%= render "shared/back_link", label: t(".back"), path: recipes_path %>

        <% if current_workspace_policy.write? %>
          <% recipe_actions = [
            {
              icon: "local_cafe",
              label: t(".log"),
              path: log_recipe_path(@recipe),
              primary: true,
              testid: "recipe-log-link-#{@recipe.id}"
            },
            {
              icon: "edit",
              label: t(".edit"),
              path: edit_recipe_path(@recipe),
              testid: "recipe-edit-link-#{@recipe.id}"
            },
            {
              icon: "file_download",
              label: t(".export"),
              path: export_recipe_path(@recipe),
              testid: "recipe-export-link-#{@recipe.id}"
            }
          ] %>
          <% if current_workspace_policy.manage? || @recipe.created_by_id == Current.user.id %>
            <% public_share_path = @recipe.public_recipe_share.present? ? edit_recipe_public_recipe_share_path(@recipe) : new_recipe_public_recipe_share_path(@recipe) %>
            <% recipe_actions << {
              icon: "public",
              label: t(".share_publicly"),
              path: public_share_path,
              testid: "recipe-share-public-link-#{@recipe.id}"
            } %>
          <% end %>
          <%= render "shared/detail_actions", testid: "recipe-detail-actions", actions: recipe_actions %>
        <% end %>
      </div>
      <div class="min-w-0">
        <p class="mt-4 text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
        <h1 class="mt-2 text-3xl font-black leading-tight text-rn-ink sm:text-4xl"><%= @recipe.title %></h1>
      </div>
    </div>

    <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div class="grid gap-5">
        <section class="rounded-3xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5">
          <h2 class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".details") %></h2>

          <dl class="mt-4 grid gap-3 sm:grid-cols-2">
            <% bean = @recipe.profile["bean"] || {} %>
            <% equipment = @recipe.profile["equipment"] || {} %>
            <% grinder = equipment["grinder"] || {} %>
            <% machine = equipment["machine"] || {} %>
            <% source = @recipe.profile["source_brew"] || {} %>
            <div>
              <dt class="text-xs font-bold uppercase text-rn-muted"><%= t(".bean") %></dt>
              <dd class="mt-1 text-sm font-semibold text-rn-ink"><%= bean["display_name"].presence || bean["name"].presence || t(".unknown") %></dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase text-rn-muted"><%= t(".grinder") %></dt>
              <dd class="mt-1 text-sm font-semibold text-rn-ink"><%= grinder["name"].presence || t(".unknown") %></dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase text-rn-muted"><%= t(".machine") %></dt>
              <dd class="mt-1 text-sm font-semibold text-rn-ink"><%= machine["name"].presence || t(".unknown") %></dd>
            </div>
            <div>
              <dt class="text-xs font-bold uppercase text-rn-muted"><%= t(".rating") %></dt>
              <dd class="mt-1 text-sm font-semibold text-rn-ink"><%= source["rating"].presence || t(".unknown") %></dd>
            </div>
          </dl>

          <% if @recipe.source_brew.present? %>
            <div class="mt-5 border-t border-rn-line pt-4">
              <%= link_to t(".source_brew"), brew_path(@recipe.source_brew), class: "text-sm font-extrabold text-rn-ink underline decoration-rn-line underline-offset-4 hover:decoration-rn-ink" %>
            </div>
          <% end %>

          <% if @recipe.record_links.ordered.any? %>
            <div class="mt-5 border-t border-rn-line pt-4">
              <h3 class="text-xs font-bold uppercase text-rn-muted"><%= t("shared.record_links.title") %></h3>
              <div class="mt-2 flex flex-wrap gap-2">
                <% @recipe.record_links.ordered.each do |link| %>
                  <%= link_to link.label, link.url, target: "_blank", rel: "noopener", class: "rounded-full border border-rn-line bg-[var(--rn-canvas)] px-3 py-1.5 text-sm font-bold text-rn-ink hover:bg-[var(--rn-surface-muted)]" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </section>

        <%= render "recipes/finish_card", recipe: @recipe %>

        <% if @recipe.primary_photo_attachment.present? %>
          <% photo_url = media_attachment_path(@recipe.primary_photo_attachment) %>
          <div data-controller="photo-lightbox" data-photo-lightbox-sources-value="<%= [ photo_url ].to_json %>" data-action="keydown@window->photo-lightbox#closeFromKeyboard" class="mt-4">
            <button type="button" data-action="photo-lightbox#open" data-photo-lightbox-index-param="0" data-full-src="<%= photo_url %>" aria-label="<%= t("shared.photo_grid.open_photo") %>" class="block h-64 w-full rounded-lg bg-[var(--rn-surface-muted)] p-2">
              <%= image_tag media_attachment_path(@recipe.primary_photo_attachment, variant: :thumbnail), alt: "", data: { testid: "recipe-finished-photo" }, class: "h-full w-full object-contain" %>
            </button>
            <%= render "shared/photo_lightbox" %>
          </div>
        <% end %>
      </div>

      <%= render "recipes/target_guide", recipe: @recipe %>
    </div>
  </section>
</main>
