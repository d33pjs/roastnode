<main class="rn-page overflow-x-hidden">
  <section class="rn-shell max-w-6xl py-5 sm:px-6 lg:py-10">
    <header class="mb-5 flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
        <p class="mt-4 text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
        <h1 class="mt-2 text-3xl font-black leading-tight text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
        <p class="mt-1 text-sm font-semibold text-rn-muted"><%= current_workspace.name %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <%= form_with url: import_recipes_path, scope: :recipe_import, multipart: true, class: "grid gap-2 rounded-2xl border border-rn-line bg-rn-surface p-3 shadow-sm" do |form| %>
          <%= form.label :file, t(".import"), class: "text-xs font-extrabold uppercase tracking-[0.08em] text-rn-muted" %>
          <%= form.file_field :file, accept: "application/json,.json", class: "block w-full text-sm font-bold text-rn-muted file:mr-3 file:rounded-full file:border-0 file:bg-[var(--rn-accent-strong)] file:px-3 file:py-2 file:text-sm file:font-extrabold file:text-[#f8faf6] hover:file:opacity-90" %>
          <%= form.submit t(".import_submit"), class: "rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-2 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)]" %>
        <% end %>
      <% end %>
    </header>

    <div class="grid max-w-full min-w-0 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% if @recipes.any? %>
        <% @recipes.each do |recipe| %>
          <% targets = recipe.profile.fetch("targets", {}) %>
          <%= link_to recipe_path(recipe), class: "block max-w-full min-w-0 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm hover:bg-[var(--rn-surface-muted)]" do %>
            <div class="min-w-0">
              <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= recipe.method.humanize %></p>
              <h2 class="mt-1 truncate text-xl font-black text-rn-ink"><%= recipe.title %></h2>
            </div>

            <div class="mt-4 grid grid-cols-3 gap-2">
              <div class="rounded-xl border border-rn-line bg-rn-canvas p-3">
                <p class="text-[0.68rem] font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".dose") %></p>
                <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= targets["dose_grams"].presence || t(".unknown") %></p>
              </div>
              <div class="rounded-xl border border-rn-line bg-rn-canvas p-3">
                <p class="text-[0.68rem] font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".yield") %></p>
                <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= targets["beverage_grams"].presence || t(".unknown") %></p>
              </div>
              <div class="rounded-xl border border-rn-line bg-rn-canvas p-3">
                <p class="text-[0.68rem] font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".time") %></p>
                <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= targets["total_time_seconds"].presence || t(".unknown") %></p>
              </div>
            </div>

            <% if recipe.source_brew.present? %>
              <p class="mt-3 truncate text-xs font-bold text-rn-muted"><%= t("recipes.show.source_brew") %>: #<%= recipe.source_brew_id %></p>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <p class="rounded-2xl border border-rn-line bg-rn-surface p-4 text-sm font-semibold text-rn-muted"><%= t(".empty") %></p>
      <% end %>
    </div>
  </section>
</main>
