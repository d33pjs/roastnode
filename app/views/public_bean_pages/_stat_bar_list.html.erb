<% distribution = local_assigns.fetch(:distribution, {}) || {} %>
<% max_count = distribution.values.map(&:to_i).max.to_i %>

<section data-testid="<%= local_assigns.fetch(:testid) %>" class="rounded-lg border border-stone-300 bg-white p-4">
  <h2 class="text-xs font-black uppercase text-stone-500"><%= local_assigns.fetch(:title) %></h2>

  <% if distribution.any? %>
    <div class="mt-4 grid gap-3">
      <% distribution.each do |label, count| %>
        <% width = max_count.positive? ? ((count.to_f / max_count) * 100).round : 0 %>
        <div>
          <div class="flex items-center justify-between gap-3 text-sm font-extrabold">
            <span class="min-w-0 truncate"><%= label.to_s.humanize %></span>
            <span class="shrink-0 text-stone-600"><%= count %></span>
          </div>
          <div class="mt-1 h-2 rounded-full bg-stone-100">
            <div class="h-2 rounded-full bg-stone-950" style="width: <%= width %>%"></div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm font-bold text-stone-500"><%= t("public_bean_pages.show.unknown") %></p>
  <% end %>
</section>
