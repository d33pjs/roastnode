<% brew = local_assigns.fetch(:brew) %>
<% share = local_assigns.fetch(:share) %>
<% user = brew["user"].is_a?(Hash) ? brew["user"] : {} %>
<% recipient = brew["recipient"].is_a?(Hash) ? brew["recipient"] : {} %>
<% equipment = brew["equipment"] || {} %>
<% public_share = brew["public_share"] || {} %>
<% method = brew["method"].presence || "unknown" %>
<% unknown = t("public_bean_pages.show.unknown") %>
<% occurred_at = public_bean_time(brew["occurred_at"]) %>
<% date_label = occurred_at ? l(occurred_at, format: :short) : unknown %>
<% public_share_title = public_share["title"].presence || t("public_bean_pages.show.public_brew_page") %>
<% public_share_path = public_brew_page_path(public_share["token"]) if public_share["token"].present? %>
<% metrics = if method == "espresso"
  [
    [ t("public_bean_pages.show.rating"), public_bean_rating(brew["rating"]), "public-bean-brew-rating-metric" ],
    [ t("public_bean_pages.show.dose"), public_bean_grams(brew["dose_grams"].presence || brew["bean_weight_grams"]) ],
    [ t("public_bean_pages.show.ratio"), public_bean_ratio(brew) ],
    [ t("public_bean_pages.show.grind"), brew["grind_setting"].presence || unknown ],
    [ t("public_bean_pages.show.time"), public_bean_seconds(brew["total_time_seconds"]) ],
    [ t("public_bean_pages.show.yield"), public_bean_grams(brew["beverage_grams"]) ]
  ]
else
  [
    [ t("public_bean_pages.show.rating"), public_bean_rating(brew["rating"]), "public-bean-brew-rating-metric" ],
    [ t("public_bean_pages.show.machine_cups"), brew["machine_cups"].presence || unknown ],
    [ t("public_bean_pages.show.coffee"), public_bean_grams(brew["bean_weight_grams"]) ],
    [ t("public_bean_pages.show.yield"), public_bean_grams(brew["beverage_grams"]) ],
    [ t("public_bean_pages.show.time"), public_bean_seconds(brew["total_time_seconds"]) ],
    [ t("public_bean_pages.show.grind"), brew["grind_setting"].presence || unknown ]
  ]
end %>

<article data-testid="public-bean-brew-compact-card" data-method="<%= method %>" class="overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
  <div class="p-4 hover:bg-[var(--rn-surface-muted)] sm:p-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p data-testid="public-bean-brew-date-chip" class="text-xs font-extrabold uppercase text-rn-muted"><%= date_label %></p>
          <% if public_share_path.present? %>
            <%= link_to public_share_title,
              public_share_path,
              target: "_blank",
              rel: "noopener",
              data: { testid: "public-bean-brew-public-link" },
              class: "rounded-full bg-[var(--rn-accent-strong)] px-2.5 py-1 text-[0.65rem] font-extrabold uppercase text-[#f8faf6] hover:opacity-90" %>
          <% end %>
          <span data-testid="public-bean-brew-method-chip" class="rounded-full bg-[var(--rn-surface-muted)] px-2 py-0.5 text-[0.65rem] font-extrabold uppercase text-rn-muted"><%= public_bean_method_label(method) %></span>
        </div>
        <h3 class="mt-2 truncate text-xl font-black text-rn-ink"><%= public_bean_method_label(method) %></h3>
        <div data-testid="public-bean-brew-recipient-byline" class="mt-2 flex min-w-0 items-start gap-1.5 text-sm font-semibold text-rn-muted">
          <% if (logger_avatar_url = public_bean_media_url_for(share, user["avatar_attachment_id"], variant: :thumbnail)).present? %>
            <%= image_tag logger_avatar_url, alt: "", data: { testid: "public-bean-brew-logger-avatar" }, class: "h-7 w-7 shrink-0 rounded-full object-contain ring-1 ring-rn-line" %>
          <% end %>
          <% if recipient["kind"] == "household_member" && (recipient_avatar_url = public_bean_media_url_for(share, recipient["avatar_attachment_id"], variant: :thumbnail)).present? %>
            <%= image_tag recipient_avatar_url, alt: "", data: { testid: "public-bean-brew-recipient-avatar" }, class: "h-7 w-7 shrink-0 rounded-full object-contain ring-1 ring-rn-line" %>
          <% end %>
          <span class="min-w-0 break-words leading-5"><%= public_bean_recipient_byline(user, recipient) %></span>
        </div>
      </div>

    </div>

    <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
      <% metrics.each do |label, value, testid| %>
        <div <% if testid.present? %>data-testid="<%= testid %>"<% end %> class="min-w-0 rounded-xl border border-rn-line bg-rn-canvas p-3">
          <p class="text-xs font-extrabold uppercase text-rn-muted"><%= label %></p>
          <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= value %></p>
        </div>
      <% end %>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs font-extrabold text-rn-muted">
      <% if brew["taste_balance"].present? %>
        <span class="rounded-full bg-[var(--rn-surface-muted)] px-3 py-1"><%= t("public_bean_pages.show.taste_balance") %>: <%= brew["taste_balance"].to_s.humanize %></span>
      <% end %>
      <% if method == "espresso" && !brew["channeling"].nil? %>
        <span class="rounded-full bg-[var(--rn-surface-muted)] px-3 py-1"><%= t("public_bean_pages.show.channeling") %>: <%= brew["channeling"] ? t("public_bean_pages.show.yes") : t("public_bean_pages.show.no") %></span>
      <% end %>
      <% if equipment.dig("grinder", "name").present? %>
        <span class="rounded-full bg-[var(--rn-surface-muted)] px-3 py-1"><%= t("public_bean_pages.show.grinder") %>: <%= equipment.dig("grinder", "name") %></span>
      <% end %>
      <% if equipment.dig("machine", "name").present? %>
        <span class="rounded-full bg-[var(--rn-surface-muted)] px-3 py-1"><%= t("public_bean_pages.show.machine") %>: <%= equipment.dig("machine", "name") %></span>
      <% end %>
      <% if equipment.dig("brewer", "name").present? %>
        <span class="rounded-full bg-[var(--rn-surface-muted)] px-3 py-1"><%= t("public_bean_pages.show.brewer") %>: <%= equipment.dig("brewer", "name") %></span>
      <% end %>
    </div>

    <% if brew["public_note"].present? %>
      <p class="mt-3 whitespace-pre-line text-sm font-semibold leading-6 text-rn-muted"><%= brew["public_note"] %></p>
    <% end %>
  </div>
</article>
