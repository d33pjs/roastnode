<% brew = local_assigns.fetch(:brew) %>
<% share = local_assigns.fetch(:share) %>
<% user = brew["user"] || {} %>
<% equipment = brew["equipment"] || {} %>
<% method = brew["method"].presence || "unknown" %>

<article data-testid="public-bean-brew-card" data-method="<%= method %>" class="rounded-lg border border-stone-300 bg-white p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="text-xs font-black uppercase text-stone-500"><%= public_bean_date(brew["occurred_at"]) || t("public_bean_pages.show.unknown") %></p>
      <h3 class="mt-1 text-xl font-black"><%= public_bean_method_label(method) %></h3>
      <% if brew["public_note"].present? %>
        <p class="mt-3 whitespace-pre-line text-sm font-semibold leading-6 text-stone-700"><%= brew["public_note"] %></p>
      <% end %>
    </div>

    <% if user["display_label"].present? || user["avatar_attachment_id"].present? %>
      <div class="flex min-w-0 items-center gap-2 sm:justify-end">
        <% if (avatar_url = public_bean_media_url_for(share, user["avatar_attachment_id"], variant: :thumbnail)).present? %>
          <%= image_tag avatar_url, alt: "", class: "h-9 w-9 shrink-0 rounded-full object-contain" %>
        <% end %>
        <span class="truncate text-sm font-extrabold text-stone-700"><%= user["display_label"] %></span>
      </div>
    <% end %>
  </div>

  <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
      <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.bean") %></p>
      <p class="mt-1 text-sm font-black"><%= public_bean_grams(brew["bean_weight_grams"]) %></p>
    </div>
    <% if method == "espresso" %>
      <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
        <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.yield") %></p>
        <p class="mt-1 text-sm font-black"><%= public_bean_grams(brew["beverage_grams"]) %></p>
      </div>
      <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
        <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.time") %></p>
        <p class="mt-1 text-sm font-black"><%= public_bean_seconds(brew["total_time_seconds"]) %></p>
      </div>
      <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
        <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.grind") %></p>
        <p class="mt-1 text-sm font-black"><%= brew["grind_setting"].presence || t("public_bean_pages.show.unknown") %></p>
      </div>
    <% else %>
      <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
        <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.machine_cups") %></p>
        <p class="mt-1 text-sm font-black"><%= brew["machine_cups"].presence || t("public_bean_pages.show.unknown") %></p>
      </div>
      <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
        <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.total_time") %></p>
        <p class="mt-1 text-sm font-black"><%= public_bean_seconds(brew["total_time_seconds"]) %></p>
      </div>
      <div class="rounded-lg bg-[#f6f4ef] px-3 py-2">
        <p class="text-xs font-black uppercase text-stone-500"><%= t("public_bean_pages.show.rating") %></p>
        <p class="mt-1 text-sm font-black"><%= public_bean_rating(brew["rating"]) %></p>
      </div>
    <% end %>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs font-extrabold text-stone-700">
    <% if brew["taste_balance"].present? %>
      <span class="rounded-full border border-stone-300 px-3 py-1"><%= t("public_bean_pages.show.taste_balance") %>: <%= brew["taste_balance"].to_s.humanize %></span>
    <% end %>
    <% if brew["rating"].present? %>
      <span class="rounded-full border border-stone-300 px-3 py-1"><%= t("public_bean_pages.show.rating") %>: <%= public_bean_rating(brew["rating"]) %></span>
    <% end %>
    <% if method == "espresso" && !brew["channeling"].nil? %>
      <span class="rounded-full border border-stone-300 px-3 py-1"><%= t("public_bean_pages.show.channeling") %>: <%= brew["channeling"] ? t("public_bean_pages.show.yes") : t("public_bean_pages.show.no") %></span>
    <% end %>
    <% if equipment.dig("grinder", "name").present? %>
      <span class="rounded-full border border-stone-300 px-3 py-1"><%= equipment.dig("grinder", "name") %></span>
    <% end %>
    <% if equipment.dig("machine", "name").present? %>
      <span class="rounded-full border border-stone-300 px-3 py-1"><%= equipment.dig("machine", "name") %></span>
    <% end %>
    <% if equipment.dig("brewer", "name").present? %>
      <span class="rounded-full border border-stone-300 px-3 py-1"><%= equipment.dig("brewer", "name") %></span>
    <% end %>
  </div>
</article>
