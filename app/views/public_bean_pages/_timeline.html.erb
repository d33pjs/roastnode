<% timeline = local_assigns.fetch(:timeline, {}) || {} %>
<% share = local_assigns.fetch(:share) %>
<% status = local_assigns[:status].presence || "open" %>
<% items = public_bean_timeline_items(timeline) %>
<% brews = Array(timeline["brews"]) %>
<% opened_on = timeline["opened_on"] %>
<% unknown = t("public_bean_pages.show.unknown") %>
<% opened_date = public_bean_date(opened_on) || unknown %>
<% finished_at = timeline["finished_at"] %>
<% end_status = status == "finished" ? "finished" : "open" %>
<% end_label = end_status == "finished" ? t("public_bean_pages.show.finished") : t("public_bean_pages.show.last_brew") %>
<% end_date = public_bean_date(finished_at) || public_bean_date(timeline["last_brew_at"]) || public_bean_date(timeline["end_at"]) || unknown %>

<section data-testid="public-bean-timeline" class="border-t border-rn-line py-8">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-black uppercase text-rn-muted"><%= t("public_bean_pages.show.timeline") %></p>
      <h2 class="mt-1 text-2xl font-black text-rn-ink"><%= t("public_bean_pages.show.bag_journey") %></h2>
    </div>
    <p class="text-sm font-extrabold text-rn-muted"><%= t("public_bean_pages.show.timeline_brews", count: brews.size) %></p>
  </div>

  <div data-testid="public-bean-journey" class="mt-5 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
    <div class="grid grid-cols-3 gap-3 border-b border-rn-line bg-[var(--rn-surface-muted)] px-4 py-4">
      <div class="min-w-0 text-left">
        <p class="text-xs font-black uppercase text-rn-muted"><%= t("public_bean_pages.show.opened") %></p>
        <p class="mt-1 text-[0.8rem] font-black leading-tight text-rn-ink sm:text-base"><%= opened_date %></p>
      </div>
      <div class="min-w-0 text-center">
        <p class="text-xs font-black uppercase text-rn-muted"><%= t("public_bean_pages.show.brews") %></p>
        <p class="mt-1 text-[0.8rem] font-black leading-tight text-rn-ink sm:text-base"><%= brews.size %></p>
      </div>
      <div class="min-w-0 text-right">
        <p class="text-xs font-black uppercase text-rn-muted"><%= end_label %></p>
        <p class="mt-1 text-[0.8rem] font-black leading-tight text-rn-ink sm:text-base"><%= end_date %></p>
      </div>
    </div>

    <div class="px-3 py-5 sm:px-6">
      <div data-testid="public-bean-journey-track" class="relative h-[22rem] overflow-hidden rounded-2xl border border-rn-line bg-rn-canvas sm:h-[20rem]">
        <div class="absolute left-10 right-10 top-1/2 h-2 -translate-y-1/2 overflow-hidden rounded-full bg-[var(--rn-surface-muted)]">
          <div class="h-full w-full rounded-full bg-[var(--rn-accent-strong)]"></div>
        </div>

        <div data-testid="public-bean-journey-opened" class="absolute left-3 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-4 border-[var(--rn-surface)] bg-[var(--rn-coffee)] text-[#fff8e8] shadow-sm">
          <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3h8l2 5H6l2-5Z" />
            <path d="M6 8h12l-1.2 12H7.2L6 8Z" />
            <path d="M9 13h6" />
          </svg>
          <span class="sr-only"><%= t("public_bean_pages.show.opened") %></span>
        </div>

        <div data-testid="public-bean-journey-end" data-status="<%= end_status %>" class="absolute right-3 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-4 border-[var(--rn-surface)] <%= end_status == "finished" ? "bg-[var(--rn-accent-strong)] text-[#f8faf6]" : "bg-[var(--rn-ink)] text-[var(--rn-surface)]" %> shadow-sm">
          <% if end_status == "finished" %>
            <svg data-testid="public-bean-journey-end-finished-icon" aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          <% else %>
            <svg data-testid="public-bean-journey-end-open-icon" aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          <% end %>
          <span class="sr-only"><%= end_label %></span>
        </div>

        <% items.each_with_index do |item, index| %>
          <% position = item.fetch("display_position") %>
          <% method = item["primary_method"].presence || item["method"].presence || "unknown" %>
          <% marker_class = method == "quick_drip" ? "bg-[var(--rn-honey)] text-[var(--rn-coffee)]" : "bg-[var(--rn-coffee)] text-[#fff8e8]" %>
          <% left_style = "left: calc(3rem + (100% - 6rem) * #{position} / 100);" %>
          <% item_label = public_bean_timeline_item_label(item) %>
          <% item_title = public_bean_timeline_item_title(item) %>
          <% label_side = item["label_side"].presence || (index.even? ? "bottom" : "top") %>
          <% label_lane = item["label_lane"].to_i %>
          <% label_gap = 0.85 + (label_lane * 3.05) %>
          <% connector_height = [ label_gap - 0.18, 0.45 ].max %>
          <% label_style = "#{left_style} #{label_side == "top" ? "bottom: calc(50% + #{label_gap}rem);" : "top: calc(50% + #{label_gap}rem);"}" %>
          <% connector_style = "#{left_style} #{label_side == "top" ? "bottom: 50%;" : "top: 50%;"} height: #{connector_height}rem;" %>
          <% label_date = content_tag(:span, item_label, class: "block text-[0.65rem] font-black uppercase leading-3 text-rn-muted sm:text-[0.7rem]") %>
          <% rating_row = capture do %>
            <span class="mt-1 inline-flex max-w-full flex-wrap items-center justify-center gap-1 rounded-full bg-[var(--rn-surface-muted)] px-2 py-1 shadow-sm">
              <% item.fetch("ratings", [ item["rating"] ]).first(5).each do |rating| %>
                <span data-testid="<%= item["type"] == "cluster" ? "public-bean-journey-cluster-rating" : "public-bean-journey-brew-rating" %>" class="inline-flex items-center gap-0.5 text-[0.65rem] font-black leading-3 text-[var(--rn-accent-strong)]">
                  <%= rating.presence || "?" %><span class="brew-rating-bean bg-[var(--rn-coffee)]"></span>
                </span>
              <% end %>
              <% if item.fetch("ratings", [ item["rating"] ]).size > 5 %>
                <span class="text-[0.65rem] font-black leading-3 text-rn-muted">+<%= item.fetch("ratings", [ item["rating"] ]).size - 5 %></span>
              <% end %>
            </span>
          <% end %>
          <% label_content = label_side == "top" ? safe_join([ label_date, rating_row ]) : safe_join([ rating_row, label_date ]) %>
          <span data-testid="public-bean-journey-marker-connector" data-side="<%= label_side %>" data-lane="<%= label_lane %>" aria-hidden="true" class="absolute z-0 w-px -translate-x-1/2 bg-[var(--rn-line)] opacity-80" style="<%= connector_style %>"></span>

          <% if item["type"] == "cluster" %>
            <div data-testid="public-bean-journey-cluster" data-count="<%= item["count"] %>" data-display-position="<%= position %>" title="<%= item_title %>" class="absolute top-1/2 z-20 flex h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--rn-surface)] bg-[var(--rn-accent-strong)] text-xs font-black text-[#f8faf6] shadow-sm ring-2 ring-[var(--rn-canvas)]" style="<%= left_style %>">
              <%= item["count"] %>
            </div>
            <div data-testid="public-bean-journey-marker-label" data-side="<%= label_side %>" data-lane="<%= label_lane %>" class="absolute z-10 w-24 -translate-x-1/2 text-center sm:w-28" style="<%= label_style %>">
              <%= label_content %>
            </div>
          <% else %>
            <div data-testid="public-bean-journey-brew" data-method="<%= method %>" data-display-position="<%= position %>" data-count="1" title="<%= item_title %>" class="absolute top-1/2 z-20 flex h-6 w-6 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--rn-surface)] bg-rn-canvas shadow-sm ring-2 ring-[var(--rn-canvas)]" style="<%= left_style %>">
              <span data-testid="public-bean-journey-brew-count-dot" class="h-3.5 w-3.5 rounded-full <%= marker_class %>"></span>
            </div>
            <div data-testid="public-bean-journey-marker-label" data-side="<%= label_side %>" data-lane="<%= label_lane %>" class="absolute z-10 w-20 -translate-x-1/2 text-center sm:w-24" style="<%= label_style %>">
              <%= label_content %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap gap-2 text-xs font-extrabold text-rn-muted">
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--rn-surface-muted)] px-3 py-1">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--rn-coffee)]"></span>
          <%= t("public_bean_pages.show.espresso") %>
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--rn-surface-muted)] px-3 py-1">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--rn-honey)]"></span>
          <%= t("public_bean_pages.show.quick_drip") %>
        </span>
      </div>
    </div>
  </div>
</section>
