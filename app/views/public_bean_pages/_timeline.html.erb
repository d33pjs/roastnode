<% timeline = local_assigns.fetch(:timeline, {}) || {} %>
<% share = local_assigns.fetch(:share) %>
<% status = local_assigns[:status].presence || "open" %>
<% events = public_bean_timeline_events(timeline) %>
<% brews = Array(timeline["brews"]) %>
<% opened_on = timeline["opened_on"] %>
<% end_at = timeline["end_at"] %>
<% unknown = t("public_bean_pages.show.unknown") %>
<% opened_date = public_bean_date(opened_on) || unknown %>
<% finished_at = timeline["finished_at"] %>
<% end_status = status == "finished" ? "finished" : "open" %>
<% end_label = end_status == "finished" ? t("public_bean_pages.show.finished") : t("public_bean_pages.show.last_brew") %>
<% end_date = public_bean_date(finished_at) || public_bean_date(timeline["last_brew_at"]) || public_bean_date(end_at) || unknown %>
<% dot_size_class = events.size > 36 ? "h-2 w-2" : "h-3.5 w-3.5" %>

<section data-testid="public-bean-timeline" class="border-t border-rn-line py-8">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-black uppercase text-rn-muted"><%= t("public_bean_pages.show.timeline") %></p>
      <h2 class="mt-1 text-2xl font-black text-rn-ink"><%= t("public_bean_pages.show.bag_journey") %></h2>
    </div>
    <p class="text-sm font-extrabold text-rn-muted"><%= t("public_bean_pages.show.timeline_brews", count: brews.size) %></p>
  </div>

  <div data-testid="public-bean-journey" class="mt-5 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface shadow-sm">
    <div class="grid gap-3 border-b border-rn-line bg-[var(--rn-surface-muted)] px-4 py-4 sm:grid-cols-3">
      <div class="min-w-0">
        <p class="text-xs font-black uppercase text-rn-muted"><%= t("public_bean_pages.show.opened") %></p>
        <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= opened_date %></p>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-black uppercase text-rn-muted"><%= end_label %></p>
        <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= end_date %></p>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-black uppercase text-rn-muted"><%= t("public_bean_pages.show.brews") %></p>
        <p class="mt-1 truncate text-sm font-black text-rn-ink"><%= brews.size %></p>
      </div>
    </div>

    <div class="px-4 py-5 sm:px-6">
      <div data-testid="public-bean-journey-track" class="relative h-64 overflow-hidden rounded-2xl border border-rn-line bg-rn-canvas sm:h-60">
        <div class="absolute left-9 right-9 top-1/2 h-4 -translate-y-1/2 overflow-hidden rounded-full bg-[var(--rn-surface-muted)]">
          <div class="h-full w-full rounded-full bg-[var(--rn-accent-strong)]"></div>
        </div>

        <div data-testid="public-bean-journey-opened" class="absolute left-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-4 border-[var(--rn-surface)] bg-[var(--rn-coffee)] text-[#fff8e8] shadow-sm">
          <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3h8l2 5H6l2-5Z" />
            <path d="M6 8h12l-1.2 12H7.2L6 8Z" />
            <path d="M9 13h6" />
          </svg>
          <span class="sr-only"><%= t("public_bean_pages.show.opened") %></span>
        </div>

        <div data-testid="public-bean-journey-end" data-status="<%= end_status %>" class="absolute right-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-4 border-[var(--rn-surface)] <%= end_status == "finished" ? "bg-[var(--rn-accent-strong)] text-[#f8faf6]" : "bg-[var(--rn-ink)] text-[var(--rn-surface)]" %> shadow-sm">
          <% if end_status == "finished" %>
            <svg data-testid="public-bean-journey-end-finished-icon" aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          <% else %>
            <svg data-testid="public-bean-journey-end-open-icon" aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          <% end %>
          <span class="sr-only"><%= end_label %></span>
        </div>

        <% events.each do |event| %>
          <% position = event.fetch("display_position") %>
          <% method = event["method"].presence || "unknown" %>
          <% marker_class = method == "quick_drip" ? "bg-[var(--rn-honey)]" : "bg-[var(--rn-coffee)]" %>
          <% callout_side = event.fetch("callout_side") %>
          <% callout_top = callout_side == "top" %>
          <% callout_lane = event.fetch("callout_lane", 0).to_i %>
          <% callout_position_class = if callout_top
            [ "top-3", "top-16", "top-28" ].fetch(callout_lane, "top-28")
          else
            [ "bottom-3", "bottom-16", "bottom-28" ].fetch(callout_lane, "bottom-28")
          end %>
          <% line_class = if callout_top
            [ "bottom-1/2 h-10", "bottom-1/2 h-20", "bottom-1/2 h-28" ].fetch(callout_lane, "bottom-1/2 h-28")
          else
            [ "top-1/2 h-10", "top-1/2 h-20", "top-1/2 h-28" ].fetch(callout_lane, "top-1/2 h-28")
          end %>
          <% user = event["user"] || {} %>
          <% avatar_url = public_bean_media_url_for(share, user["avatar_attachment_id"], variant: :thumbnail) %>
          <% rating_label = event["rating"].present? ? public_bean_rating(event["rating"]) : unknown %>
          <% event_date = public_bean_date(event["occurred_at"]) || unknown %>
          <% left_style = "left: calc(2.25rem + (100% - 4.5rem) * #{position} / 100);" %>

          <span data-testid="public-bean-journey-callout-line" aria-hidden="true" class="absolute z-0 w-px bg-[var(--rn-line)] <%= line_class %>" style="<%= left_style %>"></span>

          <div data-testid="public-bean-journey-callout" data-rating="<%= event["rating"] %>" data-method="<%= method %>" data-lane="<%= callout_lane %>" class="absolute z-20 flex w-20 -translate-x-1/2 items-center gap-1.5 overflow-hidden rounded-2xl border border-rn-line bg-rn-surface px-1.5 py-1.5 text-rn-ink shadow-sm sm:w-28 sm:gap-2 sm:px-2 <%= callout_position_class %>" style="<%= left_style %>">
            <% if avatar_url.present? %>
              <%= image_tag avatar_url, alt: "", data: { testid: "public-bean-journey-avatar" }, class: "h-7 w-7 shrink-0 rounded-full object-contain" %>
            <% else %>
              <span aria-hidden="true" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full <%= marker_class %> text-xs font-black text-[#fff8e8]"><%= public_bean_method_label(method).first %></span>
            <% end %>
            <span class="min-w-0">
              <span class="block whitespace-nowrap text-xs font-black leading-4"><%= rating_label %></span>
              <span class="hidden truncate text-[0.62rem] font-extrabold uppercase leading-3 text-rn-muted sm:block"><%= event_date %></span>
            </span>
          </div>

          <span data-testid="public-bean-journey-brew" data-method="<%= method %>" data-display-position="<%= position %>" title="<%= [ public_bean_method_label(method), event_date, rating_label ].compact.join(" · ") %>" class="absolute top-1/2 z-10 flex <%= dot_size_class %> -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[var(--rn-surface)] <%= marker_class %> shadow-sm ring-2 ring-[var(--rn-canvas)]" style="<%= left_style %>"></span>
        <% end %>
      </div>

      <div class="mt-3 flex justify-between gap-4 text-xs font-extrabold text-rn-muted">
        <span class="min-w-0 truncate"><%= opened_date %></span>
        <span class="min-w-0 truncate text-right"><%= end_date %></span>
      </div>

      <div class="mt-4 flex flex-wrap gap-2 text-xs font-extrabold text-rn-muted">
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--rn-surface-muted)] px-3 py-1">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--rn-coffee)]"></span>
          <%= t("public_bean_pages.show.espresso") %>
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--rn-surface-muted)] px-3 py-1">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--rn-honey)]"></span>
          <%= t("public_bean_pages.show.quick_drip") %>
        </span>
      </div>
    </div>
  </div>
</section>
