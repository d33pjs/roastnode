<% content_for :hide_app_navigation, true %>

<main class="min-h-screen bg-rn-canvas px-5 py-12 text-rn-ink">
  <section class="mx-auto max-w-md rounded-lg border border-rn-line bg-rn-surface p-6 shadow-sm">
    <h1 class="text-2xl font-black"><%= t(".title") %></h1>
    <p class="mt-2 text-sm font-semibold text-rn-muted"><%= t(".intro") %></p>

    <%= form_with url: unlock_public_bean_page_path(@share.token), class: "mt-5 grid gap-4" do |form| %>
      <% if flash.now[:alert].present? %>
        <p class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm font-bold text-red-800"><%= flash.now[:alert] %></p>
      <% end %>

      <div>
        <%= form.label :password, t(".password"), class: "block text-sm font-extrabold text-rn-muted" %>
        <%= form.password_field :password, autofocus: true, class: "mt-1 w-full rounded-lg border border-rn-line bg-rn-surface px-3 py-2.5 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
      </div>

      <%= form.submit t(".submit"), class: "rounded-lg bg-[var(--rn-accent-strong)] px-5 py-3 text-sm font-extrabold text-[#f8faf6] shadow-sm hover:opacity-90" %>
    <% end %>
  </section>
</main>
