<% content_for :title, "Choose new password · Roastnode" %>

<main data-testid="password-edit" class="min-h-[calc(100svh-6rem)] bg-rn-canvas px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16">
  <div class="mx-auto flex min-h-[calc(100svh-14rem)] w-full max-w-md flex-col justify-center">
    <%= link_to root_path, class: "mb-6 inline-block" do %>
      <%= render "shared/brand_wordmark",
        container_class: "block h-14 w-64 max-w-full",
        image_class: "h-full w-full object-contain object-left" %>
    <% end %>

    <% if alert = flash[:alert] %>
      <p data-testid="password-flash" class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <section data-testid="password-form-panel" class="rn-surface rounded-lg p-5 sm:p-7">
      <div>
        <p class="text-sm font-extrabold uppercase text-rn-muted">Account recovery</p>
        <h1 class="mt-2 text-3xl font-black text-rn-ink">Choose new password</h1>
        <p class="mt-3 text-sm leading-6 text-rn-muted">Set a new password for your Roastnode account.</p>
      </div>

      <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-5" do |form| %>
        <div>
          <%= form.label :password, "New password", class: "text-sm font-extrabold text-rn-ink" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "New password", maxlength: 72, class: "mt-2 block h-12 w-full rounded-md border border-rn-line bg-rn-canvas px-3 text-base text-rn-ink shadow-sm placeholder:text-rn-muted focus:outline-2 focus:outline-offset-2 focus:outline-[var(--rn-accent-strong)]" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm password", class: "text-sm font-extrabold text-rn-ink" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "mt-2 block h-12 w-full rounded-md border border-rn-line bg-rn-canvas px-3 text-base text-rn-ink shadow-sm placeholder:text-rn-muted focus:outline-2 focus:outline-offset-2 focus:outline-[var(--rn-accent-strong)]" %>
        </div>

        <div class="space-y-4 pt-1">
          <%= form.submit "Save new password", class: "inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-md bg-[var(--rn-accent-strong)] px-4 text-sm font-extrabold text-[#f8faf6] shadow-sm transition hover:bg-[var(--rn-accent)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--rn-accent-strong)]" %>

          <%= link_to "Back to sign in", new_session_path, class: "inline-flex min-h-10 items-center text-sm font-bold text-rn-ink underline decoration-[var(--rn-line)] underline-offset-4 hover:decoration-[var(--rn-accent-strong)]" %>
        </div>
      <% end %>
    </section>
  </div>
</main>
