<% if section.present? %>
  <% label = kind.presence || t("public_brew_pages.show.unknown") %>
  <% name = section["display_name"].presence || section["name"].presence || t("public_brew_pages.show.unknown") %>
  <% anchor = public_product_anchor(label, name) %>
  <% photos = Array(section["photos"]) %>
  <% primary_photo_id = section["photo_attachment_id"].presence || photos.first&.fetch("attachment_id", nil) %>
  <% lightbox_sources = local_assigns.fetch(:lightbox_sources, []) %>

  <section id="<%= anchor %>" data-testid="public-product-section" data-kind="<%= kind %>" class="mt-8 grid gap-5 border-t border-stone-300 pt-8 md:grid-cols-[16rem_1fr] md:items-start">
    <div class="overflow-hidden rounded-lg border border-stone-200 bg-white">
      <% thumb_url = public_media_url_for(share, primary_photo_id, variant: :thumbnail) %>
      <% full_url = public_media_url_for(share, primary_photo_id) %>
      <% if thumb_url.present? && full_url.present? %>
        <button type="button" data-action="public-lightbox#open" data-public-lightbox-index-param="<%= public_lightbox_index_for(lightbox_sources, full_url) %>" data-full-src="<%= full_url %>" aria-label="<%= t("public_brew_pages.show.open_named_photo", name:) %>" class="h-64 w-full bg-white p-2">
          <%= image_tag thumb_url, alt: "", class: "h-full w-full object-contain" %>
        </button>
      <% else %>
        <div class="flex h-64 items-center justify-center bg-stone-100 text-sm font-bold text-stone-500"><%= label.humanize %></div>
      <% end %>
    </div>

    <div class="flex min-h-64 flex-col">
      <div>
        <p class="text-xs font-black uppercase text-stone-500"><%= label.humanize %></p>
        <h2 class="mt-1 text-3xl font-black leading-tight text-stone-950"><%= name %></h2>

        <% if section["model"].present? %>
          <p class="mt-1 text-sm font-bold text-stone-600"><%= section["model"] %></p>
        <% end %>

        <% if kind == "bean" %>
          <div class="mt-4 flex flex-wrap gap-2">
            <% if (date = public_snapshot_date(section["purchased_on"])).present? %>
              <span data-testid="public-bean-fact" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-extrabold text-stone-700"><%= t("public_brew_pages.show.bought", date:) %></span>
            <% end %>
            <% if (date = public_snapshot_date(section["opened_on"])).present? %>
              <span data-testid="public-bean-fact" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-extrabold text-stone-700"><%= t("public_brew_pages.show.opened", date:) %></span>
            <% end %>
            <% if (date = public_snapshot_date(section["roast_date"])).present? %>
              <span data-testid="public-bean-fact" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-extrabold text-stone-700"><%= t("public_brew_pages.show.roasted", date:) %></span>
            <% end %>
            <% [ section["origin"], section["process"], section["roast_type"], section["roast_level"] ].compact_blank.each do |fact| %>
              <span data-testid="public-bean-fact" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-extrabold text-stone-700"><%= fact.to_s.humanize %></span>
            <% end %>
          </div>
        <% end %>

        <% if section["public_note"].present? %>
          <p class="mt-4 whitespace-pre-line text-base font-semibold leading-7 text-stone-700"><%= section["public_note"] %></p>
        <% end %>

        <% if section["tasting_notes"].present? %>
          <p class="mt-3 text-sm font-semibold text-stone-600"><%= section["tasting_notes"] %></p>
        <% end %>

        <% if section.fetch("links", []).any? %>
          <div class="mt-4 flex flex-wrap gap-2">
            <% section.fetch("links", []).each do |link| %>
              <%= link_to link["url"], target: "_blank", rel: "noopener", data: { testid: "public-product-link" }, class: "inline-flex items-center gap-2 rounded-full bg-stone-950 px-4 py-2 text-sm font-extrabold text-stone-50 underline decoration-stone-400 decoration-2 underline-offset-4 hover:bg-stone-800" do %>
                <span data-testid="public-link-icon" aria-hidden="true">🔗</span>
                <span><%= public_link_label(link) %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if kind == "bean" && photos.any? %>
        <div data-testid="public-bean-thumbnail-rail" class="mt-auto flex gap-2 overflow-x-auto pt-4">
          <% photos.each do |photo| %>
            <% thumb_url = public_media_url_for(share, photo["attachment_id"], variant: :thumbnail) %>
            <% full_url = public_media_url_for(share, photo["attachment_id"]) %>
            <% if thumb_url.present? && full_url.present? %>
              <button type="button" data-testid="public-bean-thumbnail" data-action="public-lightbox#open" data-public-lightbox-index-param="<%= public_lightbox_index_for(lightbox_sources, full_url) %>" data-full-src="<%= full_url %>" aria-label="<%= t("public_brew_pages.show.open_named_photo", name:) %>" class="h-14 w-14 shrink-0 rounded-md border border-stone-200 bg-white p-1">
                <%= image_tag thumb_url, alt: "", class: "h-full w-full object-contain" %>
              </button>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
