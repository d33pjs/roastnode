<% brew = snapshot.fetch("brew", {}) || {} %>
<% bean = snapshot.fetch("bean", {}) || {} %>
<% occurred_at = public_snapshot_time(brew["occurred_at"]) %>
<% unknown = t("public_brew_pages.show.unknown") %>
<% total_seconds = brew["total_time_seconds"] %>
<% preinfusion_x = public_snapshot_chart_x(brew["preinfusion_seconds"], total_seconds) %>
<% first_drip_x = public_snapshot_chart_x(brew["first_drip_seconds"], total_seconds) %>
<% total_time_x = public_snapshot_chart_x(total_seconds, total_seconds) || 500 %>
<% first_drip_label_x = first_drip_x ? [ first_drip_x + 12, 432 ].min : nil %>
<% axis_max_grams = public_snapshot_axis_max_grams(brew["beverage_grams"]) || brew["beverage_grams"] %>
<% bean_anchor = public_product_anchor("bean", bean["display_name"].presence || bean["name"]) %>

<article data-testid="public-brew-hero-card" class="overflow-hidden rounded-lg bg-stone-950 text-stone-50 shadow-sm">
  <div class="bg-stone-950 p-5">
    <div class="flex flex-nowrap items-center gap-1 overflow-hidden sm:gap-2">
      <span class="shrink-0 whitespace-nowrap rounded-full border border-white/20 px-2 py-1 text-xs font-bold text-stone-200"><%= occurred_at ? l(occurred_at, format: :short) : t("public_brew_pages.show.unknown") %></span>
      <%= render "shared/brand_mark",
        testid: "public-brew-card-brand-mark",
        container_class: "ml-auto h-9 w-9 shrink-0 sm:h-12 sm:w-12",
        image_class: "h-full w-full object-contain drop-shadow-sm" %>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="min-w-0">
        <%= link_to "##{bean_anchor}", data: { testid: "public-brew-bean-anchor" }, class: "block rounded-md focus:outline-none focus:ring-2 focus:ring-white/70" do %>
          <p class="text-sm font-black uppercase text-stone-300 sm:text-base"><%= bean["roaster_name"].presence || unknown %></p>
          <h1 class="mt-1 text-3xl font-black leading-8 text-white sm:text-4xl sm:leading-10"><%= bean["name"].presence || unknown %></h1>
        <% end %>
          <% descriptor = [ bean["origin"], bean["process"], bean["roast_level"] ].compact_blank.join(" · ") %>
          <% if descriptor.present? %>
            <p class="mt-2 text-sm text-stone-300"><%= descriptor %></p>
          <% end %>
      </div>

      <div class="grid grid-cols-2 gap-1 sm:grid-cols-5 sm:gap-2">
        <div data-testid="public-brew-dose" class="min-w-0 rounded-md bg-white/10 p-2">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.dose") %></p>
          <p class="mt-1 overflow-hidden text-ellipsis font-bold text-white"><%= public_snapshot_grams(brew["dose_grams"]) %></p>
        </div>
        <div data-testid="public-brew-ratio" class="min-w-0 rounded-md bg-white/10 p-2">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.ratio") %></p>
          <p class="mt-1 overflow-hidden text-ellipsis font-bold text-white"><%= public_snapshot_ratio(snapshot) %></p>
          <% if public_snapshot_ratio_time(snapshot).present? %>
            <p class="mt-0.5 overflow-hidden text-ellipsis text-xs font-semibold text-stone-300"><%= public_snapshot_ratio_time(snapshot) %></p>
          <% end %>
        </div>
        <div data-testid="public-brew-grind" class="min-w-0 rounded-md bg-white/10 p-2">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.grind_setting") %></p>
          <p class="mt-1 overflow-hidden text-ellipsis font-bold text-white"><%= brew["grind_setting"].presence || unknown %></p>
        </div>
        <div data-testid="public-brew-rating" class="min-w-0 rounded-md bg-white/10 p-2">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("brews.show.rating") %></p>
          <p class="mt-1 overflow-hidden text-ellipsis text-xs font-bold leading-tight text-white sm:text-sm"><%= public_snapshot_rating_label(brew["rating"]) %></p>
        </div>
        <div data-testid="public-brew-balance" class="min-w-0 rounded-md bg-white/10 p-2">
          <p class="text-xs font-bold uppercase text-stone-300"><%= t("public_brew_pages.show.balance") %></p>
          <p class="mt-1 overflow-hidden text-ellipsis text-xs font-bold leading-tight text-green-300 sm:text-sm"><%= brew["taste_balance"].present? ? brew["taste_balance"].to_s.humanize : unknown %></p>
        </div>
      </div>
    </div>
  </div>

  <div data-testid="public-brew-chart-grid" class="brew-chart-grid bg-stone-50 px-1 py-1 text-stone-950 sm:px-4 sm:py-3">
    <svg class="block h-auto w-full" width="560" height="168" viewBox="0 0 560 168" role="img" aria-label="<%= t("brews.show.yield") %>">
      <defs>
        <linearGradient id="public-brew-fill-<%= share.token.parameterize %>" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#0f172a" stop-opacity=".16" />
          <stop offset="100%" stop-color="#0f172a" stop-opacity="0" />
        </linearGradient>
      </defs>
      <line x1="44" y1="130" x2="500" y2="130" stroke="#1c1917" stroke-width="2.5" />
      <line x1="44" y1="20" x2="44" y2="130" stroke="#1c1917" stroke-width="2.5" />
      <path d="M44 130 C84 132, 124 132, 156 128 C182 124, 204 106, 230 88 C270 60, 320 46, 376 38 C420 32, 464 34, 500 42" fill="none" stroke="#0f172a" stroke-width="6" stroke-linecap="round" />
      <path d="M44 130 C84 132, 124 132, 156 128 C182 124, 204 106, 230 88 C270 60, 320 46, 376 38 C420 32, 464 34, 500 42 L500 130 L44 130 Z" fill="url(#public-brew-fill-<%= share.token.parameterize %>)" />
      <path d="M44 9 C134 8, 224 8, 314 8 C390 7, 452 8, 500 11" fill="none" stroke="#a16207" stroke-width="3.5" stroke-linecap="round" />
      <% if preinfusion_x.present? %>
        <line data-testid="public-brew-preinfusion-guide" x1="<%= preinfusion_x %>" y1="25" x2="<%= preinfusion_x %>" y2="140" stroke="#78716c" stroke-width="2.5" stroke-dasharray="6 8" />
      <% end %>
      <% if first_drip_x.present? %>
        <line data-testid="public-brew-first-drip-guide" x1="<%= first_drip_x %>" y1="25" x2="<%= first_drip_x %>" y2="140" stroke="#0f766e" stroke-width="2.5" stroke-dasharray="4 7" />
      <% end %>
      <line data-testid="public-brew-total-time-guide" x1="<%= total_time_x %>" y1="25" x2="<%= total_time_x %>" y2="140" stroke="#78716c" stroke-width="2.5" stroke-dasharray="6 8" />
      <line x1="44" y1="48" x2="30" y2="48" stroke="#78716c" stroke-width="2.5" />

      <text x="8" y="135" font-size="13" fill="#57534e">0g</text>
      <text data-testid="public-brew-axis-max" x="6" y="52" font-size="13" fill="#57534e"><%= public_snapshot_grams(axis_max_grams) %></text>
      <text x="32" y="157" font-size="13" fill="#57534e">0s</text>
      <% if preinfusion_x.present? %>
        <text data-testid="public-brew-preinfusion-label" x="<%= [ preinfusion_x - 36, 54 ].max %>" y="157" font-size="13" fill="#57534e"><%= public_snapshot_seconds(brew["preinfusion_seconds"]) %> <%= t("brews.show.preinfusion") %></text>
      <% end %>
      <% if first_drip_x.present? %>
        <g data-testid="public-brew-first-drip-callout">
          <rect x="<%= first_drip_label_x - 7 %>" y="95" width="126" height="20" rx="5" fill="#f0fdfa" fill-opacity=".95" />
          <text data-testid="public-brew-first-drip-label" x="<%= first_drip_label_x %>" y="110" font-size="13" font-weight="800" fill="#0f766e"><%= t("brews.show.first_drip_label", seconds: public_snapshot_seconds(brew["first_drip_seconds"])) %></text>
        </g>
      <% end %>
      <text data-testid="public-brew-total-time-label" x="<%= total_time_x - 19 %>" y="157" font-size="13" fill="#57534e"><%= public_snapshot_seconds(brew["total_time_seconds"]) %></text>
      <g data-testid="public-brew-temperature-callout" transform="translate(536 132) rotate(-90)">
        <rect x="0" y="-18" width="90" height="21" rx="5" fill="#fffbeb" fill-opacity=".95" />
        <text data-testid="public-brew-temperature-label" x="7" y="-3" font-size="14" font-weight="800" fill="#a16207"><%= t("public_brew_pages.show.temp_label", temperature: public_snapshot_temperature(brew["brew_temperature_celsius"])) %></text>
      </g>
      <text x="386" y="65" font-size="14" font-weight="800" fill="#0f172a"><%= public_snapshot_grams(brew["beverage_grams"]) %></text>
    </svg>
  </div>

  <div class="bg-stone-900 px-5 py-3">
    <div class="flex flex-wrap items-center gap-2">
      <% snapshot.fetch("equipment", []).each do |equipment| %>
        <% role = equipment["role"].presence || "gear" %>
        <% name = equipment["name"].presence || unknown %>
        <%= link_to "#{role.humanize}: #{name}", "##{public_product_anchor(role, name)}", data: { testid: "public-gear-anchor" }, class: "rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold text-stone-100 hover:bg-white/20" %>
      <% end %>

      <% snapshot.fetch("tools", []).each do |tool| %>
        <% name = tool["name"].presence || unknown %>
        <%= link_to name, "##{public_product_anchor("tool", name)}", data: { testid: "public-gear-anchor" }, class: "rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-stone-200 hover:bg-white/25" %>
      <% end %>
    </div>
  </div>
</article>
