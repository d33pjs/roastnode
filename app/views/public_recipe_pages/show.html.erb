<% content_for :hide_app_navigation, true %>
<% snapshot = @snapshot || {} %>
<% recipe = snapshot["recipe"] || {} %>
<% targets = recipe["targets"] || {} %>
<% guide = recipe["guide"] || {} %>
<% source_brew = recipe["source_brew"] || {} %>
<% ingredients = Array(recipe["ingredients"]).select { |item| item.is_a?(Hash) && item["name"].present? } %>
<% finish_note = recipe["finish_note"].presence %>
<% bean = snapshot["bean"] || {} %>
<% unknown = public_recipe_unknown_label %>

<main data-testid="public-recipe-page" class="min-h-screen bg-[#f6f4ef] text-stone-950">
  <section class="mx-auto max-w-5xl px-5 py-6 sm:px-8">
    <header class="flex items-center justify-between gap-4 py-4">
      <div class="min-w-0 text-xs font-black uppercase text-stone-800">
        <span class="truncate"><%= snapshot.dig("workspace", "name").presence || unknown %></span>
      </div>

      <div class="min-w-0 text-sm font-extrabold text-stone-700">
        <span class="truncate"><%= snapshot.dig("user", "display_label").presence || unknown %></span>
      </div>
    </header>

    <section class="grid gap-6 py-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div class="min-w-0">
        <p class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".eyebrow") %></p>
        <h1 class="mt-3 text-4xl font-black leading-tight sm:text-5xl"><%= snapshot["title"].presence || unknown %></h1>

        <% if bean.present? %>
          <p class="mt-4 text-lg font-bold leading-8 text-stone-700">
            <%= bean["display_name"].presence || bean["name"].presence || unknown %>
          </p>
        <% end %>

        <% if guide["note"].present? %>
          <p class="mt-6 whitespace-pre-line text-base font-semibold leading-7 text-stone-700"><%= guide["note"] %></p>
        <% end %>

        <% if guide["pressure_note"].present? %>
          <p class="mt-3 whitespace-pre-line rounded-lg border border-stone-300 bg-white/60 px-4 py-3 text-sm font-bold leading-6 text-stone-700"><%= guide["pressure_note"] %></p>
        <% end %>

        <% if (photo_url = public_recipe_media_url_for(@share, recipe.dig("photo", "attachment_id"), variant: :thumbnail)).present? %>
          <%= image_tag photo_url, alt: "", data: { testid: "public-recipe-photo" }, class: "mt-6 h-80 w-full rounded-lg object-cover" %>
        <% end %>

        <% if source_brew["public_note"].present? %>
          <div class="mt-6 border-t border-stone-300 pt-5">
            <h2 class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".source_note") %></h2>
            <p class="mt-2 whitespace-pre-line text-base font-semibold leading-7 text-stone-700"><%= source_brew["public_note"] %></p>
          </div>
        <% end %>

        <% if source_brew["rating"].present? || source_brew["taste_balance"].present? %>
          <div class="mt-5 flex flex-wrap gap-2">
            <% if source_brew["rating"].present? %>
              <span class="rounded-full bg-stone-950 px-4 py-2 text-sm font-extrabold text-stone-50"><%= t(".rating", value: source_brew["rating"]) %></span>
            <% end %>
            <% if source_brew["taste_balance"].present? %>
              <span class="rounded-full border border-stone-300 bg-white/60 px-4 py-2 text-sm font-extrabold text-stone-700"><%= source_brew["taste_balance"] %></span>
            <% end %>
          </div>
        <% end %>

        <% if recipe["links"].present? %>
          <div class="mt-6 flex flex-wrap gap-2">
            <% recipe["links"].each do |link| %>
              <%= link_to public_recipe_link_label(link), link["url"], target: "_blank", rel: "noopener", data: { testid: "public-recipe-link" }, class: "rounded-full bg-stone-950 px-4 py-2 text-sm font-extrabold text-stone-50 hover:bg-stone-800" %>
            <% end %>
          </div>
        <% end %>

        <% if ingredients.any? || finish_note.present? %>
          <section data-testid="public-recipe-finish" class="mt-6 rounded-lg border border-stone-300 bg-white p-4">
            <h2 class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".finish") %></h2>
            <% if ingredients.any? %>
              <ul class="mt-3 grid gap-2">
                <% ingredients.each do |ingredient| %>
                  <% amount = [ ingredient["amount"], ingredient["unit"] ].compact_blank.join(" ") %>
                  <li class="rounded-lg bg-[#f6f4ef] px-4 py-3 text-sm font-black text-stone-950">
                    <%= [ amount.presence, ingredient["name"] ].compact.join(" ") %>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <% if finish_note.present? %>
              <p class="mt-3 whitespace-pre-line text-sm font-semibold leading-6 text-stone-700"><%= finish_note %></p>
            <% end %>
          </section>
        <% end %>
      </div>

      <aside data-testid="public-recipe-target-guide" class="overflow-hidden rounded-lg border border-stone-300 bg-white shadow-sm">
        <div class="border-b border-stone-300 bg-stone-100 px-4 py-3">
          <p class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".target_guide") %></p>
          <h2 class="mt-1 text-lg font-black text-stone-950"><%= t(".target_title") %></h2>
        </div>

        <div class="grid gap-2 p-3">
          <div class="rounded-lg bg-[#f6f4ef] px-4 py-3">
            <p class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".grinder_label") %></p>
            <p class="mt-1 text-xl font-black text-stone-950"><%= t(".grinder", value: targets["grind_setting"].presence || unknown) %></p>
          </div>

          <div class="rounded-lg bg-[#f6f4ef] px-4 py-3">
            <p class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".dose_label") %></p>
            <p class="mt-1 text-base font-black text-stone-950"><%= t(".dose", dose: public_recipe_snapshot_grams(targets["dose_grams"].presence || targets["ground_weight_grams"]), bean: public_recipe_snapshot_grams(targets["bean_weight_grams"])) %></p>
          </div>

          <div class="rounded-lg bg-[#f6f4ef] px-4 py-3">
            <p class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".stop_label") %></p>
            <p class="mt-1 text-base font-black text-stone-950"><%= t(".stop", time: public_recipe_snapshot_seconds(targets["total_time_seconds"]), yield: public_recipe_snapshot_grams(targets["beverage_grams"])) %></p>
          </div>

          <div class="rounded-lg border border-stone-300 bg-white px-4 py-3">
            <p class="text-sm font-extrabold text-stone-950"><%= t(".temperature", value: public_recipe_snapshot_temperature(targets["brew_temperature_celsius"])) %></p>
            <p class="mt-1 text-sm font-bold text-stone-600"><%= t(".timing", preinfusion: public_recipe_snapshot_seconds(targets["preinfusion_seconds"]), first_drip: public_recipe_snapshot_seconds(targets["first_drip_seconds"])) %></p>
          </div>
        </div>
      </aside>
    </section>

    <% if bean.present? || snapshot.fetch("equipment", []).present? || snapshot.fetch("tools", []).present? %>
      <section class="grid gap-4 border-t border-stone-300 py-8 sm:grid-cols-2 lg:grid-cols-3">
        <% if bean.present? %>
          <article class="rounded-lg border border-stone-300 bg-white p-4">
            <h2 class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".bean") %></h2>
            <p class="mt-2 text-lg font-black"><%= bean["display_name"].presence || bean["name"].presence || unknown %></p>
            <% if bean["roaster_name"].present? || bean["origin"].present? %>
              <p class="mt-1 text-sm font-bold text-stone-600"><%= [ bean["roaster_name"], bean["origin"] ].compact.join(" · ") %></p>
            <% end %>
            <% if bean["tasting_notes"].present? %>
              <p class="mt-3 text-sm font-semibold leading-6 text-stone-700"><%= bean["tasting_notes"] %></p>
            <% end %>
          </article>
        <% end %>

        <% snapshot.fetch("equipment", []).each do |item| %>
          <article class="rounded-lg border border-stone-300 bg-white p-4">
            <h2 class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= item["role"].presence || item["kind"].presence || t(".equipment") %></h2>
            <p class="mt-2 text-lg font-black"><%= item["name"].presence || unknown %></p>
            <% if item["model"].present? %>
              <p class="mt-1 text-sm font-bold text-stone-600"><%= item["model"] %></p>
            <% end %>
          </article>
        <% end %>

        <% snapshot.fetch("tools", []).each do |item| %>
          <article class="rounded-lg border border-stone-300 bg-white p-4">
            <h2 class="text-xs font-black uppercase tracking-[0.08em] text-stone-600"><%= t(".tool") %></h2>
            <p class="mt-2 text-lg font-black"><%= item["name"].presence || unknown %></p>
            <% if item["public_note"].present? %>
              <p class="mt-3 text-sm font-semibold leading-6 text-stone-700"><%= item["public_note"] %></p>
            <% end %>
          </article>
        <% end %>
      </section>
    <% end %>
  </section>
</main>
