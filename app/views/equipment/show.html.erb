<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-5xl px-6 py-10">
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= link_to t(".back"), equipment_index_path, class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
        <p class="mt-4 text-sm font-semibold uppercase text-stone-600"><%= @equipment.kind.humanize %></p>
        <h1 class="mt-2 text-3xl font-bold text-stone-950"><%= @equipment.name %></h1>
        <p class="mt-2 text-stone-700"><%= @equipment.model.presence || t(".unknown_model") %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".log_event"), new_equipment_event_path, class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
      <% end %>
    </header>

    <section class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".brews_since_service") %></p>
        <p data-testid="equipment-brews-since-service" class="mt-2 text-3xl font-bold text-stone-950"><%= @equipment_statistics[:service][:brews_since_service] %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".grams_since_service") %></p>
        <p data-testid="equipment-grams-since-service" class="mt-2 text-3xl font-bold text-stone-950"><%= statistics_grams(@equipment_statistics[:service][:grams_since_service]) %></p>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase text-stone-600"><%= t(".last_service") %></p>
        <p class="mt-2 text-lg font-bold text-stone-950"><%= @last_service_event ? l(@last_service_event.occurred_at.to_date, format: :long) : t(".never") %></p>
      </div>
    </section>

    <section class="mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-stone-950"><%= t(".analytics") %></h2>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".total_brews") %></p>
          <p data-testid="equipment-total-brews" class="mt-1 text-2xl font-bold text-stone-950"><%= @equipment_statistics[:totals][:brew_count] %></p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".total_ground") %></p>
          <p data-testid="equipment-total-ground" class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_grams(@equipment_statistics[:totals][:total_bean_weight_grams]) %></p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".average_rating") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950">
            <% if @equipment_statistics[:averages][:rating].present? %>
              <%= number_with_precision(@equipment_statistics[:averages][:rating], precision: 1, strip_insignificant_zeros: true) %>/5
            <% else %>
              <%= t(".unknown") %>
            <% end %>
          </p>
        </div>
        <div class="rounded-md bg-stone-50 p-4">
          <p class="text-xs font-bold uppercase text-stone-500"><%= t(".channeling_rate") %></p>
          <p class="mt-1 text-2xl font-bold text-stone-950"><%= statistics_percent(@equipment_statistics[:rates][:channeling_percent]) %></p>
        </div>
      </div>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".brews_by_day") %></h3>
          <div class="mt-3 rounded-md border border-stone-200 p-3">
            <%= render "statistics/day_bars", points: @equipment_statistics[:series][:brews_by_day], value_key: :count, maximum: @equipment_statistics[:series][:brews_by_day].map { |point| point[:count] }.max, suffix: "" %>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase text-stone-600"><%= t(".maintenance_markers") %></h3>
          <div class="mt-3 rounded-md border border-stone-200 p-3">
            <%= render "statistics/bar_list", values: @equipment_statistics[:distributions][:event_types], maximum: @equipment_statistics[:distributions][:event_types].values.max, empty_label: t(".no_events") %>
          </div>
        </div>
      </div>
    </section>

    <% if @equipment.notes.present? %>
      <section class="mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-stone-950"><%= t(".notes") %></h2>
        <p class="mt-2 whitespace-pre-line text-stone-700"><%= @equipment.notes %></p>
      </section>
    <% end %>

    <%= render "shared/photo_grid",
      record: @equipment,
      title: t(".photos"),
      section_class: "mt-8 rounded-lg border border-stone-200 bg-white p-5 shadow-sm",
      title_class: "font-semibold text-stone-950" %>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".recent_events") %></h2>
        <div class="divide-y divide-stone-100 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
          <% if @recent_events.any? %>
            <% @recent_events.each do |event| %>
              <%= link_to equipment_event_path(event), class: "block p-4 hover:bg-stone-50" do %>
                <p class="font-semibold text-stone-950"><%= event.event_type_summary %></p>
                <p class="mt-1 text-sm text-stone-600"><%= l(event.occurred_at, format: :short) %></p>
              <% end %>
            <% end %>
          <% else %>
            <p class="p-4 text-sm text-stone-600"><%= t(".no_events") %></p>
          <% end %>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-bold text-stone-950"><%= t(".recent_brews") %></h2>
        <div data-testid="equipment-recent-brews" class="divide-y divide-stone-100 overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
          <% if @recent_brews.any? %>
            <% @recent_brews.each do |brew| %>
              <%= link_to brew_path(brew), class: "block p-4 hover:bg-stone-50" do %>
                <p class="font-semibold text-stone-950"><%= t(".brew", bean: brew.bean.name) %></p>
                <p class="mt-1 text-sm text-stone-600"><%= l(brew.occurred_at, format: :short) %></p>
              <% end %>
            <% end %>
          <% else %>
            <p class="p-4 text-sm text-stone-600"><%= t(".no_brews") %></p>
          <% end %>
        </div>
      </section>
    </div>
  </section>
</main>
