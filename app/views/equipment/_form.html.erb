<%= form_with model: equipment, class: "mt-8 grid gap-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm" do |form| %>
  <% if equipment.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <%= equipment.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, t("equipment.form.name"), class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_field :name, autofocus: true, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :kind, t("equipment.form.kind"), class: "block text-sm font-medium text-stone-700" %>
      <%= form.select :kind, Equipment.kinds.keys.map { |kind| [ kind.humanize, kind ] }, {}, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :model, t("equipment.form.model"), class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :model, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, t("equipment.form.notes"), class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-stone-950 shadow-sm focus:border-stone-900 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :photos, t("equipment.form.photos"), class: "block text-sm font-medium text-stone-700" %>
    <%= form.file_field :photos, multiple: true, accept: "image/*", class: "mt-1 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-stone-950 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-800" %>
  </div>

  <%= form.submit submit_label, class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
<% end %>
