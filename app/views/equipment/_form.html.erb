<% label_class = "block text-sm font-extrabold text-rn-muted" %>
<% input_class = "mt-1 w-full rounded-2xl border border-rn-line bg-rn-surface px-3 py-2.5 text-rn-ink shadow-sm focus:border-[var(--rn-accent-strong)] focus:outline-none" %>
<% section_class = "grid gap-4 rounded-2xl border border-rn-line bg-rn-surface p-4 shadow-sm sm:p-5" %>
<% section_title_class = "text-lg font-black text-rn-ink" %>

<%= form_with model: equipment, class: "mt-6 grid gap-4", data: { controller: "equipment-kind" } do |form| %>
  <% if equipment.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800">
      <%= equipment.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section data-testid="equipment-form-section" data-section="identity" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("equipment.form.sections.identity") %></h2>
    </div>

    <div>
      <%= form.label :name, t("equipment.form.name"), class: label_class %>
      <%= form.text_field :name, autofocus: true, class: input_class %>
    </div>

    <div>
      <%= form.label :photos, t("equipment.form.photos"), class: label_class %>
      <%= render "shared/photo_upload_input", form: %>
    </div>
  </section>

  <section data-testid="equipment-form-section" data-section="setup" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("equipment.form.sections.setup") %></h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :kind, t("equipment.form.kind"), class: label_class %>
        <%= form.select :kind,
          Equipment.kinds.keys.map { |kind| [ kind.humanize, kind ] },
          {},
          class: input_class,
          data: { equipment_kind_target: "kind", action: "change->equipment-kind#kindChanged" } %>
      </div>

      <div>
        <%= form.label :model, t("equipment.form.model"), class: label_class %>
        <%= form.text_field :model, class: input_class %>
      </div>
    </div>
  </section>

  <fieldset
    data-testid="equipment-machine-features"
    data-equipment-kind-target="machineFeatures"
    class="<%= section_class %>"
    <%= "hidden" unless equipment.machine? %>
  >
    <legend class="<%= section_title_class %>"><%= t("equipment.form.machine_features.title") %></legend>
    <p id="equipment-machine-features-hint" class="text-sm font-semibold text-rn-muted"><%= t("equipment.form.machine_features.hint") %></p>

    <div class="grid gap-2 sm:grid-cols-3">
      <% %i[preinfusion_enabled low_flow_start_enabled flow_control_enabled].each do |feature| %>
        <label class="flex min-h-14 cursor-pointer items-center justify-between gap-3 rounded-2xl border border-rn-line bg-[var(--rn-canvas)] px-3 py-3 text-sm font-extrabold text-rn-ink hover:bg-[var(--rn-surface-muted)]">
          <span><%= t("equipment.form.machine_features.#{feature}") %></span>
          <%= form.check_box feature,
            disabled: !equipment.machine?,
            aria: { describedby: "equipment-machine-features-hint" },
            class: "h-5 w-5 shrink-0 rounded border-rn-line text-[var(--rn-accent-strong)] focus:ring-[var(--rn-accent-strong)]" %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <section data-testid="equipment-form-section" data-section="notes" class="<%= section_class %>">
    <div>
      <h2 class="<%= section_title_class %>"><%= t("equipment.form.sections.notes") %></h2>
    </div>

    <div>
      <%= form.label :notes, t("equipment.form.notes"), class: label_class %>
      <%= form.text_area :notes, rows: 4, class: input_class %>
    </div>

    <div>
      <%= form.label :public_note, t("equipment.form.public_note"), class: label_class %>
      <%= form.text_area :public_note, rows: 4, class: input_class %>
    </div>
  </section>

  <%= render "shared/record_links_fields",
    form:,
    record: equipment,
    label_class:,
    input_class:,
    section_class:,
    section_title_class: %>

  <%= form.submit submit_label, class: "rounded-2xl bg-[var(--rn-accent-strong)] px-5 py-3 text-sm font-extrabold text-[#f8faf6] shadow-sm hover:opacity-90" %>
<% end %>
