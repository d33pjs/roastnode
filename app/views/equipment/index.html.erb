<main class="min-h-screen bg-stone-50">
  <section class="mx-auto max-w-5xl px-6 py-10">
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render "shared/back_link", label: t(".back"), path: dashboard_path %>
        <h1 class="mt-4 text-3xl font-bold text-stone-950"><%= t(".title") %></h1>
        <p class="mt-2 text-stone-700"><%= current_workspace.name %></p>
      </div>

      <% if current_workspace_policy.write? %>
        <%= link_to t(".new"), new_equipment_path, class: "rounded-md bg-stone-950 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-stone-800" %>
      <% end %>
    </header>

    <div class="overflow-x-auto rounded-lg border border-stone-200 bg-white shadow-sm">
      <table class="min-w-[38rem] divide-y divide-stone-200 sm:min-w-full">
        <thead class="bg-stone-100">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".name") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".kind") %></th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-stone-700"><%= t(".model") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @equipment.each do |item| %>
            <% photo = item.primary_photo_attachment %>
            <tr>
              <td class="px-4 py-3 text-sm font-medium text-stone-950">
                <%= link_to equipment_path(item), class: "flex items-center gap-3 hover:text-stone-600" do %>
                  <% if photo.present? %>
                    <%= image_tag media_attachment_path(photo, variant: :thumbnail), alt: "", data: { testid: "equipment-list-photo" }, class: "h-12 w-12 shrink-0 rounded-md object-cover ring-1 ring-stone-200" %>
                  <% else %>
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-stone-100 text-sm font-black text-stone-500 ring-1 ring-stone-200"><%= item.name.first&.upcase || "?" %></span>
                  <% end %>
                  <span><%= item.name %></span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-stone-700"><%= item.kind.humanize %></td>
              <td class="px-4 py-3 text-sm text-stone-700"><%= item.model.presence || t(".unknown") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>
