<main class="rn-page">
  <section class="rn-shell max-w-4xl py-6 sm:px-6 lg:py-10">
    <%= render "shared/back_link", label: t(".back"), path: equipment_path(@equipment) %>
    <div class="mt-5">
      <p class="text-sm font-extrabold uppercase tracking-[0.08em] text-rn-muted"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 text-3xl font-extrabold text-rn-ink sm:text-4xl"><%= t(".title") %></h1>
    </div>

    <%= render "form", equipment: @equipment, submit_label: t(".update") %>

    <%= render "shared/photo_grid",
      record: @equipment,
      title: t(".photos"),
      section_class: "mt-6 rounded-2xl border border-rn-line bg-rn-surface p-5 shadow-sm",
      title_class: "text-lg font-black text-rn-ink" %>
  </section>
</main>
