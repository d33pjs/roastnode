# Copy this file to .env next to compose.production.yml or render it with Ansible.
# Do not commit the rendered .env file or any real secrets.

## Image
# Prefer the immutable digest from the GitHub Release asset.
ROASTNODE_IMAGE=ghcr.io/OWNER/roastnode@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# PostgreSQL can also be pinned to a digest if your deployment policy requires it.
POSTGRES_IMAGE=postgres:17.11

## Rails Secrets
RAILS_MASTER_KEY=replace-with-config-master-key
# SECRET_KEY_BASE is optional when credentials already provide it.
SECRET_KEY_BASE=

## Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=roastnode
POSTGRES_DB=roastnode_production
ROASTNODE_DATABASE_PASSWORD=replace-with-a-long-random-password

## Public URLs And Host Authorization
ROASTNODE_HOST=coffee.example.com
ROASTNODE_PROTOCOL=https
# Must match the public browser origin used for passkeys.
ROASTNODE_WEBAUTHN_ORIGIN=https://coffee.example.com
# Set only when intentionally scoping passkeys to a parent domain.
ROASTNODE_WEBAUTHN_RP_ID=
# Set only when generated links need a non-default public port.
ROASTNODE_PORT=
ROASTNODE_ALLOWED_HOSTS=coffee.example.com
# Enable these when Rails receives HTTPS traffic or trusted X-Forwarded-Proto headers.
RAILS_ASSUME_SSL=false
RAILS_FORCE_SSL=false

## Web Binding
# Host-side bind for the web service. Keep 127.0.0.1 when another proxy is in front.
ROASTNODE_BIND_ADDRESS=127.0.0.1
ROASTNODE_WEB_PORT=3001
# Default container path: Thruster listens on 80 and forwards to Puma.
ROASTNODE_CONTAINER_PORT=80
ROASTNODE_WEB_COMMAND=./bin/thrust ./bin/rails server

## Rails Runtime
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=false
# Optional footer/source display overrides. Release images bake ROASTNODE_VERSION from the release tag.
ROASTNODE_VERSION=
ROASTNODE_GITHUB_URL=https://github.com/d33pjs/roastnode

## SMTP Mail Delivery
SMTP_ENABLED=false
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=coffee.example.com
SMTP_FROM_ADDRESS=no-reply@coffee.example.com
SMTP_USER_NAME=mailer@coffee.example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_RAISE_DELIVERY_ERRORS=true

## Backup Defaults
# Instance admins can still edit backup profiles in the app.
ROASTNODE_BACKUP_STORAGE_PATH=storage/instance_backups
ROASTNODE_BACKUP_RETENTION_COUNT=7

## Thruster Direct Public TLS
# Leave blank when TLS terminates at Nginx Proxy Manager, Traefik, Caddy, or another proxy.
THRUSTER_TLS_DOMAIN=
THRUSTER_STORAGE_PATH=/rails/storage/thruster
THRUSTER_GZIP_COMPRESSION_DISABLE_ON_AUTH=true

## Direct Puma HTTPS For Proxy-To-App Encryption
# This bypasses Thruster. Use only when a reverse proxy must speak HTTPS to the app container.
# Mount certificate files through ROASTNODE_CERTS_PATH and switch the command/ports:
#
# ROASTNODE_CERTS_PATH=/opt/roastnode/certs
# ROASTNODE_WEB_COMMAND=./bin/rails server
# ROASTNODE_CONTAINER_PORT=3443
# PORT=3443
# PUMA_SSL_CERT_PATH=/rails/certs/roastnode.crt
# PUMA_SSL_KEY_PATH=/rails/certs/roastnode.key
ROASTNODE_CERTS_PATH=./certs
PORT=3000
PUMA_SSL_CERT_PATH=
PUMA_SSL_KEY_PATH=
PUMA_BIND_HOST=0.0.0.0
